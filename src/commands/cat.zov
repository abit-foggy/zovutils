use std::env;
use std::io;
use std::vec as vec;
use <stdio.h> as c;
use shared::io as stream;

type State = struct { line: usize, line_start: bool, line_nonblank: bool, previous_blank: bool };

fn badshort(opt: u8) void = {
    c::fprintf(c::stderr, "cat: invalid option -- '%c'\nTry 'cat --help' for more information.\n", opt as i32);
};

fn badlong(arg: str) void = {
    c::fprintf(c::stderr, "cat: unrecognized option '%s'\nTry 'cat --help' for more information.\n", arg);
};

fn badargument(option: str) void = {
    c::fprintf(c::stderr, "cat: option '%s' doesn't allow an argument\nTry 'cat --help' for more information.\n", option);
};

fn longprefix(arg: str, option: str) bool = {
    return arg == option || (arg.len > 2usize && arg.len < option.len && arg == option[0usize..arg.len]);
};

fn longambiguity(arg: str) bool = {
    let mut end: usize = arg.len;
    for (let i in 0usize..arg.len) { if (arg.data[i] == 61u8) { end = i; break; }; };
    let key: str = arg[0usize..end];
    let mut count: usize = 0usize;
    if (longprefix(key, "--number-nonblank")) { count += 1usize; };
    if (longprefix(key, "--number")) { count += 1usize; };
    if (longprefix(key, "--squeeze-blank")) { count += 1usize; };
    if (longprefix(key, "--show-nonprinting")) { count += 1usize; };
    if (longprefix(key, "--show-ends")) { count += 1usize; };
    if (longprefix(key, "--show-tabs")) { count += 1usize; };
    if (longprefix(key, "--show-all")) { count += 1usize; };
    if (count <= 1usize) { return false; };
    c::fprintf(c::stderr, "cat: option '%s' is ambiguous; possibilities:", arg);
    if (longprefix(key, "--number-nonblank")) { c::fprintf(c::stderr, " '%s'", "--number-nonblank"); };
    if (longprefix(key, "--number")) { c::fprintf(c::stderr, " '%s'", "--number"); };
    if (longprefix(key, "--squeeze-blank")) { c::fprintf(c::stderr, " '%s'", "--squeeze-blank"); };
    if (longprefix(key, "--show-nonprinting")) { c::fprintf(c::stderr, " '%s'", "--show-nonprinting"); };
    if (longprefix(key, "--show-ends")) { c::fprintf(c::stderr, " '%s'", "--show-ends"); };
    if (longprefix(key, "--show-tabs")) { c::fprintf(c::stderr, " '%s'", "--show-tabs"); };
    if (longprefix(key, "--show-all")) { c::fprintf(c::stderr, " '%s'", "--show-all"); };
    c::fprintf(c::stderr, "\nTry 'cat --help' for more information.\n");
    return true;
};

fn badlongargument(arg: str) bool = {
    let mut end: usize = arg.len;
    for (let i in 0usize..arg.len) { if (arg.data[i] == 61u8) { end = i; break; }; };
    if (end == arg.len) { return false; };
    let key: str = arg[0usize..end];
    if (longambiguity(arg)) { return true; };
    if (longprefix(key, "--number-nonblank")) { badargument("--number-nonblank"); return true; };
    if (longprefix(key, "--number")) { badargument("--number"); return true; };
    if (longprefix(key, "--squeeze-blank")) { badargument("--squeeze-blank"); return true; };
    if (longprefix(key, "--show-nonprinting")) { badargument("--show-nonprinting"); return true; };
    if (longprefix(key, "--show-ends")) { badargument("--show-ends"); return true; };
    if (longprefix(key, "--show-tabs")) { badargument("--show-tabs"); return true; };
    if (longprefix(key, "--show-all")) { badargument("--show-all"); return true; };
    if (longprefix(key, "--help")) { badargument("--help"); return true; };
    if (longprefix(key, "--version")) { badargument("--version"); return true; };
    badlong(arg);
    return true;
};

fn numberline(line: usize) void = {
    let mut n: usize = line;
    let mut width: usize = 1usize;
    while (n >= 10usize) { n = n / 10usize; width += 1usize; };
    while (width < 6usize) { io::print(" "); width += 1usize; };
    io::print(line);
    io::print("\t");
};

fn help() void = {
    io::print("Usage: cat [OPTION]... [FILE]...\n");
    io::print("Concatenate FILE(s) to standard output.\n\n");
    io::print("With no FILE, or when FILE is -, read standard input.\n");
    io::print("  -A, --show-all           equivalent to -vET\n");
    io::print("  -b, --number-nonblank    number nonempty output lines, overrides -n\n");
    io::print("  -e                       equivalent to -vE\n");
    io::print("  -E, --show-ends          display $ or ^M$ at end of each line\n");
    io::print("  -n, --number             number all output lines\n");
    io::print("  -s, --squeeze-blank      suppress repeated empty output lines\n");
    io::print("  -t                       equivalent to -vT\n");
    io::print("  -T, --show-tabs          display TAB characters as ^I\n");
    io::print("  -u                       (ignored)\n");
    io::print("  -v, --show-nonprinting   use ^ and M- notation, except for LFD and TAB\n");
    io::print("      --help\n");
    io::print("         display this help and exit\n");
    io::print("      --version\n");
    io::print("         output version information and exit\n\n");
    io::print("Examples:\n");
    io::print("  cat f - g  Output f's contents, then standard input, then g's contents.\n");
    io::print("  cat        Copy standard input to standard output.\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/cat>\n");
    io::print("or available locally via: info '(coreutils) cat invocation'\n");
};

fn emit_visible(fp: *c::FILE, b: u8, show_tabs: bool, show_ends: bool, show_nonprinting: bool) bool = {
    if (b == 10u8) {
        if (show_ends && !stream::putbyte(fp, 36u8)) { return false; };
        return stream::putbyte(fp, 10u8);
    };
    if (b == 9u8) {
        if (show_tabs) { return stream::putstr(fp, "^I"); };
        return stream::putbyte(fp, b);
    };
    if (!show_nonprinting || (b >= 32u8 && b != 127u8 && b < 128u8)) {
        return stream::putbyte(fp, b);
    };
    if (b >= 128u8) {
        if (!stream::putstr(fp, "M-")) { return false; };
        let low: u8 = b & 127u8;
        if (low < 32u8 || low == 127u8) {
            if (!stream::putbyte(fp, 94u8)) { return false; };
            if (low == 127u8) { return stream::putbyte(fp, 63u8); };
            return stream::putbyte(fp, low + 64u8);
        };
        return stream::putbyte(fp, low);
    };
    if (!stream::putbyte(fp, 94u8)) { return false; };
    if (b == 127u8) { return stream::putbyte(fp, 63u8); };
    return stream::putbyte(fp, b + 64u8);
};

fn process(fp: *c::FILE, number_all: bool, number_nonblank: bool, squeeze: bool,
           show_tabs: bool, show_ends: bool, show_nonprinting: bool, state: &mut State) bool = {
    let buf: [65536]u8;
    while (true) {
        let read_count: i64 = stream::readchunk(fp, ((&buf[0usize]) as *u8), 65536usize);
        if (read_count == 0i64) { break; };
        if (read_count < 0i64) { return false; };
        let n: usize = read_count as usize;
        if (!number_all && !number_nonblank && !squeeze && !show_tabs && !show_ends && !show_nonprinting) {
            if (!stream::writebytes(c::stdout, ((&buf[0usize]) as *u8), n)) { return false; };
            if (c::fflush(c::stdout) != 0) { return false; };
            continue;
        };
        for (let i in 0..n) {
            let b: u8 = buf[i];
            if (b == 10u8) {
                if (squeeze && state.line_start && state.previous_blank) {
                    state.previous_blank = true;
                    continue;
                };
                if (state.line_start && number_all) { numberline(state.line); };
                if (!emit_visible(c::stdout, b, show_tabs, show_ends, show_nonprinting)) { return false; };
                state.previous_blank = !state.line_nonblank;
                if (number_all || state.line_nonblank) { state.line += 1usize; };
                state.line_nonblank = false;
                state.line_start = true;
                continue;
            };
            if (state.line_start) {
                if (number_all || number_nonblank) { numberline(state.line); };
                state.line_start = false;
            };
            state.line_nonblank = true;
            if (!emit_visible(c::stdout, b, show_tabs, show_ends, show_nonprinting)) { return false; };
        };
        if (c::fflush(c::stdout) != 0) { return false; };
    };
    return true;
};

export fn run(start: usize, argc: usize) i32 = {
    let mut number_all: bool = false;
    let mut number_nonblank: bool = false;
    let mut squeeze: bool = false;
    let mut show_tabs: bool = false;
    let mut show_ends: bool = false;
    let mut show_nonprinting: bool = false;
    let mut operands: bool = false;
    let mut files = vec::new[str]();
    defer files.free();
    let mut i: usize = start;
    while (i < argc) {
        let arg: str = env::argat(i);
        if (!operands && arg == "--") { operands = true; i += 1usize; continue; };
        if (operands || arg.len == 0usize || arg.data[0usize] != 45u8 || arg == "-") {
            files.push(arg);
            i += 1usize;
            continue;
        };
        if (arg == "--number" || (arg.len >= 9usize && arg[0usize..9usize] == "--number=")) {
            if (arg != "--number") { badargument("--number"); return 1; };
            number_all = true; i += 1usize; continue;
        };
        if (arg == "--number-nonblank" || (arg.len >= 18usize && arg[0usize..18usize] == "--number-nonblank=")) {
            if (arg != "--number-nonblank") { badargument("--number-nonblank"); return 1; };
            number_nonblank = true; i += 1usize; continue;
        };
        if (arg == "--squeeze-blank" || (arg.len >= 16usize && arg[0usize..16usize] == "--squeeze-blank=")) {
            if (arg != "--squeeze-blank") { badargument("--squeeze-blank"); return 1; };
            squeeze = true; i += 1usize; continue;
        };
        if (arg == "--show-all" || (arg.len >= 11usize && arg[0usize..11usize] == "--show-all=")) {
            if (arg != "--show-all") { badargument("--show-all"); return 1; };
            show_nonprinting = true; show_tabs = true; show_ends = true; i += 1usize; continue;
        };
        if (arg == "--show-ends" || (arg.len >= 12usize && arg[0usize..12usize] == "--show-ends=")) {
            if (arg != "--show-ends") { badargument("--show-ends"); return 1; };
            show_ends = true; i += 1usize; continue;
        };
        if (arg == "--show-tabs" || (arg.len >= 12usize && arg[0usize..12usize] == "--show-tabs=")) {
            if (arg != "--show-tabs") { badargument("--show-tabs"); return 1; };
            show_tabs = true; i += 1usize; continue;
        };
        if (arg == "--show-nonprinting" || (arg.len >= 19usize && arg[0usize..19usize] == "--show-nonprinting=")) {
            if (arg != "--show-nonprinting") { badargument("--show-nonprinting"); return 1; };
            show_nonprinting = true; i += 1usize; continue;
        };
        if (longambiguity(arg)) { return 1; };
        if (longprefix(arg, "--number-nonblank")) { number_nonblank = true; i += 1usize; continue; };
        if (longprefix(arg, "--squeeze-blank")) { squeeze = true; i += 1usize; continue; };
        if (longprefix(arg, "--show-all")) { show_nonprinting = true; show_tabs = true; show_ends = true; i += 1usize; continue; };
        if (longprefix(arg, "--show-ends")) { show_ends = true; i += 1usize; continue; };
        if (longprefix(arg, "--show-tabs")) { show_tabs = true; i += 1usize; continue; };
        if (longprefix(arg, "--show-nonprinting")) { show_nonprinting = true; i += 1usize; continue; };
        if (arg == "--help" || longprefix(arg, "--help")) { help(); if (!stream::finishoutput("cat")) { return 1; }; return 0; };
        if (longprefix(arg, "--version")) { io::println("cat (zovutils) 0.1.18"); if (!stream::finishoutput("cat")) { return 1; }; return 0; };
        if (arg == "--version") { io::println("cat (zovutils) 0.1.18"); if (!stream::finishoutput("cat")) { return 1; }; return 0; };
        if (arg.len >= 2usize && arg[0usize..2usize] == "--" && badlongargument(arg)) { return 1; };
        if (arg.len < 2usize || arg.data[1usize] != 45u8) {
            for (let j in 1usize..arg.len) {
                let opt: u8 = arg.data[j];
                if (opt == 110u8) { number_all = true; }
                else if (opt == 98u8) { number_nonblank = true; }
                else if (opt == 115u8) { squeeze = true; }
                else if (opt == 65u8) { show_nonprinting = true; show_tabs = true; show_ends = true; }
                else if (opt == 101u8) { show_nonprinting = true; show_ends = true; }
                else if (opt == 116u8) { show_nonprinting = true; show_tabs = true; }
                else if (opt == 69u8) { show_ends = true; }
                else if (opt == 84u8) { show_tabs = true; }
                else if (opt == 118u8) { show_nonprinting = true; }
                else if (opt == 117u8) { }
                else { badshort(opt); return 1; };
            };
            i += 1usize;
            continue;
        };
        badlong(arg);
        return 1;
    };
    if (number_nonblank) { number_all = false; };
    let mut state: State = State{ line = 1usize, line_start = true, line_nonblank = false, previous_blank = false };
    let mut status: i32 = 0;
    let mut index: usize = 0usize;
    if (files.len() == 0usize) {
        if (!process(c::stdin, number_all, number_nonblank, squeeze, show_tabs, show_ends, show_nonprinting, &mut state)) {
            if (!stream::outputfailed()) { stream::errorprefix("cat", "-"); };
            status = 1;
        };
    } else {
        while (index < files.len()) {
            let path: str = files.get(index);
            let mut fp: *c::FILE = c::stdin;
            let mut owned: bool = false;
            if (path != "-") {
                let raw: nullable *c::FILE = stream::openread(path);
                if (raw == null) { stream::errorprefix("cat", path); status = 1; index += 1usize; continue; };
                fp = raw!;
                owned = true;
            };
            if (stream::sameopenfile(fp, c::stdout)) {
                c::fprintf(c::stderr, "cat: "); stream::printquoted(c::stderr, path, false);
                c::fprintf(c::stderr, ": input file is output file\n");
                status = 1;
                if (owned) { stream::closefile(fp); };
                index += 1usize;
                continue;
            };
            if (!process(fp, number_all, number_nonblank, squeeze, show_tabs, show_ends, show_nonprinting, &mut state)) {
                if (!stream::outputfailed()) { stream::errorprefix("cat", path); };
                status = 1;
            };
            if (owned && !stream::closefile(fp)) { stream::errorprefix("cat", path); status = 1; };
            if (stream::outputfailed()) { break; };
            index += 1usize;
        };
    };
    if (!stream::finishoutput("cat")) { status = 1; };
    return status;
};
