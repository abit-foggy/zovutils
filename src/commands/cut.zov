use std::env as args;
use std::io;
use <stdio.h> as c;
use <cut_backend.h> as backend;
use shared::io as stream;

fn usage_error() void = {
    c::fprintf(c::stderr, "Try 'cut --help' for more information.\n");
};

fn longkey(arg: str) str = {
    for (let i in 0usize..arg.len) {
        if (arg.data[i] == 61u8) { return arg[0usize..i]; };
    };
    return arg;
};

fn is_prefix(value: str, full: str) bool = {
    return value.len > 2usize && value.len <= full.len && value == full[0usize..value.len];
};

fn help() void = {
    io::print("Usage: cut OPTION... [FILE]...\n");
    io::print("Print selected parts of lines from each FILE to standard output.\n\n");
    io::print("  -b, --bytes=LIST        select only these bytes\n");
    io::print("  -c, --characters=LIST   select only these characters\n");
    io::print("  -d, --delimiter=DELIM   use DELIM instead of TAB for fields\n");
    io::print("  -f, --fields=LIST       select only these fields\n");
    io::print("  -n                      (ignored)\n");
    io::print("      --complement        complement the set of selected bytes, characters or fields\n");
    io::print("  -s, --only-delimited    do not print lines not containing delimiters\n");
    io::print("      --output-delimiter=STRING  use STRING as the output delimiter\n");
    io::print("  -z, --zero-terminated   line delimiter is NUL, not newline\n");
    io::print("      --help     display this help and exit\n");
    io::print("      --version  output version information and exit\n");
};

export fn run(start: usize, argc: usize) i32 = {
    let mut list: str = "";
    let mut mode: i32 = 0i32;
    let mut list_count: usize = 0usize;
    let mut delimiter: i32 = 9i32;
    let mut has_delimiter: bool = false;
    let mut output_delimiter: *i8 = list.data as *i8;
    let mut has_output_delimiter: bool = false;
    let mut complement: bool = false;
    let mut no_partial: bool = false;
    let mut suppress: bool = false;
    let mut zero_terminated: bool = false;
    let mut files: [256]str;
    let mut file_count: usize = 0usize;
    let mut i: usize = start;
    let mut options_done: bool = false;
    while (i < argc) {
        let arg: str = args::argat(i);
        if (!options_done && arg == "--") { options_done = true; i += 1usize; continue; };
        if (!options_done && arg.len > 2usize && arg[0usize..2usize] == "--") {
            let key: str = longkey(arg);
            if (key == "--bytes" || is_prefix(key, "--bytes")) {
                if (arg.len == key.len && i + 1usize >= argc) { c::fprintf(c::stderr, "cut: option '--bytes' requires an argument\n"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                list = value; mode = 1i32; list_count += 1usize; continue;
            };
            if (key == "--characters" || is_prefix(key, "--characters")) {
                if (arg.len == key.len && i + 1usize >= argc) { c::fprintf(c::stderr, "cut: option '--characters' requires an argument\n"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                list = value; mode = 3i32; list_count += 1usize; continue;
            };
            if (key == "--fields" || is_prefix(key, "--fields")) {
                if (arg.len == key.len && i + 1usize >= argc) { c::fprintf(c::stderr, "cut: option '--fields' requires an argument\n"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                list = value; mode = 2i32; list_count += 1usize; continue;
            };
            if (key == "--delimiter" || is_prefix(key, "--delimiter")) {
                if (arg.len == key.len && i + 1usize >= argc) { c::fprintf(c::stderr, "cut: option '--delimiter' requires an argument\n"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                if (value.len != 1usize) { c::fprintf(c::stderr, "cut: the delimiter must be a single character\n"); return 1; };
                delimiter = value.data[0usize] as i32; has_delimiter = true; continue;
            };
            if (key == "--output-delimiter" || is_prefix(key, "--output-delimiter")) {
                if (arg.len == key.len && i + 1usize >= argc) { c::fprintf(c::stderr, "cut: option '--output-delimiter' requires an argument\n"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                output_delimiter = value.data as *i8; has_output_delimiter = true; continue;
            };
            if (key == "--complement" || is_prefix(key, "--complement")) { complement = true; i += 1usize; continue; };
            if (key == "--no-partial" || is_prefix(key, "--no-partial")) { no_partial = true; i += 1usize; continue; };
            if (key == "--only-delimited" || is_prefix(key, "--only-delimited")) { suppress = true; i += 1usize; continue; };
            if (key == "--zero-terminated" || is_prefix(key, "--zero-terminated")) { zero_terminated = true; i += 1usize; continue; };
            if (key == "--help" || is_prefix(key, "--help")) { help(); stream::finishoutput("cut"); return 0; };
            if (key == "--version" || is_prefix(key, "--version")) { io::println("cut (zovutils) 0.1.189"); stream::finishoutput("cut"); return 0; };
            c::fprintf(c::stderr, "cut: unrecognized option '%s'\n", arg); usage_error(); return 1;
        };
        if (!options_done && arg.len > 1usize && arg.data[0usize] == 45u8) {
            let mut j: usize = 1usize;
            while (j < arg.len) {
                let option: u8 = arg.data[j];
                if (option == 110u8) { no_partial = true; j += 1usize; continue; };
                if (option == 115u8) { suppress = true; j += 1usize; continue; };
                if (option == 122u8) { zero_terminated = true; j += 1usize; continue; };
                if (option == 98u8 || option == 99u8 || option == 102u8 || option == 100u8) {
                    let mut value: str = "";
                    if (j + 1usize < arg.len) { value = arg[j + 1usize..arg.len]; }
                    else if (i + 1usize < argc) { i += 1usize; value = args::argat(i); }
                    else {
                        c::fprintf(c::stderr, "cut: option requires an argument -- '%c'\n", option as i32); usage_error(); return 1;
                    };
                    if (option == 100u8) {
                        if (value.len != 1usize) { c::fprintf(c::stderr, "cut: the delimiter must be a single character\n"); return 1; };
                        delimiter = value.data[0usize] as i32; has_delimiter = true;
                    } else {
                        if (option == 102u8) { mode = 2i32; }
                        else if (option == 99u8) { mode = 3i32; }
                        else { mode = 1i32; };
                        list = value; list_count += 1usize;
                    };
                    j = arg.len; continue;
                };
                c::fprintf(c::stderr, "cut: invalid option -- '%c'\n", option as i32); usage_error(); return 1;
            };
            i += 1usize; continue;
        };
        if (file_count >= 256usize) { c::fprintf(c::stderr, "cut: too many input files\n"); return 1; };
        files[file_count] = arg; file_count += 1usize; i += 1usize;
    };
    if (list_count == 0usize) { c::fprintf(c::stderr, "cut: you must specify a list of bytes, characters, or fields\n"); usage_error(); return 1; };
    if (list_count > 1usize) { c::fprintf(c::stderr, "cut: only one list may be specified\n"); usage_error(); return 1; };
    if (has_delimiter && mode != 2i32) { c::fprintf(c::stderr, "cut: an input delimiter makes sense\n\tonly when operating on fields\n"); usage_error(); return 1; };
    if (suppress && mode != 2i32) { c::fprintf(c::stderr, "cut: suppressing non-delimited lines makes sense\n\tonly when operating on fields\n"); usage_error(); return 1; };
    let list_status: i32 = backend::zov_cut_validate_list(list.data as *i8);
    if (list_status == 2i32) {
        if (mode == 2i32) { c::fprintf(c::stderr, "cut: fields are numbered from 1\n"); }
        else { c::fprintf(c::stderr, "cut: byte/character positions are numbered from 1\n"); };
        usage_error(); return 1;
    };
    if (list_status == 3i32) { c::fprintf(c::stderr, "cut: invalid decreasing range\n"); usage_error(); return 1; };
    if (list_status != 1i32) { c::fprintf(c::stderr, "cut: invalid range with no endpoint: -\n"); usage_error(); return 1; };
    if (file_count == 0usize) { return backend::zov_cut_process("-", list.data as *i8, mode, delimiter, output_delimiter, has_output_delimiter as i32, no_partial as i32, complement as i32, suppress as i32, zero_terminated as i32); };
    let mut status: i32 = 0i32;
    for (let fi in 0usize..file_count) {
        let result: i32 = backend::zov_cut_process(files[fi].data as *i8, list.data as *i8, mode, delimiter, output_delimiter, has_output_delimiter as i32, no_partial as i32, complement as i32, suppress as i32, zero_terminated as i32);
        if (result != 0i32) { status = 1i32; };
    };
    return status;
};
