use std::env as args;
use std::io;
use std::mem as mem;
use std::vec as vec;
use <stdio.h> as c;
use <string.h> as strc;
use <platform_errno.h> as platform_errno;
use <platform_locale.h> as platform_locale;
use <platform_io.h> as platform_io;
use shared::io as stream;

fn usage_error() void = {
    io::eprintln("Try 'cut --help' for more information.");
};

fn longkey(arg: str) str = {
    for (let i in 0usize..arg.len) {
        if (arg.data[i] == 61u8) { return arg[0usize..i]; };
    };
    return arg;
};

fn is_prefix(value: str, full: str) bool = {
    return value.len > 2usize && value.len <= full.len && value == full[0usize..value.len];
};

fn help() void = {
    io::print("Usage: cut OPTION... [FILE]...\n");
    io::print("Print selected parts of lines from each FILE to standard output.\n\n");
    io::print("With no FILE, or when FILE is -, read standard input.\n\n");
    io::print("Mandatory arguments to long options are mandatory for short options too.\n");
    io::print("  -b, --bytes=LIST\n         select only these byte positions\n");
    io::print("  -c, --characters=LIST\n         select only these character positions\n");
    io::print("      --complement\n         complement the set of selected bytes, characters or fields\n");
    io::print("  -d, --delimiter=DELIM\n         use DELIM instead of TAB for field delimiter\n");
    io::print("  -f, --fields=LIST\n         select only these fields;  also print any line that contains\n         no delimiter character, unless the -s option is specified\n");
    io::print("  -F LIST\n         like -f, but also implies -w and -O ' '\n");
    io::print("  -n, --no-partial\n         with -b, don't output partial multi-byte characters\n");
    io::print("  -O, --output-delimiter=STRING\n         use STRING as the output delimiter;\n         the default is to use the input delimiter\n");
    io::print("  -s, --only-delimited\n         do not print lines not containing delimiters\n");
    io::print("  -w, --whitespace-delimited[=trimmed]\n         use a run of blank characters as the field delimiter;\n         with 'trimmed', ignore leading and trailing blanks\n");
    io::print("  -z, --zero-terminated\n         line delimiter is NUL, not newline\n");
    io::print("      --help\n         display this help and exit\n");
    io::print("      --version\n         output version information and exit\n\n");
    io::print("Use one, and only one of -b, -c, -f or -F.  Each LIST is made up of one\nrange, or many ranges separated by commas.  Selected input is written\nin the same order that it is read, and is written exactly once.\nEach range is one of:\n\n");
    io::print("  N     N'th byte, character or field, counted from 1\n");
    io::print("  N-    from N'th byte, character or field, to end of line\n");
    io::print("  N-M   from N'th to M'th (included) byte, character or field\n");
    io::print("  -M    from first to M'th (included) byte, character or field\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/cut>\n");
    io::print("or available locally via: info '(coreutils) cut invocation'\n");
};

type Range = struct {
    first: u64,
    last: u64,
};

type CutLine = struct {
    data: *u8,
    len: usize,
    cap: usize,
};

fn parse_uint(s: str, cursor: &mut usize, value: &mut u64) i32 = {
    let mut p: usize = *cursor;
    if (p >= s.len || s.data[p] < 48u8 || s.data[p] > 57u8) { return 0i32; };
    let mut n: u64 = 0u64;
    while (p < s.len && s.data[p] >= 48u8 && s.data[p] <= 57u8) {
        let digit: u64 = (s.data[p] - 48u8) as u64;
        let max_val: u64 = 18446744073709551615u64;
        if (n > (max_val - digit) / 10u64) { return -1i32; };
        n = n * 10u64 + digit;
        p += 1usize;
    };
    *cursor = p;
    *value = n;
    return 1i32;
};

fn validate_list(list: str) i32 = {
    if (list.len == 0usize) { return 2i32; };
    let mut p: usize = 0usize;
    while (p < list.len) {
        let mut first: u64 = 0u64;
        let mut last: u64 = 0u64;
        let have_first: i32 = parse_uint(list, &mut p, &mut first);
        if (have_first < 0i32) { return 2i32; };
        if (p < list.len && list.data[p] == 45u8) {
            p += 1usize;
            let have_last: i32 = parse_uint(list, &mut p, &mut last);
            if (have_last < 0i32 || (have_first == 0i32 && have_last == 0i32)) { return 0i32; };
            if (have_first != 0i32 && first == 0u64) { return 2i32; };
            if (have_last != 0i32 && last == 0u64) { return 2i32; };
            if (have_first != 0i32 && have_last != 0i32 && last < first) { return 3i32; };
        } else {
            if (have_first == 0i32 || first == 0u64) { return 2i32; };
        };
        if (p == list.len) { return 1i32; };
        if (list.data[p] != 44u8) { return 4i32; };
        p += 1usize;
        if (p == list.len) { return 2i32; };
    };
    return 1i32;
};

fn parse_ranges(list: str, ranges: &mut vec::Vec[Range]) void = {
    let mut p: usize = 0usize;
    while (p < list.len) {
        let mut first: u64 = 0u64;
        let mut last: u64 = 18446744073709551615u64;
        let have_first: i32 = parse_uint(list, &mut p, &mut first);
        if (p < list.len && list.data[p] == 45u8) {
            p += 1usize;
            let have_last: i32 = parse_uint(list, &mut p, &mut last);
            if (have_first == 0i32) { first = 1u64; };
            if (have_last == 0i32) { last = 18446744073709551615u64; };
        } else {
            last = first;
        };
        ranges.push(Range { first = first, last = last });
        if (p < list.len && list.data[p] == 44u8) {
            p += 1usize;
        };
    };
};

fn is_selected(ranges: &vec::Vec[Range], position: u64) bool = {
    for (let i in 0usize..ranges.len()) {
        let r: Range = ranges.get(i);
        if (position >= r.first && position <= r.last) { return true; };
    };
    return false;
};

fn is_separator(mode: i32, c: u8, delimiter: u8) bool = {
    if (mode == 2i32) { return c == delimiter; };
    return c == 32u8 || c == 9u8;
};

fn emit_field(out: *c::FILE, line: *u8, start: usize, end: usize, index: u64,
              ranges: &vec::Vec[Range], complement: bool, delimiter: u8,
              output_delimiter: str, has_output_delimiter: i32, wrote: &mut bool) bool = {
    let mut selected: bool = is_selected(ranges, index);
    if (complement) { selected = !selected; };
    if (!selected) { return true; };
    if (*wrote) {
        if (has_output_delimiter == 2i32) {
            if (!stream::putbyte(out, 32u8)) { return false; };
        } else if (has_output_delimiter == 1i32) {
            if (!stream::putstr(out, output_delimiter)) { return false; };
        } else {
            if (!stream::putbyte(out, delimiter)) { return false; };
        };
    };
    let seg_len: usize = end - start;
    if (seg_len > 0usize) {
        if (!stream::writebytes(out, ((&line[start]) as *u8), seg_len)) { return false; };
    };
    *wrote = true;
    return true;
};

fn emit_line(out: *c::FILE, line: *u8, length: usize, has_terminator: bool, terminator: u8,
             ranges: &vec::Vec[Range], mode: i32, delimiter: u8,
             output_delimiter: str, has_output_delimiter: i32,
             no_partial: bool, complement: bool, suppress: bool) bool = {
    let mut wrote: bool = false;
    if (mode == 1i32 && !no_partial) {
        for (let i in 0usize..length) {
            let mut selected: bool = is_selected(ranges, (i + 1usize) as u64);
            if (complement) { selected = !selected; };
            if (selected) {
                if (!stream::putbyte(out, line[i])) { return false; };
            };
        };
    } else if (mode == 1i32 || mode == 3i32) {
        let mut offset: usize = 0usize;
        let mut position: u64 = 1u64;
        while (offset < length) {
            let width: usize = platform_locale::zov_mbrlen(((&line[offset]) as *u8), length - offset);
            let mut selected: bool = is_selected(ranges, position);
            if (mode == 1i32 && no_partial) {
                for (let j in 1usize..width) {
                    if (!is_selected(ranges, position + (j as u64))) {
                        selected = false;
                    };
                };
            };
            if (complement) { selected = !selected; };
            if (selected) {
                if (!stream::writebytes(out, ((&line[offset]) as *u8), width)) { return false; };
            };
            offset += width;
            if (mode == 1i32) {
                position += width as u64;
            } else {
                position += 1u64;
            };
        };
    } else {
        let mut has_delimeter: bool = false;
        if (mode == 2i32) {
            has_delimeter = platform_io::zov_memchr_offset((line as *void), delimiter as i32, length) >= 0i64;
        } else {
            for (let i in 0usize..length) {
                if (is_separator(mode, line[i], delimiter)) { has_delimeter = true; };
            };
        };
        if (!has_delimeter) {
            if (suppress) { return true; };
            if (length > 0usize && !stream::writebytes(out, line, length)) { return false; };
        } else {
            let mut start: usize = 0usize;
            let mut i: usize = 0usize;
            let mut index: u64 = 1u64;
            let whitespace_mode: bool = mode == 4i32 || mode == 5i32;
            let trimmed: bool = mode == 5i32;
            let mut field_delim: u8 = delimiter;
            if (whitespace_mode) { field_delim = 9u8; };
            if (trimmed) {
                while (start < length && is_separator(mode, line[start], delimiter)) {
                    start += 1usize;
                };
            };
            i = start;
            if (mode == 2i32) {
                while (i < length) {
                    let d_off: i64 = platform_io::zov_memchr_offset(((&line[i]) as *void), delimiter as i32, length - i);
                    if (d_off < 0i64) {
                        break;
                    };
                    let delim_pos: usize = i + (d_off as usize);
                    if (!emit_field(out, line, start, delim_pos, index, ranges, complement,
                                    field_delim, output_delimiter, has_output_delimiter, &mut wrote)) {
                        return false;
                    };
                    index += 1u64;
                    start = delim_pos + 1usize;
                    i = start;
                };
                if (!emit_field(out, line, start, length, index, ranges, complement,
                                field_delim, output_delimiter, has_output_delimiter, &mut wrote)) {
                    return false;
                };
            } else {
                while (i < length) {
                    if (!is_separator(mode, line[i], delimiter)) {
                        i += 1usize;
                        continue;
                    };
                    if (!emit_field(out, line, start, i, index, ranges, complement,
                                    field_delim, output_delimiter, has_output_delimiter, &mut wrote)) {
                        return false;
                    };
                    index += 1u64;
                    if (whitespace_mode) {
                        while (i < length && is_separator(mode, line[i], delimiter)) { i += 1usize; };
                    } else {
                        i += 1usize;
                    };
                    start = i;
                };
                if (!trimmed || start < length) {
                    if (!emit_field(out, line, start, length, index, ranges, complement,
                                    field_delim, output_delimiter, has_output_delimiter, &mut wrote)) {
                        return false;
                    };
                } else if (start == length && !trimmed) {
                    if (!emit_field(out, line, start, length, index, ranges, complement,
                                    field_delim, output_delimiter, has_output_delimiter, &mut wrote)) {
                        return false;
                    };
                };
                if (!trimmed && length == 0usize) {
                    if (!emit_field(out, line, 0usize, 0usize, index, ranges, complement,
                                    field_delim, output_delimiter, has_output_delimiter, &mut wrote)) {
                        return false;
                    };
                };
            };
        };
    };
    if (has_terminator) {
        if (!stream::putbyte(out, terminator)) { return false; };
    };
    return true;
};

fn process_file(path: str, ranges: &vec::Vec[Range], mode: i32,
                delimiter: u8, output_delimiter: str, has_output_delimiter: i32,
                no_partial: bool, complement: bool, suppress: bool, zero_terminated: bool) i32 = {
    let is_stdin: bool = path == "-";
    let mut fp: *c::FILE = c::stdin;
    if (!is_stdin) {
        let open_res: nullable *c::FILE = stream::openread(path);
        match (open_res) {
            case let opened: *c::FILE => { fp = opened; },
            case null => {
                let err: i32 = platform_errno::zov_errno_value();
                c::fprintf(c::stderr, "cut: %s: %s\n", path.data as *i8, strc::strerror(err));
                return 1;
            },
        };
    };
    let mut terminator: u8 = 10u8;
    if (zero_terminated) { terminator = 0u8; };

    let mut line: CutLine = CutLine { data = mem::alloc[u8](1024usize), len = 0usize, cap = 1024usize };
    let mut status: i32 = 0;
    let mut read_buf: [65536]u8;
    while (true) {
        let n: usize = c::fread(((&read_buf[0usize]) as *void), 1usize, 65536usize, fp);
        if (n == 0usize) {
            if (stream::readerror(fp)) {
                let err: i32 = platform_errno::zov_errno_value();
                c::fprintf(c::stderr, "cut: read error: %s\n", strc::strerror(err));
                status = 1;
            } else if (line.len > 0usize) {
                if (!emit_line(c::stdout, line.data, line.len, true, terminator, ranges, mode, delimiter,
                               output_delimiter, has_output_delimiter, no_partial, complement, suppress)) {
                    status = 1;
                };
            };
            break;
        };
        let mut pos: usize = 0usize;
        while (pos < n) {
            let rem: usize = n - pos;
            let offset: i64 = platform_io::zov_memchr_offset(((&read_buf[pos]) as *void), terminator as i32, rem);
            if (offset >= 0i64) {
                let seg_len: usize = offset as usize;
                if (line.len == 0usize) {
                    if (!emit_line(c::stdout, ((&read_buf[pos]) as *u8), seg_len, true, terminator, ranges, mode, delimiter,
                                   output_delimiter, has_output_delimiter, no_partial, complement, suppress)) {
                        status = 1;
                        break;
                    };
                } else {
                    if (line.len + seg_len > line.cap) {
                        let mut next: usize = line.cap * 2usize;
                        while (next < line.len + seg_len) { next = next * 2usize; };
                        line.data = mem::reallocbuf[u8](line.data, next);
                        line.cap = next;
                    };
                    strc::memcpy(((&line.data[line.len]) as *void), ((&read_buf[pos]) as *void), seg_len);
                    line.len += seg_len;
                    if (!emit_line(c::stdout, line.data, line.len, true, terminator, ranges, mode, delimiter,
                                   output_delimiter, has_output_delimiter, no_partial, complement, suppress)) {
                        status = 1;
                        break;
                    };
                    line.len = 0usize;
                };
                pos += seg_len + 1usize;
            } else {
                if (line.len + rem > line.cap) {
                    let mut next: usize = line.cap * 2usize;
                    while (next < line.len + rem) { next = next * 2usize; };
                    line.data = mem::reallocbuf[u8](line.data, next);
                    line.cap = next;
                };
                strc::memcpy(((&line.data[line.len]) as *void), ((&read_buf[pos]) as *void), rem);
                line.len += rem;
                pos = n;
            };
        };
        if (status != 0) { break; };
    };
    mem::freeptr[u8](line.data);
    if (!is_stdin) {
        stream::closefile(fp);
    };
    if (c::fflush(c::stdout) != 0i32) {
        let err: i32 = platform_errno::zov_errno_value();
        c::fprintf(c::stderr, "cut: write error: %s\n", strc::strerror(err));
        status = 1;
    };
    return status;
};

export fn run(start: usize, argc: usize) i32 = {
    let mut list: str = "";
    let mut mode: i32 = 0i32;
    let mut list_count: usize = 0usize;
    let mut delimiter: i32 = 9i32;
    let mut has_delimiter: bool = false;
    let mut whitespace: bool = false;
    let mut whitespace_trimmed: bool = false;
    let mut force_space_fields: bool = false;
    let mut output_delimiter: str = "";
    let mut has_output_delimiter: i32 = 0i32;
    let mut explicit_output_delimiter: bool = false;
    let mut complement: bool = false;
    let mut no_partial: bool = false;
    let mut suppress: bool = false;
    let mut zero_terminated: bool = false;
    let mut files: [256]str;
    let mut file_count: usize = 0usize;
    let mut i: usize = start;
    let mut options_done: bool = false;
    while (i < argc) {
        let arg: str = args::argat(i);
        if (!options_done && arg == "--") { options_done = true; i += 1usize; continue; };
        if (!options_done && arg.len > 2usize && arg[0usize..2usize] == "--") {
            let key: str = longkey(arg);
            if (key == "--bytes" || is_prefix(key, "--bytes")) {
                if (arg.len == key.len && i + 1usize >= argc) { io::eprintln("cut: option '--bytes' requires an argument"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                list = value; mode = 1i32; list_count += 1usize; continue;
            };
            if (key == "--characters" || is_prefix(key, "--characters")) {
                if (arg.len == key.len && i + 1usize >= argc) { io::eprintln("cut: option '--characters' requires an argument"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                list = value; mode = 3i32; list_count += 1usize; continue;
            };
            if (key == "--fields" || is_prefix(key, "--fields")) {
                if (arg.len == key.len && i + 1usize >= argc) { io::eprintln("cut: option '--fields' requires an argument"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                list = value;
                if (whitespace_trimmed) { mode = 5i32; }
                else if (whitespace) { mode = 4i32; }
                else { mode = 2i32; };
                list_count += 1usize; continue;
            };
            if (key == "--delimiter" || is_prefix(key, "--delimiter")) {
                if (arg.len == key.len && i + 1usize >= argc) { io::eprintln("cut: option '--delimiter' requires an argument"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                if (value.len != 1usize) { io::eprintln("cut: the delimiter must be a single character"); return 1; };
                delimiter = value.data[0usize] as i32; has_delimiter = true; continue;
            };
            if (key == "--output-delimiter" || is_prefix(key, "--output-delimiter")) {
                if (arg.len == key.len && i + 1usize >= argc) { io::eprintln("cut: option '--output-delimiter' requires an argument"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                output_delimiter = value; has_output_delimiter = 1i32; explicit_output_delimiter = true; continue;
            };
            if (key == "--whitespace-delimited" || is_prefix(key, "--whitespace-delimited")) {
                if (arg.len > key.len) {
                    let value: str = arg[key.len + 1usize..arg.len];
                    if (value != "trimmed") {
                        io::eprintln("cut: invalid argument '" + value + "' for '--whitespace-delimited'");
                        io::eprintln("Valid arguments are:\n  - 'trimmed'");
                        usage_error(); return 1;
                    };
                    mode = 5i32; whitespace = true; whitespace_trimmed = true;
                } else { mode = 4i32; whitespace = true; };
                i += 1usize; continue;
            };
            if (key == "--complement" || is_prefix(key, "--complement")) { complement = true; i += 1usize; continue; };
            if (key == "--no-partial" || is_prefix(key, "--no-partial")) { no_partial = true; i += 1usize; continue; };
            if (key == "--only-delimited" || is_prefix(key, "--only-delimited")) { suppress = true; i += 1usize; continue; };
            if (key == "--zero-terminated" || is_prefix(key, "--zero-terminated")) { zero_terminated = true; i += 1usize; continue; };
            if (key == "--help" || is_prefix(key, "--help")) { help(); stream::finishoutput("cut"); return 0; };
            if (key == "--version" || is_prefix(key, "--version")) { io::println("cut (zovutils) 0.12.0"); stream::finishoutput("cut"); return 0; };
            io::eprintln("cut: unrecognized option '" + arg + "'"); usage_error(); return 1;
        };
        if (!options_done && arg.len > 1usize && arg.data[0usize] == 45u8) {
            let mut j: usize = 1usize;
            while (j < arg.len) {
                let option: u8 = arg.data[j];
                if (option == 110u8) { no_partial = true; j += 1usize; continue; };
                if (option == 115u8) { suppress = true; j += 1usize; continue; };
                if (option == 122u8) { zero_terminated = true; j += 1usize; continue; };
                if (option == 119u8) { mode = 4i32; whitespace = true; j += 1usize; continue; };
                if (option == 98u8 || option == 99u8 || option == 102u8 || option == 100u8 || option == 70u8 || option == 79u8) {
                    let mut value: str = "";
                    if (j + 1usize < arg.len) { value = arg[j + 1usize..arg.len]; }
                    else if (i + 1usize < argc) { i += 1usize; value = args::argat(i); }
                    else {
                        c::fprintf(c::stderr, "cut: option requires an argument -- '%c'\n", option as i32); usage_error(); return 1;
                    };
                    if (option == 79u8) {
                        output_delimiter = value; has_output_delimiter = 1i32; explicit_output_delimiter = true;
                    } else if (option == 100u8) {
                        if (value.len != 1usize) { io::eprintln("cut: the delimiter must be a single character"); return 1; };
                        delimiter = value.data[0usize] as i32; has_delimiter = true;
                    } else {
                        if (option == 70u8) {
                            mode = 4i32; whitespace = true; force_space_fields = true;
                            if (!explicit_output_delimiter) { output_delimiter = " "; has_output_delimiter = 2i32; };
                        }
                        else if (option == 102u8) {
                            if (whitespace_trimmed) { mode = 5i32; }
                            else if (whitespace) { mode = 4i32; }
                            else { mode = 2i32; };
                        }
                        else if (option == 99u8) { mode = 3i32; }
                        else { mode = 1i32; };
                        list = value; list_count += 1usize;
                    };
                    j = arg.len; continue;
                };
                c::fprintf(c::stderr, "cut: invalid option -- '%c'\n", option as i32); usage_error(); return 1;
            };
            i += 1usize; continue;
        };
        if (file_count >= 256usize) { io::eprintln("cut: too many input files"); return 1; };
        files[file_count] = arg; file_count += 1usize; i += 1usize;
    };
    if (list_count == 0usize) { io::eprintln("cut: you must specify a list of bytes, characters, or fields"); usage_error(); return 1; };
    if (list_count > 1usize) { io::eprintln("cut: only one list may be specified"); usage_error(); return 1; };
    if (force_space_fields && has_delimiter) { mode = 2i32; whitespace = false; };
    let is_field_mode: bool = mode == 2i32 || mode == 4i32 || mode == 5i32;
    if (whitespace && !force_space_fields && !is_field_mode) { io::eprintln("cut: an input delimiter makes sense\n\tonly when operating on fields"); usage_error(); return 1; };
    if (has_delimiter && whitespace && !force_space_fields) { io::eprintln("cut: -d and -w are mutually exclusive"); usage_error(); return 1; };
    if (has_delimiter && mode != 2i32 && !force_space_fields) { io::eprintln("cut: an input delimiter makes sense\n\tonly when operating on fields"); usage_error(); return 1; };
    if (suppress && !is_field_mode) { io::eprintln("cut: suppressing non-delimited lines makes sense\n\tonly when operating on fields"); usage_error(); return 1; };
    let list_status: i32 = validate_list(list);
    if (list_status == 2i32) {
        if (mode == 2i32) { io::eprintln("cut: fields are numbered from 1"); }
        else { io::eprintln("cut: byte/character positions are numbered from 1"); };
        usage_error(); return 1;
    };
    if (list_status == 3i32) { io::eprintln("cut: invalid decreasing range"); usage_error(); return 1; };
    if (list_status != 1i32) { io::eprintln("cut: invalid range with no endpoint: -"); usage_error(); return 1; };

    platform_locale::zov_init_ctype_locale();
    let mut ranges = vec::new[Range]();
    parse_ranges(list, &mut ranges);

    if (file_count == 0usize) {
        files[0usize] = "-";
        file_count = 1usize;
    };
    let mut status: i32 = 0i32;
    for (let fi in 0usize..file_count) {
        let result: i32 = process_file(files[fi], &ranges, mode, delimiter as u8, output_delimiter, has_output_delimiter, no_partial, complement, suppress, zero_terminated);
        if (result != 0i32) { status = 1i32; };
    };
    if (!stream::finishoutput("cut")) { status = 1i32; };
    return status;
};
