use std::env as args;
use <stdio.h> as c;
use <stdlib.h> as stdlib;
use <string.h> as strc;
use <platform_errno.h> as platform_errno;
use <platform_io.h> as platform_io;

fn print_help() = {
    c::fputs("Usage: dd [OPERAND]...\n", c::stdout);
    c::fputs("Copy a file, converting and formatting according to the operands.\n", c::stdout);
    c::fputs("  if=FILE     read from FILE instead of standard input\n", c::stdout);
    c::fputs("  of=FILE     write to FILE instead of standard output\n", c::stdout);
    c::fputs("  bs=N        read and write up to N bytes at a time\n", c::stdout);
    c::fputs("  count=N     copy only N input blocks\n", c::stdout);
    c::fputs("  skip=N      skip N input blocks\n", c::stdout);
    c::fputs("  seek=N      skip N output blocks\n", c::stdout);
    c::fputs("  conv=CONVS  convert the file as specified by the CONVS symbol list\n", c::stdout);
    c::fputs("  status=LEVEL  The LEVEL of information to print to stderr\n", c::stdout);
    c::fputs("      --help      display this help and exit\n", c::stdout);
    c::fputs("      --version   output version information and exit\n", c::stdout);
};

fn parse_dd_num(s: str, out: &mut u64) bool = {
    if (s.len == 0usize) { return false; };
    let mut i: usize = 0usize;
    let mut n: u64 = 0u64;
    while (i < s.len) {
        let ch: u8 = s.data[i];
        if (ch >= 48u8 && ch <= 57u8) {
            n = n * 10u64 + ((ch - 48u8) as u64);
            i += 1usize;
        } else {
            break;
        };
    };
    if (i == 0usize) { return false; };
    let mut m: u64 = 1u64;
    if (i < s.len) {
        if (i + 1usize != s.len) { return false; };
        let suf: u8 = s.data[i];
        if (suf == 107u8 || suf == 75u8) { // 'k' or 'K'
            m = 1024u64;
        } else if (suf == 77u8) { // 'M'
            m = 1048576u64;
        } else if (suf == 71u8) { // 'G'
            m = 1073741824u64;
        } else if (suf == 119u8) { // 'w'
            m = 2u64;
        } else {
            return false;
        };
    };
    let max_u64: u64 = 18446744073709551615u64;
    if (n > max_u64 / m) { return false; };
    *out = n * m;
    return true;
};

fn contains_substr(s: str, sub: str) bool = {
    if (sub.len > s.len) { return false; };
    if (sub.len == 0usize) { return true; };
    let limit: usize = s.len - sub.len;
    for (let i in 0usize..limit + 1usize) {
        if (s[i..i + sub.len] == sub) {
            return true;
        };
    };
    return false;
};

export fn run(start: usize, argc: usize) i32 = {
    let count_args: usize = argc - start;
    let mut ifile: str = "";
    let mut ofile: str = "";
    let mut status_opt: str = "default";
    let mut bs: u64 = 512u64;
    let mut count: u64 = 18446744073709551615u64;
    let mut skip: u64 = 0u64;
    let mut seek: u64 = 0u64;
    let mut have_bs: bool = false;
    let mut notrunc: bool = false;
    let mut append: bool = false;

    for (let i in 0usize..count_args) {
        let a: str = args::argat(start + i);
        if (a == "--help") {
            print_help();
            return 0;
        };
        if (a == "--version") {
            c::fputs("dd (zovutils) 0.11.0\n", c::stdout);
            return 0;
        };
        let mut eq_pos: usize = 0usize;
        let mut has_eq: bool = false;
        for (let j in 0usize..a.len) {
            if (a.data[j] == 61u8) {
                eq_pos = j;
                has_eq = true;
                break;
            };
        };
        if (!has_eq) {
            c::fprintf(c::stderr, "dd: unrecognized operand '%s'\nTry 'dd --help' for more information.\n", a.data as *i8);
            return 1;
        };
        let k: str = a[0usize..eq_pos];
        let v: str = a[eq_pos + 1usize..a.len];

        if (k == "if") {
            ifile = v;
        } else if (k == "of") {
            ofile = v;
        } else if (k == "bs") {
            let mut x: u64 = 0u64;
            if (!parse_dd_num(v, &mut x) || x == 0u64 || x > 67108864u64) {
                c::fprintf(c::stderr, "dd: invalid number: '%s'\n", v.data as *i8);
                return 1;
            };
            bs = x;
            have_bs = true;
        } else if (k == "count") {
            if (!parse_dd_num(v, &mut count)) {
                c::fprintf(c::stderr, "dd: invalid number: '%s'\n", v.data as *i8);
                return 1;
            };
        } else if (k == "skip") {
            if (!parse_dd_num(v, &mut skip)) {
                c::fprintf(c::stderr, "dd: invalid number: '%s'\n", v.data as *i8);
                return 1;
            };
        } else if (k == "seek") {
            if (!parse_dd_num(v, &mut seek)) {
                c::fprintf(c::stderr, "dd: invalid number: '%s'\n", v.data as *i8);
                return 1;
            };
        } else if (k == "conv") {
            if (contains_substr(v, "notrunc")) {
                notrunc = true;
            } else if (v != "sync" && v != "noerror") {
                c::fprintf(c::stderr, "dd: invalid conversion: '%s'\n", v.data as *i8);
                return 1;
            };
        } else if (k == "status") {
            status_opt = v;
        } else if (k == "oflag") {
            if (contains_substr(v, "append")) {
                append = true;
            };
        } else {
            c::fprintf(c::stderr, "dd: unrecognized operand '%s'\nTry 'dd --help' for more information.\n", a.data as *i8);
            return 1;
        };
    };

    if (!have_bs) {
        bs = 512u64;
    };
    let max_u64: u64 = 18446744073709551615u64;
    if (skip > max_u64 / bs || seek > max_u64 / bs) {
        c::fprintf(c::stderr, "dd: invalid number\n");
        return 1;
    };

    let mut in_fp: *c::FILE = c::stdin;
    if (ifile.len > 0usize) {
        let owned_ifile: String = String::from(ifile);
        let fp: nullable *c::FILE = c::fopen(owned_ifile.view().data as *i8, "rb".data as *i8);
        if (fp == null) {
            let err: i32 = platform_errno::zov_errno_value();
            c::fprintf(c::stderr, "dd: failed to open '%s': %s\n", owned_ifile.view().data as *i8, strc::strerror(err));
            return 1;
        };
        in_fp = fp!;
    };

    let mut out_fp: *c::FILE = c::stdout;
    if (ofile.len > 0usize) {
        let owned_ofile: String = String::from(ofile);
        let mut mode: str = "wb";
        if (append) {
            mode = "ab";
        } else if (notrunc) {
            mode = "r+b";
        };
        let mut fp: nullable *c::FILE = c::fopen(owned_ofile.view().data as *i8, mode.data as *i8);
        if (fp == null && notrunc) {
            fp = c::fopen(owned_ofile.view().data as *i8, "wb".data as *i8);
        };
        if (fp == null) {
            let err: i32 = platform_errno::zov_errno_value();
            c::fprintf(c::stderr, "dd: failed to open '%s': %s\n", owned_ofile.view().data as *i8, strc::strerror(err));
            if (in_fp != c::stdin) { c::fclose(in_fp); };
            return 1;
        };
        out_fp = fp!;
    };

    if (skip > 0u64) {
        let skip_bytes: i64 = (skip * bs) as i64;
        let seek_res: i32 = platform_io::zov_fseeko(in_fp, skip_bytes, 0i32);
        if (seek_res != 0i32) {
            let mut tmp: [4096]u8;
            let mut left: u64 = skip * bs;
            while (left > 0u64) {
                let mut chunk: usize = 4096usize;
                if ((left as usize) < chunk) {
                    chunk = left as usize;
                };
                let r: usize = c::fread((&mut tmp[0usize]) as *void, 1usize, chunk, in_fp);
                if (r == 0usize) { break; };
                left -= r as u64;
            };
        };
    };

    if (seek > 0u64) {
        let seek_bytes: i64 = (seek * bs) as i64;
        let seek_res: i32 = platform_io::zov_fseeko(out_fp, seek_bytes, 0i32);
        if (seek_res != 0i32) {
            if (in_fp != c::stdin) { c::fclose(in_fp); };
            if (out_fp != c::stdout) { c::fclose(out_fp); };
            return 1;
        };
    };

    let buf_ptr: nullable *void = stdlib::malloc(bs as usize);
    if (buf_ptr == null) {
        if (in_fp != c::stdin) { c::fclose(in_fp); };
        if (out_fp != c::stdout) { c::fclose(out_fp); };
        return 1;
    };
    let buf: *u8 = (buf_ptr!) as *u8;

    let mut records: u64 = 0u64;
    let mut _bytes: u64 = 0u64;
    let mut status: i32 = 0i32;

    while (records < count) {
        let n: usize = c::fread(buf as *void, 1usize, bs as usize, in_fp);
        if (n == 0usize) {
            break;
        };
        let w: usize = c::fwrite(buf as *void, 1usize, n, out_fp);
        if (w != n) {
            status = 1i32;
            break;
        };
        _bytes += n as u64;
        records += 1u64;
        if (n < (bs as usize)) {
            break;
        };
    };

    if (c::fflush(out_fp) != 0i32) {
        status = 1i32;
    };
    if (in_fp != c::stdin) { c::fclose(in_fp); };
    if (out_fp != c::stdout) { c::fclose(out_fp); };
    stdlib::free(buf as *void);

    if (status_opt != "none" && status_opt != "noxfer") {
        c::fprintf(c::stderr, "%llu+0 records in\n%llu+0 records out\n", records, records);
    };

    return status;
};
