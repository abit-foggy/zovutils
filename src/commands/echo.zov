use std::env;
use std::io;
use std::vec as vec;
use <stdio.h> as c;
use <platform_env.h> as platform_env;
use shared::io as stream;

fn help() void = {
    io::print("Usage: echo [SHORT-OPTION]... [STRING]...\n");
    io::print("  or:  echo LONG-OPTION\n");
    io::print("Echo the STRING(s) to standard output.\n\n");
    io::print("  -n     do not output the trailing newline\n");
    io::print("  -e     enable interpretation of backslash escapes\n");
    io::print("  -E     disable interpretation of backslash escapes (default)\n");
    io::print("      --help\n");
    io::print("         display this help and exit\n");
    io::print("      --version\n");
    io::print("         output version information and exit\n\n");
    io::print("If -e is in effect, the following sequences are recognized:\n\n");
    io::print("  \\\\      backslash\n");
    io::print("  \\a      alert (BEL)\n");
    io::print("  \\b      backspace\n");
    io::print("  \\c      produce no further output\n");
    io::print("  \\e      escape\n");
    io::print("  \\f      form feed\n");
    io::print("  \\n      new line\n");
    io::print("  \\r      carriage return\n");
    io::print("  \\t      horizontal tab\n");
    io::print("  \\v      vertical tab\n");
    io::print("  \\0NNN   byte with octal value NNN (1 to 3 digits)\n");
    io::print("  \\xHH    byte with hexadecimal value HH (1 to 2 digits)\n\n");
    io::print("Your shell may have its own version of echo, which usually supersedes\n");
    io::print("the version described here.  Please refer to your shell's documentation\n");
    io::print("for details about the options it supports.\n\n");
    io::print("Consider using the printf(1) command instead,\n");
    io::print("as it avoids problems when outputting option-like strings.\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/echo>\n");
    io::print("or available locally via: info '(coreutils) echo invocation'\n");
};

fn optionchar(b: u8) bool = {
    return b == 110u8 || b == 101u8 || b == 69u8;
};

fn optionword(arg: str) bool = {
    if (arg.len < 2usize || arg.data[0usize] != 45u8) { return false; };
    for (let j in 1usize..arg.len) { if (!optionchar(arg.data[j])) { return false; }; };
    return true;
};

fn octdigit(b: u8) bool = { return b >= 48u8 && b <= 55u8; };

fn hexdigit(b: u8) i32 = {
    if (b >= 48u8 && b <= 57u8) { return (b - 48u8) as i32; };
    if (b >= 65u8 && b <= 70u8) { return (b - 65u8 + 10u8) as i32; };
    if (b >= 97u8 && b <= 102u8) { return (b - 97u8 + 10u8) as i32; };
    return -1;
};

fn escapevalue(b: u8) i32 = {
    if (b == 97u8) { return 7; };
    if (b == 98u8) { return 8; };
    if (b == 101u8) { return 27; };
    if (b == 102u8) { return 12; };
    if (b == 110u8) { return 10; };
    if (b == 114u8) { return 13; };
    if (b == 116u8) { return 9; };
    if (b == 118u8) { return 11; };
    if (b == 92u8) { return 92; };
    return -1;
};

fn emitarg(arg: str, escapes: bool) i32 = {
    let mut i: usize = 0usize;
    while (i < arg.len) {
        if (!escapes || arg.data[i] != 92u8) {
            if (!stream::putbyte(c::stdout, arg.data[i])) { return -1; };
            i += 1usize; continue;
        };
        if (i + 1usize >= arg.len) {
            if (!stream::putbyte(c::stdout, 92u8)) { return -1; };
            i += 1usize; continue;
        };
        let next: u8 = arg.data[i + 1usize];
        if (next == 99u8) { return 1; };
        if (next == 48u8 || octdigit(next)) {
            let mut value: u32 = 0u32;
            let mut count: usize = 0usize;
            i += 2usize;
            if (next != 48u8) { value = (next - 48u8) as u32; count = 1usize; };
            while (i < arg.len && count < 3usize && octdigit(arg.data[i])) {
                value = value * 8u32 + (arg.data[i] - 48u8) as u32;
                count += 1usize; i += 1usize;
            };
            if (!stream::putbyte(c::stdout, value as u8)) { return -1; };
            continue;
        };
        if (next == 120u8) {
            let mut value: i32 = 0;
            let mut count: usize = 0usize;
            i += 2usize;
            while (i < arg.len && count < 2usize) {
                let digit: i32 = hexdigit(arg.data[i]);
                if (digit < 0) { break; };
                value = value * 16 + digit; count += 1usize; i += 1usize;
            };
            if (count == 0usize) {
                if (!stream::putbyte(c::stdout, 92u8) || !stream::putbyte(c::stdout, 120u8)) { return -1; };
            } else if (!stream::putbyte(c::stdout, value as u8)) { return -1; };
            continue;
        };
        let value: i32 = escapevalue(next);
        if (value >= 0) {
            if (!stream::putbyte(c::stdout, value as u8)) { return -1; };
        } else {
            if (!stream::putbyte(c::stdout, 92u8) || !stream::putbyte(c::stdout, next)) { return -1; };
        };
        i += 2usize;
    };
    return 0;
};

export fn run(start: usize, argc: usize) i32 = {
    let mut operands = vec::new[str]();
    defer operands.free();
    let mut newline: bool = true;
    let posix_environment: bool = platform_env::zov_posixly_correct() != 0i32;
    let mut posix: bool = posix_environment;
    let mut escapes: bool = posix_environment;
    let mut i: usize = start;
    if (argc == start + 1usize) {
        let only: str = env::argat(start);
        if (only == "--help") { help(); if (!stream::finishoutput("echo")) { return 1; }; return 0; };
        if (only == "--version") {
            io::println("echo (zovutils) 0.1.183");
            if (!stream::finishoutput("echo")) { return 1; };
            return 0;
        };
    };

    while (i < argc) {
        let arg: str = env::argat(i);
        if (posix && i == start && arg == "-n") {
            newline = false; posix = false; i += 1usize; continue;
        };
        if (!posix && optionword(arg)) {
            for (let j in 1usize..arg.len) {
                if (arg.data[j] == 110u8) { newline = false; };
                if (arg.data[j] == 101u8 && !posix_environment) { escapes = true; };
                if (arg.data[j] == 69u8 && !posix_environment) { escapes = false; };
            };
            i += 1usize; continue;
        };
        break;
    };
    while (i < argc) { operands.push(env::argat(i)); i += 1usize; };

    let mut stopped: bool = false;
    for (let k in 0..operands.len()) {
        if (k > 0usize && !stream::putbyte(c::stdout, 32u8)) { return 1; };
        let result: i32 = emitarg(operands.get(k), escapes);
        if (result < 0) { return 1; };
        if (result > 0) { stopped = true; break; };
    };
    if (!stopped && newline && !stream::putbyte(c::stdout, 10u8)) { return 1; };
    if (!stream::finishoutput("echo")) { return 1; };
    return 0;
};
