use std::env as args;
use std::io;
use std::mem as mem;
use <stdio.h> as c;
use <string.h> as strc;
use <platform_errno.h> as platform_errno;
use <platform_locale.h> as platform_locale;
use shared::io as stream;
use shared::tabstops as tabstops;

fn usage_error() void = { io::eprintln("Try 'expand --help' for more information."); };

fn longkey(arg: str) str = {
    for (let i in 0usize..arg.len) { if (arg.data[i] == 61u8) { return arg[0usize..i]; }; };
    return arg;
};

fn is_prefix(value: str, full: str) bool = {
    return value.len > 2usize && value.len <= full.len && value == full[0usize..value.len];
};

fn help() void = {
    io::print("Usage: expand [OPTION]... [FILE]...\n");
    io::print("Convert tabs in each FILE to spaces, writing to standard output.\n\n");
    io::print("With no FILE, or when FILE is -, read standard input.\n\n");
    io::print("Mandatory arguments to long options are mandatory for short options too.\n");
    io::print("  -i, --initial\n         do not convert tabs after non blanks\n");
    io::print("  -t, --tabs=N\n         have tabs N characters apart, not 8\n");
    io::print("  -t, --tabs=LIST\n         use comma separated list of tab positions.\n");
    io::print("         The last specified position can be prefixed with '/'\n");
    io::print("         to specify a tab size to use after the last\n");
    io::print("         explicitly specified tab stop.  Also a prefix of '+'\n");
    io::print("         can be used to align remaining tab stops relative to\n");
    io::print("         the last specified tab stop instead of the first column\n");
    io::print("      --help\n         display this help and exit\n");
    io::print("      --version\n         output version information and exit\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/expand>\n");
    io::print("or available locally via: info '(coreutils) expand invocation'\n");
};

fn process_line(line: *u8, len: usize, terminated: bool, tabs: &tabstops::TabStops,
                initial_only: bool, column: &mut usize, at_line_start: &mut bool) bool = {
    let mut offset: usize = 0usize;
    let max_val: usize = 18446744073709551615usize;
    while (offset < len) {
        let b: u8 = line[offset];
        if (b == 9u8 && (!initial_only || *at_line_start)) {
            let stop: usize = tabstops::next_tab(tabs, *column);
            let mut spaces: usize = tabs.repeat;
            if (stop != max_val) {
                spaces = stop - *column;
            };
            for (let _s in 0usize..spaces) {
                if (!stream::putbyte(c::stdout, 32u8)) { return false; };
            };
            *column = stop;
            offset += 1usize;
            continue;
        };
        if (b == 8u8) {
            if (!stream::putbyte(c::stdout, 8u8)) { return false; };
            if (*column != 0usize) { *column -= 1usize; };
            *at_line_start = false;
            offset += 1usize;
            continue;
        };
        let mut char_bytes: usize = 1usize;
        let mut char_width: usize = 1usize;
        platform_locale::zov_fold_next_char(((&line[offset]) as *u8), len - offset, &mut char_bytes, &mut char_width);
        if (!stream::writebytes(c::stdout, ((&line[offset]) as *u8), char_bytes)) { return false; };
        if (char_width > 0usize && *column <= max_val - char_width) {
            *column += char_width;
        };
        if (!initial_only || (b != 32u8 && b != 9u8)) {
            *at_line_start = false;
        };
        offset += char_bytes;
    };
    if (terminated) {
        if (!stream::putbyte(c::stdout, 10u8)) { return false; };
        *column = 0usize;
        *at_line_start = true;
    };
    return true;
};

fn expand_file(path: str, tabs: &tabstops::TabStops, initial_only: bool) i32 = {
    let is_stdin: bool = path == "-";
    let mut fp: *c::FILE = c::stdin;
    if (!is_stdin) {
        let open_res: nullable *c::FILE = stream::openread(path);
        match (open_res) {
            case let opened: *c::FILE => { fp = opened; },
            case null => {
                let err: i32 = platform_errno::zov_errno_value();
                c::fprintf(c::stderr, "expand: %s: %s\n", path.data as *i8, strc::strerror(err));
                return 1;
            },
        };
    };

    let mut column: usize = 0usize;
    let mut at_line_start: bool = true;
    let mut status: i32 = 0;

    let mut line_buf: *u8 = mem::alloc[u8](256usize);
    let mut line_cap: usize = 256usize;
    let mut line_len: usize = 0usize;

    while (true) {
        let ch: i32 = c::fgetc(fp);
        if (ch == -1i32) {
            if (stream::readerror(fp)) {
                let err: i32 = platform_errno::zov_errno_value();
                c::fprintf(c::stderr, "expand: %s: %s\n", path.data as *i8, strc::strerror(err));
                status = 1;
            } else if (line_len > 0usize) {
                if (!process_line(line_buf, line_len, false, tabs, initial_only, &mut column, &mut at_line_start)) {
                    status = 1;
                };
            };
            break;
        };
        if (ch == 10i32) {
            if (!process_line(line_buf, line_len, true, tabs, initial_only, &mut column, &mut at_line_start)) {
                status = 1;
                break;
            };
            line_len = 0usize;
            continue;
        };
        if (line_len == line_cap) {
            let next: usize = line_cap * 2usize;
            line_buf = mem::reallocbuf[u8](line_buf, next);
            line_cap = next;
        };
        line_buf[line_len] = ch as u8;
        line_len += 1usize;
    };

    mem::freeptr[u8](line_buf);
    if (!is_stdin) { stream::closefile(fp); };
    return status;
};

export fn run(start: usize, argc: usize) i32 = {
    let mut tabs: str = "8";
    let mut initial_only: bool = false;
    let mut files: [256]str;
    let mut file_count: usize = 0usize;
    let mut i: usize = start;
    let mut options_done: bool = false;
    while (i < argc) {
        let arg: str = args::argat(i);
        if (!options_done && arg == "--") { options_done = true; i += 1usize; continue; };
        if (!options_done && arg.len > 2usize && arg[0usize..2usize] == "--") {
            let key: str = longkey(arg);
            if (key == "--tabs" || is_prefix(key, "--tabs")) {
                if (arg.len > key.len) { tabs = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else if (i + 1usize < argc) { tabs = args::argat(i + 1usize); i += 2usize; }
                else { io::eprintln("expand: option '--tabs' requires an argument"); usage_error(); return 1; };
                continue;
            };
            if (key == "--initial" || is_prefix(key, "--initial")) { initial_only = true; i += 1usize; continue; };
            if (key == "--help" || is_prefix(key, "--help")) { help(); stream::finishoutput("expand"); return 0; };
            if (key == "--version" || is_prefix(key, "--version")) { io::println("expand (zovutils) 0.12.0"); stream::finishoutput("expand"); return 0; };
            io::eprintln("expand: unrecognized option '" + arg + "'"); usage_error(); return 1;
        };
        if (!options_done && arg.len > 1usize && arg.data[0usize] == 45u8) {
            let mut j: usize = 1usize;
            while (j < arg.len) {
                let option: u8 = arg.data[j];
                if (option == 105u8) { initial_only = true; j += 1usize; continue; };
                if (option == 116u8) {
                    if (j + 1usize < arg.len) { tabs = arg[j + 1usize..arg.len]; }
                    else if (i + 1usize < argc) { i += 1usize; tabs = args::argat(i); }
                    else { io::eprintln("expand: option requires an argument -- 't'"); usage_error(); return 1; };
                    j = arg.len; continue;
                };
                c::fprintf(c::stderr, "expand: invalid option -- '%c'\n", option as i32); usage_error(); return 1;
            };
            i += 1usize; continue;
        };
        if (file_count >= 256usize) { io::eprintln("expand: too many input files"); return 1; };
        files[file_count] = arg; file_count += 1usize; i += 1usize;
    };
    if (file_count == 0usize) { files[0usize] = "-"; file_count = 1usize; };

    platform_locale::zov_init_ctype_locale();

    let mut tab_stops: tabstops::TabStops;
    let mut tabs_error: i32 = 0i32;
    if (!tabstops::parse_tabs(tabs, &mut tab_stops, &mut tabs_error)) {
        tabstops::report_tab_error("expand", tabs, tabs_error);
        return 1;
    };

    let mut status: i32 = 0i32;
    for (let fi in 0usize..file_count) {
        let result: i32 = expand_file(files[fi], &tab_stops, initial_only);
        if (result != 0i32) { status = 1i32; };
    };
    if (!stream::finishoutput("expand")) { status = 1i32; };
    return status;
};
