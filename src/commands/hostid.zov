use std::env as args;
use std::io;
use <platform_hostid.h> as platform_hostid;
use <stdio.h> as c;

export fn run(start: usize, argc: usize) i32 = {
    for (let i in start..argc) {
        let a: str = args::argat(i);
        if (a == "--help") {
            io::println("Usage: hostid [OPTION]");
            io::println("Print the numeric identifier for the current host.");
            io::println("  --help     display this help and exit");
            io::println("  --version  output version information and exit");
            return 0i32;
        };
        if (a == "--version") {
            io::println("hostid (zovutils) 0.11.0");
            return 0i32;
        };
        if (a.len > 0usize && a.data[0usize] == 45u8) {
            c::fprintf(c::stderr, "hostid: unrecognized option '%s'\nTry 'hostid --help' for more information.\n", a.data as *i8);
        } else {
            c::fprintf(c::stderr, "hostid: extra operand '%s'\nTry 'hostid --help' for more information.\n", a.data as *i8);
        };
        return 1i32;
    };

    let id: i64 = platform_hostid::zov_gethostid();
    c::printf("%08lx\n", (id as u64) & 0xffffffffu64);
    return 0i32;
};
