use std::env as args;
use std::io;
use std::mem as mem;
use <stdio.h> as c;
use <string.h> as strc;
use <platform_errno.h> as platform_errno;
use <platform_regex.h> as platform_regex;
use shared::io as stream;

fn usage_error() void = { io::eprintln("Try 'nl --help' for more information."); };

fn longkey(arg: str) str = {
    for (let i in 0usize..arg.len) { if (arg.data[i] == 61u8) { return arg[0usize..i]; }; };
    return arg;
};

fn is_prefix(value: str, full: str) bool = {
    return value.len > 2usize && value.len <= full.len && value == full[0usize..value.len];
};

fn parse_style(value: str, style: &mut u8, pattern: &mut str) bool = {
    if (value.len == 0usize) { return false; };
    let kind: u8 = value.data[0usize];
    if (kind == 97u8 || kind == 116u8 || kind == 110u8) {
        if (value.len != 1usize) { return false; };
        *style = kind; *pattern = ""; return true;
    };
    if (kind == 112u8 && value.len > 1usize) { *style = kind; *pattern = value[1usize..value.len]; return true; };
    return false;
};

fn parse_number(value: str, out: &mut usize) bool = {
    if (value.len == 0usize) { return false; };
    let mut number: usize = 0usize;
    for (let i in 0usize..value.len) {
        let digit: u8 = value.data[i];
        if (digit < 48u8 || digit > 57u8) { return false; };
        let unit: usize = (digit - 48u8) as usize;
        if (number > (18446744073709551615usize - unit) / 10usize) { return false; };
        number = number * 10usize + unit;
    };
    *out = number; return true;
};

fn help() void = {
    io::print("Usage: nl [OPTION]... [FILE]...\nWrite each FILE to standard output, with line numbers added.\n\n");
    io::print("With no FILE, or when FILE is -, read standard input.\n\n");
    io::print("Mandatory arguments to long options are mandatory for short options too.\n");
    io::print("  -b, --body-numbering=STYLE      use STYLE for numbering body lines\n");
    io::print("  -d, --section-delimiter=CC      use CC for logical page delimiters\n");
    io::print("  -f, --footer-numbering=STYLE    use STYLE for numbering footer lines\n");
    io::print("  -h, --header-numbering=STYLE    use STYLE for numbering header lines\n");
    io::print("  -i, --line-increment=NUMBER     line number increment at each line\n");
    io::print("  -l, --join-blank-lines=NUMBER   group of NUMBER empty lines counted as one\n");
    io::print("  -n, --number-format=FORMAT      insert line numbers according to FORMAT\n");
    io::print("  -p, --no-renumber               do not reset line numbers for each section\n");
    io::print("  -s, --number-separator=STRING   add STRING after (possible) line number\n");
    io::print("  -v, --starting-line-number=NUMBER  first line number for each section\n");
    io::print("  -w, --number-width=NUMBER       use NUMBER columns for line numbers\n");
    io::print("      --help\n         display this help and exit\n");
    io::print("      --version\n         output version information and exit\n\n");
    io::print("Default options are: -bt -d'\\:' -fn -hn -i1 -l1 -n'rn' -s<TAB> -v1 -w6\n\n");
    io::print("CC are two delimiter characters used to construct logical page delimiters;\na missing second character implies ':'.  As a GNU extension one can specify\nmore than two characters, and also specifying the empty string (-d '')\ndisables section matching.\n\n");
    io::print("STYLE is one of:\n\n  a      number all lines\n  t      number only nonempty lines\n  n      number no lines\n  pBRE   number only lines that contain a match for the basic regular\n         expression, BRE\n\n");
    io::print("FORMAT is one of:\n\n  ln     left justified, no leading zeros\n  rn     right justified, no leading zeros\n  rz     right justified, leading zeros\n\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\nGNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\nReport any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/nl>\nor available locally via: info '(coreutils) nl invocation'\n");
};

type NlLine = struct {
    data: *u8,
    len: usize,
    cap: usize,
};

fn nl_read_line(fp: *c::FILE, line: &mut NlLine, terminated: &mut bool) i32 = {
    line.len = 0usize;
    *terminated = false;
    while (true) {
        let ch: i32 = c::fgetc(fp);
        if (ch == -1i32) {
            if (line.len != 0usize || stream::readerror(fp)) { return 1i32; };
            return 0i32;
        };
        if (ch == 10i32) {
            *terminated = true;
            return 1i32;
        };
        if (line.len == line.cap) {
            let mut next: usize = 256usize;
            if (line.cap != 0usize) { next = line.cap * 2usize; };
            line.data = mem::reallocbuf[u8](line.data, next);
            line.cap = next;
        };
        line.data[line.len] = ch as u8;
        line.len += 1usize;
    };
    return 0i32;
};

fn starts_section(line_data: *u8, line_len: usize, del: *u8, del_len: usize, count: usize) bool = {
    if (del_len == 0usize || line_len < del_len * count) { return false; };
    let total: usize = del_len * count;
    for (let i in 0usize..total) {
        if (line_data[i] != del[i % del_len]) { return false; };
    };
    return true;
};

fn nl_selected(style: u8, line_data: *u8, line_len: usize, rx: nullable *void, ready: bool) bool = {
    if (style == 97u8) { return true; };
    if (style == 116u8) { return line_len != 0usize; };
    if (style == 110u8) { return false; };
    if (style == 112u8 && ready) {
        let text: *u8 = mem::alloc[u8](line_len + 1usize);
        for (let i in 0usize..line_len) { text[i] = line_data[i]; };
        text[line_len] = 0u8;
        let matched: bool = platform_regex::zov_regex_search(rx!, text as *i8) != 0i32;
        mem::freeptr[u8](text);
        return matched;
    };
    return false;
};

fn nl_emit_number(number: usize, width: usize, format: u8, separator: str) bool = {
    let mut num_str: [64]u8;
    let mut num_len: usize = 0usize;
    let mut temp: usize = number;
    while (true) {
        num_str[num_len] = 48u8 + ((temp % 10usize) as u8);
        num_len += 1usize;
        temp = temp / 10usize;
        if (temp == 0usize) { break; };
    };
    let mut text: [64]u8;
    for (let i in 0usize..num_len) {
        text[i] = num_str[num_len - 1usize - i];
    };
    let mut pad: usize = 0usize;
    if (width > num_len) { pad = width - num_len; };

    if (format == 108u8) {
        if (!stream::writebytes(c::stdout, (&text[0usize]) as *u8, num_len)) { return false; };
        while (pad > 0usize) {
            if (c::fputc(32i32, c::stdout) == -1i32) { return false; };
            pad -= 1usize;
        };
    } else {
        let mut fill: i32 = 32i32;
        if (format == 122u8) { fill = 48i32; };
        while (pad > 0usize) {
            if (c::fputc(fill, c::stdout) == -1i32) { return false; };
            pad -= 1usize;
        };
        if (!stream::writebytes(c::stdout, (&text[0usize]) as *u8, num_len)) { return false; };
    };
    return stream::putstr(c::stdout, separator);
};

fn nl_emit_blank(width: usize) bool = {
    let count: usize = width + 1usize;
    for (let _i in 0usize..count) {
        if (c::fputc(32i32, c::stdout) == -1i32) { return false; };
    };
    return true;
};

export fn run(start: usize, argc: usize) i32 = {
    let mut body_style: u8 = 116u8;
    let mut header_style: u8 = 110u8;
    let mut footer_style: u8 = 110u8;
    let mut body_pattern: str = "";
    let mut header_pattern: str = "";
    let mut footer_pattern: str = "";
    let mut delimiter: str = "\\:";
    let mut separator: str = "\t";
    let mut increment: usize = 1usize;
    let mut start_number: usize = 1usize;
    let mut join_blank: usize = 1usize;
    let mut width: usize = 6usize;
    let mut number_format: u8 = 114u8;
    let mut no_renumber: bool = false;
    let mut files: [256]str;
    let mut file_count: usize = 0usize;
    let mut i: usize = start;
    let mut options_done: bool = false;
    while (i < argc) {
        let arg: str = args::argat(i);
        if (!options_done && arg == "--") { options_done = true; i += 1usize; continue; };
        if (!options_done && arg.len > 2usize && arg[0usize..2usize] == "--") {
            let key: str = longkey(arg);
            let mut value: str = "";
            let mut takes_value: bool = false;
            let mut option: u8 = 0u8;
            if (key == "--body-numbering" || is_prefix(key, "--body-numbering")) { option = 98u8; takes_value = true; };
            if (key == "--section-delimiter" || is_prefix(key, "--section-delimiter")) { option = 100u8; takes_value = true; };
            if (key == "--footer-numbering" || is_prefix(key, "--footer-numbering")) { option = 102u8; takes_value = true; };
            if (key == "--header-numbering" || is_prefix(key, "--header-numbering")) { option = 104u8; takes_value = true; };
            if (key == "--line-increment" || is_prefix(key, "--line-increment")) { option = 105u8; takes_value = true; };
            if (key == "--join-blank-lines" || is_prefix(key, "--join-blank-lines")) { option = 108u8; takes_value = true; };
            if (key == "--number-format" || is_prefix(key, "--number-format")) { option = 110u8; takes_value = true; };
            if (key == "--number-separator" || is_prefix(key, "--number-separator")) { option = 115u8; takes_value = true; };
            if (key == "--starting-line-number" || is_prefix(key, "--starting-line-number")) { option = 118u8; takes_value = true; };
            if (key == "--number-width" || is_prefix(key, "--number-width")) { option = 119u8; takes_value = true; };
            if (key == "--no-renumber" || is_prefix(key, "--no-renumber")) { no_renumber = true; i += 1usize; continue; };
            if (key == "--help" || is_prefix(key, "--help")) { help(); stream::finishoutput("nl"); return 0; };
            if (key == "--version" || is_prefix(key, "--version")) { io::println("nl (zovutils) 0.11.0"); stream::finishoutput("nl"); return 0; };
            if (!takes_value) { io::eprintln("nl: unrecognized option '" + arg + "'"); usage_error(); return 1; };
            if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
            else if (i + 1usize < argc) { value = args::argat(i + 1usize); i += 2usize; }
            else { io::eprintln("nl: option '--" + key[2usize..key.len] + "' requires an argument"); usage_error(); return 1; };
            if (option == 98u8 && !parse_style(value, &mut body_style, &mut body_pattern)) { io::eprintln("nl: invalid body numbering style: '" + value + "'"); usage_error(); return 1; };
            if (option == 102u8 && !parse_style(value, &mut footer_style, &mut footer_pattern)) { io::eprintln("nl: invalid footer numbering style: '" + value + "'"); usage_error(); return 1; };
            if (option == 104u8 && !parse_style(value, &mut header_style, &mut header_pattern)) { io::eprintln("nl: invalid header numbering style: '" + value + "'"); usage_error(); return 1; };
            if (option == 100u8) { delimiter = value; };
            if (option == 115u8) { separator = value; };
            if (option == 110u8) { if (value == "ln") { number_format = 108u8; } else if (value == "rn") { number_format = 114u8; } else if (value == "rz") { number_format = 122u8; } else { io::eprintln("nl: invalid line number format: '" + value + "'"); usage_error(); return 1; }; };
            if (option == 105u8 && !parse_number(value, &mut increment)) { io::eprintln("nl: invalid line number increment: '" + value + "'"); usage_error(); return 1; };
            if (option == 108u8) { if (!parse_number(value, &mut join_blank)) { io::eprintln("nl: invalid number of blank lines: '" + value + "'"); usage_error(); return 1; }; if (join_blank == 0usize) { join_blank = 1usize; }; };
            if (option == 118u8 && !parse_number(value, &mut start_number)) { io::eprintln("nl: invalid starting line number: '" + value + "'"); usage_error(); return 1; };
            if (option == 119u8 && !parse_number(value, &mut width)) { io::eprintln("nl: invalid line number field width: '" + value + "'"); usage_error(); return 1; };
            if (option == 119u8 && width == 0usize) { io::eprintln("nl: invalid line number field width: '0': Numerical result out of range"); return 1; };
            if (option == 119u8 && width > 4096usize) { width = 4096usize; };
            continue;
        };
        if (!options_done && arg.len > 1usize && arg.data[0usize] == 45u8) {
            let mut j: usize = 1usize;
            while (j < arg.len) {
                let option: u8 = arg.data[j];
                if (option == 112u8) { no_renumber = true; j += 1usize; continue; };
                if (option == 98u8 || option == 100u8 || option == 102u8 || option == 104u8 || option == 105u8 || option == 108u8 || option == 110u8 || option == 115u8 || option == 118u8 || option == 119u8) {
                    let mut value: str = "";
                    if (j + 1usize < arg.len) { value = arg[j + 1usize..arg.len]; }
                    else if (i + 1usize < argc) { i += 1usize; value = args::argat(i); }
                    else { c::fprintf(c::stderr, "nl: option requires an argument -- '%c'\n", option as i32); usage_error(); return 1; };
                    if (option == 98u8 && !parse_style(value, &mut body_style, &mut body_pattern)) { io::eprintln("nl: invalid body numbering style: '" + value + "'"); usage_error(); return 1; };
                    if (option == 102u8 && !parse_style(value, &mut footer_style, &mut footer_pattern)) { io::eprintln("nl: invalid footer numbering style: '" + value + "'"); usage_error(); return 1; };
                    if (option == 104u8 && !parse_style(value, &mut header_style, &mut header_pattern)) { io::eprintln("nl: invalid header numbering style: '" + value + "'"); usage_error(); return 1; };
                    if (option == 100u8) { delimiter = value; };
                    if (option == 115u8) { separator = value; };
                    if (option == 110u8) { if (value == "ln") { number_format = 108u8; } else if (value == "rn") { number_format = 114u8; } else if (value == "rz") { number_format = 122u8; } else { io::eprintln("nl: invalid line number format: '" + value + "'"); usage_error(); return 1; }; };
                    if (option == 105u8 && !parse_number(value, &mut increment)) { io::eprintln("nl: invalid line number increment: '" + value + "'"); usage_error(); return 1; };
                    if (option == 108u8) { if (!parse_number(value, &mut join_blank)) { io::eprintln("nl: invalid number of blank lines: '" + value + "'"); usage_error(); return 1; }; if (join_blank == 0usize) { join_blank = 1usize; }; };
                    if (option == 118u8 && !parse_number(value, &mut start_number)) { io::eprintln("nl: invalid starting line number: '" + value + "'"); usage_error(); return 1; };
                    if (option == 119u8 && !parse_number(value, &mut width)) { io::eprintln("nl: invalid line number field width: '" + value + "'"); usage_error(); return 1; };
                    if (option == 119u8 && width == 0usize) { io::eprintln("nl: invalid line number field width: '0': Numerical result out of range"); return 1; };
                    if (option == 119u8 && width > 4096usize) { width = 4096usize; };
                    j = arg.len; continue;
                };
                c::fprintf(c::stderr, "nl: invalid option -- '%c'\n", option as i32); usage_error(); return 1;
            };
            i += 1usize; continue;
        };
        if (file_count >= 256usize) { io::eprintln("nl: too many input files"); return 1; };
        files[file_count] = arg; file_count += 1usize; i += 1usize;
    };
    if (file_count == 0usize) { files[0usize] = "-"; file_count = 1usize; };

    let mut rx_header: nullable *void = null;
    let mut rx_body: nullable *void = null;
    let mut rx_footer: nullable *void = null;
    if (header_style == 112u8) {
        rx_header = platform_regex::zov_regex_compile_bre(header_pattern.data as *i8);
        if (rx_header == null) {
            io::eprintln("nl: invalid regular expression: " + header_pattern);
            return 1;
        };
    };
    if (body_style == 112u8) {
        rx_body = platform_regex::zov_regex_compile_bre(body_pattern.data as *i8);
        if (rx_body == null) {
            io::eprintln("nl: invalid regular expression: " + body_pattern);
            if (rx_header != null) { platform_regex::zov_regex_free(rx_header!); };
            return 1;
        };
    };
    if (footer_style == 112u8) {
        rx_footer = platform_regex::zov_regex_compile_bre(footer_pattern.data as *i8);
        if (rx_footer == null) {
            io::eprintln("nl: invalid regular expression: " + footer_pattern);
            if (rx_header != null) { platform_regex::zov_regex_free(rx_header!); };
            if (rx_body != null) { platform_regex::zov_regex_free(rx_body!); };
            return 1;
        };
    };

    let mut del_buf: [4096]u8;
    let mut del_len: usize = delimiter.len;
    if (del_len == 1usize) {
        del_buf[0usize] = delimiter.data[0usize];
        del_buf[1usize] = 58u8;
        del_len = 2usize;
    } else if (del_len > 4096usize) {
        if (rx_header != null) { platform_regex::zov_regex_free(rx_header!); };
        if (rx_body != null) { platform_regex::zov_regex_free(rx_body!); };
        if (rx_footer != null) { platform_regex::zov_regex_free(rx_footer!); };
        io::eprintln("nl: section delimiter is too long");
        return 1;
    } else if (del_len != 0usize) {
        for (let di in 0usize..del_len) { del_buf[di] = delimiter.data[di]; };
    };

    let mut section: usize = 1usize;
    let mut number: usize = start_number;
    let mut blank_run: usize = 0usize;
    let mut line: NlLine = NlLine { data = mem::alloc[u8](256usize), len = 0usize, cap = 256usize };
    let mut status: i32 = 0;

    for (let f in 0usize..file_count) {
        let path: str = files[f];
        let is_stdin: bool = path == "-";
        let mut fp: *c::FILE = c::stdin;
        if (!is_stdin) {
            let open_res: nullable *c::FILE = stream::openread(path);
            match (open_res) {
                case let opened: *c::FILE => { fp = opened; },
                case null => {
                    let err: i32 = platform_errno::zov_errno_value();
                    c::fprintf(c::stderr, "nl: %s: %s\n", path.data as *i8, strc::strerror(err));
                    status = 1;
                    continue;
                },
            };
        };
        while (true) {
            let mut terminated: bool = false;
            let rc: i32 = nl_read_line(fp, &mut line, &mut terminated);
            if (rc == 0i32) { break; };
            if (rc < 0i32) {
                c::fprintf(c::stderr, "nl: read error: %s\n", path.data as *i8);
                status = 1;
                break;
            };

            let mut marker: bool = false;
            if (starts_section(line.data, line.len, (&del_buf[0usize]) as *u8, del_len, 3usize)) {
                section = 2usize;
                marker = true;
            } else if (starts_section(line.data, line.len, (&del_buf[0usize]) as *u8, del_len, 2usize)) {
                section = 1usize;
                marker = true;
            } else if (starts_section(line.data, line.len, (&del_buf[0usize]) as *u8, del_len, 1usize)) {
                section = 0usize;
                marker = true;
            };

            if (marker) {
                if (c::fputc(10i32, c::stdout) == -1i32) { status = 1; };
                if (!no_renumber) { number = start_number; };
                blank_run = 0usize;
                continue;
            };

            let blank: bool = line.len == 0usize;
            if (blank) { blank_run += 1usize; } else { blank_run = 0usize; };

            let mut style: u8 = body_style;
            let mut rx: nullable *void = rx_body;
            let mut ready: bool = body_style == 112u8;
            if (section == 0usize) {
                style = header_style; rx = rx_header; ready = header_style == 112u8;
            } else if (section == 2usize) {
                style = footer_style; rx = rx_footer; ready = footer_style == 112u8;
            };

            let mut selected: bool = nl_selected(style, line.data, line.len, rx, ready);
            if (blank && join_blank > 1usize) {
                selected = selected && (blank_run % join_blank == 0usize);
            };

            let mut ok: bool = true;
            if (selected) {
                ok = nl_emit_number(number, width, number_format, separator);
            } else {
                ok = nl_emit_blank(width);
            };
            if (line.len != 0usize && !stream::writebytes(c::stdout, line.data, line.len)) {
                ok = false;
            };
            if (c::fputc(10i32, c::stdout) == -1i32) { ok = false; };
            if (!ok) { status = 1; };
            if (selected) {
                if (18446744073709551615usize - number >= increment) {
                    number += increment;
                };
            };
            if (!terminated && stream::readerror(fp)) { status = 1; };
        };
        if (!is_stdin) {
            stream::closefile(fp);
        };
    };
    mem::freeptr[u8](line.data);
    if (!stream::finishoutput("nl")) { status = 1; };
    if (rx_header != null) { platform_regex::zov_regex_free(rx_header!); };
    if (rx_body != null) { platform_regex::zov_regex_free(rx_body!); };
    if (rx_footer != null) { platform_regex::zov_regex_free(rx_footer!); };
    return status;
};
