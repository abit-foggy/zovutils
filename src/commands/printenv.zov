use std::env as args;
use std::io;
use <stdio.h> as c;
use shared::io as stream;
use <platform_process.h> as process;

fn longkey(arg: str) str = {
    for (let i in 0usize..arg.len) {
        if (arg.data[i] == 61u8) { return arg[0usize..i]; };
    };
    return arg;
};

fn help() void = {
    io::print("Usage: printenv [OPTION] [VARIABLE]...\n");
    io::print("Print the values of the specified environment VARIABLE(s).\n");
    io::print("If no VARIABLE is specified, print name and value pairs for them all.\n\n");
    io::print("  -0, --null\n");
    io::print("         end each output line with NUL, not newline\n");
    io::print("      --help\n");
    io::print("         display this help and exit\n");
    io::print("      --version\n");
    io::print("         output version information and exit\n\n");
    io::print("Your shell may have its own version of printenv, which usually supersedes\n");
    io::print("the version described here.  Please refer to your shell's documentation\n");
    io::print("for details about the options it supports.\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/printenv>\n");
    io::print("or available locally via: info '(coreutils) printenv invocation'\n");
};

fn usage_error() void = {
    c::fprintf(c::stderr, "Try 'printenv --help' for more information.\n");
};

export fn run(start: usize, argc: usize) i32 = {
    let mut zero: bool = false;
    let mut i: usize = start;
    let mut end_options: bool = false;
    while (i < argc && !end_options) {
        let arg: str = args::argat(i);
        if (arg == "--") { end_options = true; i += 1usize; break; };
        if (arg.len == 0usize || arg.data[0usize] != 45u8 || arg == "-") { break; };
        if (arg.len >= 2usize && arg[0usize..2usize] == "--") {
            let key: str = longkey(arg);
            if (key == "--null" || (key.len > 2usize && key.len < 6usize && key == "--null"[0usize..key.len])) {
                if (arg.len != key.len) {
                    c::fprintf(c::stderr, "printenv: option '%s' doesn't allow an argument\n", "--null");
                    usage_error(); return 2;
                };
                zero = true; i += 1usize; continue;
            };
            if (key == "--help" || (key.len > 2usize && key.len < 6usize && key == "--help"[0usize..key.len])) {
                if (arg.len != key.len) {
                    c::fprintf(c::stderr, "printenv: option '%s' doesn't allow an argument\n", "--help");
                    usage_error(); return 2;
                };
                help(); stream::finishoutput("printenv"); return 0;
            };
            if (key == "--version" || (key.len > 2usize && key.len < 9usize && key == "--version"[0usize..key.len])) {
                if (arg.len != key.len) {
                    c::fprintf(c::stderr, "printenv: option '%s' doesn't allow an argument\n", "--version");
                    usage_error(); return 2;
                };
                io::println("printenv (zovutils) 0.1.209");
                stream::finishoutput("printenv"); return 0;
            };
            c::fprintf(c::stderr, "printenv: unrecognized option '%s'\n", arg);
            usage_error(); return 2;
        };
        let mut j: usize = 1usize;
        while (j < arg.len) {
            if (arg.data[j] == 48u8) { zero = true; j += 1usize; continue; };
            c::fprintf(c::stderr, "printenv: invalid option -- '%c'\n", arg.data[j] as i32);
            usage_error(); return 2;
        };
        i += 1usize;
    };
    let mut delimiter: u8 = 10u8;
    if (zero) { delimiter = 0u8; };
    if (i >= argc) {
        let mut use_zero: i32 = 0i32;
        if (zero) { use_zero = 1i32; };
        if (process::zov_env_print(use_zero) != 0i32) { return 1; };
        if (!stream::finishoutput("printenv")) { return 1; };
        return 0;
    };
    let mut status: i32 = 0;
    while (i < argc) {
        let name: str = args::argat(i);
        match (args::get(name)) {
            case let value: str => {
                io::print(value);
                if (!stream::putbyte(c::stdout, delimiter)) { return 1; };
            },
            case EnvNotFound => { status = 1; },
        };
        i += 1usize;
    };
    if (!stream::finishoutput("printenv")) { return 1; };
    return status;
};
