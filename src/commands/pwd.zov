use std::env as args;
use std::io;
use std::mem as mem;
use <stdio.h> as c;
use <pwd_backend.h> as backend;
use shared::io as stream;

fn help() void = {
    io::print("Usage: pwd [OPTION]...\n");
    io::print("Print the full filename of the current working directory.\n\n");
    io::print("  -L, --logical\n");
    io::print("         use PWD from environment, even if it contains symlinks\n");
    io::print("  -P, --physical\n");
    io::print("         resolve all symlinks\n");
    io::print("      --help\n");
    io::print("         display this help and exit\n");
    io::print("      --version\n");
    io::print("         output version information and exit\n\n");
    io::print("If no option is specified, -P is assumed.\n\n");
    io::print("Your shell may have its own version of pwd, which usually supersedes\n");
    io::print("the version described here.  Please refer to your shell's documentation\n");
    io::print("for details about the options it supports.\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/pwd>\n");
    io::print("or available locally via: info '(coreutils) pwd invocation'\n");
};

fn usage_error() void = {
    io::eprintln("Try 'pwd --help' for more information.");
};

fn longkey(arg: str) str = {
    for (let i in 0usize..arg.len) {
        if (arg.data[i] == 61u8) { return arg[0usize..i]; };
    };
    return arg;
};

export fn run(start: usize, argc: usize) i32 = {
    let mut physical: bool = true;
    let mut i: usize = start;
    let mut operands: bool = false;
    let mut end_options: bool = false;
    while (i < argc) {
        let arg: str = args::argat(i);
        if (end_options) { operands = true; i += 1usize; continue; };
        if (arg == "--") { end_options = true; i += 1usize; continue; };
        if (arg.len >= 2usize && arg[0usize..2usize] == "--") {
            let key: str = longkey(arg);
            if (key == "--logical" || (key.len > 2usize && key.len < 9usize && key == "--logical"[0usize..key.len])) {
                if (arg.len != key.len) { io::eprintln("pwd: option '" + "--logical" + "' doesn't allow an argument"); usage_error(); return 1; };
                physical = false; i += 1usize; continue;
            };
            if (key == "--physical" || (key.len > 2usize && key.len < 10usize && key == "--physical"[0usize..key.len])) {
                if (arg.len != key.len) { io::eprintln("pwd: option '" + "--physical" + "' doesn't allow an argument"); usage_error(); return 1; };
                physical = true; i += 1usize; continue;
            };
            if (key == "--help" || (key.len > 2usize && key.len < 6usize && key == "--help"[0usize..key.len])) {
                if (arg.len != key.len) { io::eprintln("pwd: option '" + "--help" + "' doesn't allow an argument"); usage_error(); return 1; };
                help(); stream::finishoutput("pwd"); return 0;
            };
            if (key == "--version" || (key.len > 2usize && key.len < 9usize && key == "--version"[0usize..key.len])) {
                if (arg.len != key.len) { io::eprintln("pwd: option '" + "--version" + "' doesn't allow an argument"); usage_error(); return 1; };
                io::println("pwd (zovutils) 0.10.7"); stream::finishoutput("pwd"); return 0;
            };
            io::eprintln("pwd: unrecognized option '" + arg + "'"); usage_error(); return 1;
        };
        if (arg.len > 1usize && arg.data[0usize] == 45u8) {
            for (let j in 1usize..arg.len) {
                if (arg.data[j] == 76u8) { physical = false; }
                else if (arg.data[j] == 80u8) { physical = true; }
                else {
                    c::fprintf(c::stderr, "pwd: invalid option -- '%c'\n", arg.data[j] as i32);
                    usage_error(); return 1;
                };
            };
            i += 1usize; continue;
        };
        operands = true;
        i += 1usize;
    };
    if (operands) { io::eprintln("pwd: ignoring non-option arguments"); };
    let mut is_physical: i32 = 0i32;
    if (physical) { is_physical = 1i32; };
    let directory: nullable *i8 = backend::zov_pwd_get(is_physical);
    match (directory) {
        case let path: *i8 => {
            c::printf("%s\n", path);
            mem::freeptr[u8](path as *u8);
        },
        case null => {
            c::fprintf(c::stderr, "pwd: error retrieving current directory: getcwd: %s\n", backend::zov_pwd_error());
            return 1;
        },
    };
    if (!stream::finishoutput("pwd")) { return 1; };
    return 0;
};
