use std::env as args;
use std::io;
use <stdio.h> as c;
use <string.h> as strc;
use <platform_errno.h> as platform_errno;
use <platform_process.h> as platform_process;
use <platform_identity.h> as platform_identity;

export fn run(start: usize, argc: usize) i32 = {
    let mut i: usize = start;
    let mut context: str = "";
    let mut has_context: bool = false;

    while (i < argc) {
        let a: str = args::argat(i);
        if (a == "--help") {
            io::println("Usage: runcon CONTEXT COMMAND [ARG]...\n" +
                        "Run COMMAND with specified security context.\n" +
                        "      --help     display this help and exit\n" +
                        "      --version  output version information and exit");
            return 0i32;
        };
        if (a == "--version") {
            io::println("runcon (zovutils) 0.10.61");
            return 0i32;
        };
        if (a.len > 0usize && a.data[0usize] == 45u8 && a != "-") {
            c::fprintf(c::stderr, "runcon: unrecognized option '%s'\nTry 'runcon --help' for more information.\n\0".data as *i8, a.data as *i8);
            return 125i32;
        };
        context = a;
        has_context = true;
        i += 1usize;
        break;
    };

    if (!has_context) {
        c::fputs("runcon: missing operand\nTry 'runcon --help' for more information.\n\0".data as *i8, c::stderr);
        return 125i32;
    };

    if (i >= argc) {
        c::fputs("runcon: no command specified\nTry 'runcon --help' for more information.\n\0".data as *i8, c::stderr);
        return 125i32;
    };

    let ctx_rc: i32 = platform_identity::zov_runcon_set_exec_context(context.data as *i8);
    if (ctx_rc == -1i32) {
        c::fputs("runcon: runcon may be used only on a SELinux kernel\n\0".data as *i8, c::stderr);
        return 125i32;
    };
    if (ctx_rc == -2i32) {
        c::fprintf(c::stderr, "runcon: failed to create security context: '%s': %s\n\0".data as *i8, context.data as *i8, strc::strerror(platform_errno::zov_errno_value()));
        return 125i32;
    };
    if (ctx_rc == -3i32) {
        c::fputs("runcon: security contexts are not supported on this platform\n\0".data as *i8, c::stderr);
        return 125i32;
    };
    if (ctx_rc != 0i32) {
        c::fprintf(c::stderr, "runcon: failed to set context: %s\n\0".data as *i8, strc::strerror(ctx_rc));
        return 125i32;
    };

    let cmd_count: usize = argc - i;
    if (cmd_count > 4096usize) { return 125i32; };
    let mut argv: [4097]*i8;
    for (let j in 0usize..cmd_count) {
        argv[j] = args::argat(i + j).data as *i8;
    };
    argv[cmd_count] = 0 as *i8;
    let prog: str = args::argat(i);
    platform_process::zov_exec_command(prog.data as *i8, (&mut argv[0usize]) as *void);
    let err: i32 = platform_errno::zov_errno_value();
    c::fprintf(c::stderr, "runcon: failed to execute '%s': %s\n\0".data as *i8, prog.data as *i8, strc::strerror(err));
    if (platform_errno::zov_errno_is_enoent(err) != 0i32) {
        return 127i32;
    };
    return 126i32;
};
