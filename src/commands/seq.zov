use std::env as args;
use std::io;
use std::vec;
use <stdio.h> as c;
use <stdlib.h> as stdlib;
use <platform_errno.h> as platform_errno;
use shared::io as stream;

fn usage_error() void = {
    io::eprintln("Try 'seq --help' for more information.");
};

fn help() void = {
    io::print("Usage: seq [OPTION]... LAST\n");
    io::print("  or:  seq [OPTION]... FIRST LAST\n");
    io::print("  or:  seq [OPTION]... FIRST INCREMENT LAST\n");
    io::print("Print numbers from FIRST to LAST, in steps of INCREMENT.\n\n");
    io::print("Mandatory arguments to long options are mandatory for short options too.\n");
    io::print("  -f, --format=FORMAT\n");
    io::print("         use printf style floating-point FORMAT\n");
    io::print("  -s, --separator=STRING\n");
    io::print("         use STRING to separate numbers (default: \\n)\n");
    io::print("  -w, --equal-width\n");
    io::print("         equalize width by padding with leading zeroes\n");
    io::print("      --help\n");
    io::print("         display this help and exit\n");
    io::print("      --version\n");
    io::print("         output version information and exit\n\n");
    io::print("If FIRST or INCREMENT is omitted, it defaults to 1.  That is, an\n");
    io::print("omitted INCREMENT defaults to 1 even when LAST is smaller than FIRST.\n");
    io::print("The sequence of numbers ends when the sum of the current number and\n");
    io::print("INCREMENT would become greater than LAST.\n");
    io::print("FIRST, INCREMENT, and LAST are interpreted as floating point values.\n");
    io::print("INCREMENT is usually positive if FIRST is smaller than LAST, and\n");
    io::print("INCREMENT is usually negative if FIRST is greater than LAST.\n");
    io::print("INCREMENT must not be 0; none of FIRST, INCREMENT and LAST may be NaN.\n");
    io::print("FORMAT must be suitable for printing one argument of type 'double';\n");
    io::print("it defaults to %.PRECf if FIRST, INCREMENT, and LAST are all fixed point\n");
    io::print("decimal numbers with maximum precision PREC, and to %g otherwise.\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/seq>\n");
    io::print("or available locally via: info '(coreutils) seq invocation'\n");
};

fn longkey(arg: str) str = {
    for (let i in 0usize..arg.len) {
        if (arg.data[i] == 61u8) { return arg[0usize..i]; };
    };
    return arg;
};

fn is_prefix(value: str, full: str) bool = {
    return value.len > 2usize && value.len <= full.len && value == full[0usize..value.len];
};

fn is_nan(v: f64) bool = {
    return v != v;
};

fn number_status(value: str, output: &mut f64) i32 = {
    platform_errno::zov_errno_set(0i32);
    let mut end: nullable *i8 = null;
    let mut buf: [128]u8;
    let mut p: *i8 = value.data as *i8;
    if (value.len < 127usize) {
        for (let i in 0usize..value.len) { buf[i] = value.data[i]; };
        buf[value.len] = 0u8;
        p = (&buf[0usize]) as *i8;
    };
    let parsed: f64 = stdlib::strtod(p, (&end) as **i8);
    match (end) {
        case let ep: *i8 => {
            if (ep == p || ep[0] != 0i8) { return 1i32; };
        },
        case null => { return 1i32; },
    };
    if (is_nan(parsed)) { return 2i32; };
    if (platform_errno::zov_errno_is_erange() != 0i32) { return 3i32; };
    *output = parsed;
    return 0i32;
};

fn looks_numeric(value: str) bool = {
    let mut parsed: f64 = 0.0f64;
    return number_status(value, &mut parsed) != 1i32;
};

fn numeric_error(value: str, kind: i32) void = {
    if (kind == 1i32) { io::eprintln("seq: invalid floating point argument: '" + value + "'"); }
    else if (kind == 2i32) { io::eprintln("seq: invalid 'not-a-number' argument: '" + value + "'"); }
    else { io::eprintln("seq: invalid floating point argument: '" + value + "'"); };
    usage_error();
};

fn fixed_precision(value: str, fixed: &mut bool) i32 = {
    let mut after_dot: bool = false;
    let mut precision: i32 = 0i32;
    for (let i in 0usize..value.len) {
        let ch: u8 = value.data[i];
        if (ch == 101u8 || ch == 69u8) { *fixed = false; };
        if (ch == 46u8) { after_dot = true; }
        else if (after_dot && ch >= 48u8 && ch <= 57u8) { precision += 1i32; };
    };
    return precision;
};

fn is_flag(ch: u8) bool = {
    return ch == 45u8 || ch == 43u8 || ch == 32u8 || ch == 35u8 || ch == 48u8 || ch == 39u8; // -+ #0'
};

fn is_conv(ch: u8) bool = {
    return ch == 97u8 || ch == 65u8 || ch == 101u8 || ch == 69u8 || ch == 102u8 || ch == 70u8 || ch == 103u8 || ch == 71u8; // aAeEfFgG
};

fn seq_validate_format(format: str, bad_conv: &mut i32) i32 = {
    let mut conversions: i32 = 0i32;
    *bad_conv = 0i32;
    let mut i: usize = 0usize;
    while (i < format.len) {
        if (format.data[i] != 37u8) {
            i += 1usize;
            continue;
        };
        i += 1usize;
        if (i == format.len) {
            *bad_conv = 0i32;
            return 4i32;
        };
        if (format.data[i] == 37u8) {
            i += 1usize;
            continue;
        };
        conversions += 1i32;
        while (i < format.len && is_flag(format.data[i])) {
            i += 1usize;
        };
        while (i < format.len && format.data[i] >= 48u8 && format.data[i] <= 57u8) {
            i += 1usize;
        };
        if (i < format.len && format.data[i] == 36u8) {
            *bad_conv = 36i32;
            return 2i32;
        };
        if (i < format.len && format.data[i] == 46u8) {
            i += 1usize;
            while (i < format.len && format.data[i] >= 48u8 && format.data[i] <= 57u8) {
                i += 1usize;
            };
        };
        if (i < format.len && (format.data[i] == 76u8 || format.data[i] == 108u8)) {
            i += 1usize;
        };
        if (i == format.len || !is_conv(format.data[i])) {
            if (i < format.len) { *bad_conv = format.data[i] as i32; }
            else { *bad_conv = 0i32; };
            return 2i32;
        };
        i += 1usize;
        if (conversions > 1i32) { return 3i32; };
    };
    if (conversions == 0i32) { return 1i32; };
    return 0i32;
};

fn seq_normalize_format(format: str) Vec[u8] = {
    let mut out = vec::new[u8]();
    let mut i: usize = 0usize;
    while (i < format.len) {
        let ch: u8 = format.data[i];
        out.push(ch);
        if (ch != 37u8) {
            i += 1usize;
            continue;
        };
        if (i + 1usize < format.len && format.data[i + 1usize] == 37u8) {
            i += 1usize;
            out.push(format.data[i]);
            i += 1usize;
            continue;
        };
        i += 1usize;
        while (i < format.len && is_flag(format.data[i])) {
            out.push(format.data[i]);
            i += 1usize;
        };
        while (i < format.len && format.data[i] >= 48u8 && format.data[i] <= 57u8) {
            out.push(format.data[i]);
            i += 1usize;
        };
        if (i < format.len && format.data[i] == 46u8) {
            out.push(format.data[i]);
            i += 1usize;
            while (i < format.len && format.data[i] >= 48u8 && format.data[i] <= 57u8) {
                out.push(format.data[i]);
                i += 1usize;
            };
        };
        if (i < format.len && (format.data[i] == 76u8 || format.data[i] == 108u8)) {
            i += 1usize;
        };
        if (i < format.len) {
            out.push(format.data[i]);
            i += 1usize;
        };
    };
    out.push(0u8);
    return out;
};

fn seq_default_width(first: f64, last: f64, fixed: bool, precision: i32) i32 = {
    let mut buf1: [256]u8;
    let mut buf2: [256]u8;
    let mut n1: i32 = 0i32;
    let mut n2: i32 = 0i32;
    if (fixed) {
        n1 = c::snprintf((&buf1[0usize]) as *i8, 256usize, "%.*f\0".data as *i8, precision, first);
        n2 = c::snprintf((&buf2[0usize]) as *i8, 256usize, "%.*f\0".data as *i8, precision, last);
    } else {
        n1 = c::snprintf((&buf1[0usize]) as *i8, 256usize, "%.*g\0".data as *i8, precision, first);
        n2 = c::snprintf((&buf2[0usize]) as *i8, 256usize, "%.*g\0".data as *i8, precision, last);
    };
    let mut w: i32 = n1;
    if (n2 > w) { w = n2; };
    return w;
};

export fn run(start: usize, argc: usize) i32 = {
    let mut format: str = "";
    let mut has_format: bool = false;
    let mut separator: str = "\n";
    let mut equal_width: bool = false;
    let mut operands: [3]str;
    let mut operand_count: usize = 0usize;
    let mut i: usize = start;
    let mut options_done: bool = false;
    while (i < argc) {
        let arg: str = args::argat(i);
        if (!options_done && arg == "--") { options_done = true; i += 1usize; continue; };
        if (!options_done && arg.len > 2usize && arg[0usize..2usize] == "--") {
            let key: str = longkey(arg);
            if (key == "--format" || is_prefix(key, "--format")) {
                if (arg.len == key.len && i + 1usize >= argc) {
                    io::eprintln("seq: option '--format' requires an argument"); usage_error(); return 1;
                };
                if (arg.len > key.len) { format = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { format = args::argat(i + 1usize); i += 2usize; };
                has_format = true; continue;
            };
            if (key == "--separator" || is_prefix(key, "--separator")) {
                if (arg.len == key.len && i + 1usize >= argc) {
                    io::eprintln("seq: option '--separator' requires an argument"); usage_error(); return 1;
                };
                if (arg.len > key.len) { separator = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { separator = args::argat(i + 1usize); i += 2usize; };
                continue;
            };
            if (key == "--equal-width" || is_prefix(key, "--equal-width")) {
                if (arg.len != key.len) { io::eprintln("seq: option '--equal-width' doesn't allow an argument"); usage_error(); return 1; };
                equal_width = true; i += 1usize; continue;
            };
            if (key == "--help" || is_prefix(key, "--help")) {
                if (arg.len != key.len) { io::eprintln("seq: option '--help' doesn't allow an argument"); usage_error(); return 1; };
                help(); stream::finishoutput("seq"); return 0;
            };
            if (key == "--version" || is_prefix(key, "--version")) {
                if (arg.len != key.len) { io::eprintln("seq: option '--version' doesn't allow an argument"); usage_error(); return 1; };
                io::println("seq (zovutils) 0.10.61"); stream::finishoutput("seq"); return 0;
            };
            io::eprintln("seq: unrecognized option '" + arg + "'"); usage_error(); return 1;
        };
        if (!options_done && arg.len > 1usize && arg.data[0usize] == 45u8 && !looks_numeric(arg)) {
            let mut j: usize = 1usize;
            while (j < arg.len) {
                if (arg.data[j] == 119u8) { equal_width = true; j += 1usize; continue; };
                if (arg.data[j] == 102u8 || arg.data[j] == 115u8) {
                    let option: u8 = arg.data[j];
                    let mut value: str = "";
                    if (j + 1usize < arg.len) { value = arg[j + 1usize..arg.len]; }
                    else if (i + 1usize < argc) { i += 1usize; value = args::argat(i); }
                    else {
                        c::fprintf(c::stderr, "seq: option requires an argument -- '%c'\n", option as i32);
                        usage_error(); return 1;
                    };
                    if (option == 102u8) { format = value; has_format = true; }
                    else { separator = value; };
                    j = arg.len; continue;
                };
                c::fprintf(c::stderr, "seq: invalid option -- '%c'\n", arg.data[j] as i32);
                usage_error(); return 1;
            };
            i += 1usize; continue;
        };
        if (operand_count >= 3usize) {
            io::eprintln("seq: extra operand '" + arg + "'"); usage_error(); return 1;
        };
        operands[operand_count] = arg;
        operand_count += 1usize;
        i += 1usize;
    };
    if (operand_count == 0usize) {
        io::eprintln("seq: missing operand"); usage_error(); return 1;
    };
    if (has_format && equal_width) {
        io::eprintln("seq: format string may not be specified when printing equal width strings");
        usage_error(); return 1;
    };

    let mut first_text: str = "1";
    let mut increment_text: str = "1";
    let mut last_text: str = "";
    if (operand_count == 1usize) { last_text = operands[0usize]; }
    else if (operand_count == 2usize) { first_text = operands[0usize]; last_text = operands[1usize]; }
    else { first_text = operands[0usize]; increment_text = operands[1usize]; last_text = operands[2usize]; };

    let mut first: f64 = 0.0f64;
    let mut increment: f64 = 1.0f64;
    let mut last: f64 = 0.0f64;
    let first_status: i32 = number_status(first_text, &mut first);
    if (first_status != 0i32) { numeric_error(first_text, first_status); return 1; };
    let increment_status: i32 = number_status(increment_text, &mut increment);
    if (increment_status != 0i32) { numeric_error(increment_text, increment_status); return 1; };
    let last_status: i32 = number_status(last_text, &mut last);
    if (last_status != 0i32) { numeric_error(last_text, last_status); return 1; };
    if (increment == 0.0f64) {
        io::eprintln("seq: invalid Zero increment value: '" + increment_text + "'"); usage_error(); return 1;
    };

    let mut fixed: bool = true;
    let mut precision: i32 = 0i32;
    let first_precision: i32 = fixed_precision(first_text, &mut fixed);
    let increment_precision: i32 = fixed_precision(increment_text, &mut fixed);
    let last_precision: i32 = fixed_precision(last_text, &mut fixed);
    precision = first_precision;
    if (increment_precision > precision) { precision = increment_precision; };
    if (last_precision > precision) { precision = last_precision; };
    if (!fixed) { precision = 6i32; };

    let mut normalized_format = vec::new[u8]();
    if (has_format) {
        let mut bad_conversion: i32 = 0i32;
        let format_status: i32 = seq_validate_format(format, &mut bad_conversion);
        if (format_status == 1i32) {
            io::eprintln("seq: format '" + format + "' has no %" + " directive"); return 1;
        };
        if (format_status == 2i32) {
            if (bad_conversion == 0i32) {
                c::fprintf(c::stderr, "seq: format '%%' has unknown %% directive\n");
            } else {
                io::eprint("seq: format '" + format + "' has unknown %");
                c::fputc(bad_conversion, c::stderr);
                io::eprintln(" directive");
            };
            return 1;
        };
        if (format_status == 3i32) { io::eprintln("seq: format '" + format + "' has too many %" + " directives"); return 1; };
        if (format_status == 4i32) { io::eprintln("seq: format '" + format + "' ends in %"); return 1; };
        normalized_format = seq_normalize_format(format);
    };

    let mut format_c_buf: [256]u8;
    let mut format_ptr: *i8 = "\0".data as *i8;
    if (has_format) {
        if (normalized_format.len() > 0usize) {
            format_ptr = ((&normalized_format.asslice()[0usize]) as *u8) as *i8;
        } else {
            for (let k in 0usize..format.len) { format_c_buf[k] = format.data[k]; };
            format_c_buf[format.len] = 0u8;
            format_ptr = (&format_c_buf[0usize]) as *i8;
        };
    };

    let mut width: i32 = 0i32;
    if (equal_width) { width = seq_default_width(first, last, fixed, precision); };

    let mut current: f64 = first;
    let mut printed: bool = false;
    let mut status: i32 = 0i32;
    while ((increment > 0.0f64 && current <= last) || (increment < 0.0f64 && current >= last)) {
        if (printed && !stream::putstr(c::stdout, separator)) { status = 1; break; };
        if (has_format) {
            let mut buf: [512]u8;
            let n: i32 = c::snprintf((&buf[0usize]) as *i8, 512usize, format_ptr, current);
            if (n < 0i32) { status = 1; break; };
            c::fputs((&buf[0usize]) as *i8, c::stdout);
        } else {
            let mut buf: [256]u8;
            let mut n: i32 = 0i32;
            if (fixed) {
                if (width > 0i32) {
                    n = c::snprintf((&buf[0usize]) as *i8, 256usize, "%0*.*f\0".data as *i8, width, precision, current);
                } else {
                    n = c::snprintf((&buf[0usize]) as *i8, 256usize, "%.*f\0".data as *i8, precision, current);
                };
            } else {
                if (width > 0i32) {
                    n = c::snprintf((&buf[0usize]) as *i8, 256usize, "%0*.*g\0".data as *i8, width, precision, current);
                } else {
                    n = c::snprintf((&buf[0usize]) as *i8, 256usize, "%.*g\0".data as *i8, precision, current);
                };
            };
            if (n < 0i32) { status = 1; break; };
            c::fputs((&buf[0usize]) as *i8, c::stdout);
        };
        printed = true;
        let next: f64 = current + increment;
        if (next == current) { break; };
        current = next;
    };
    if (printed && !stream::putbyte(c::stdout, 10u8)) { status = 1; };
    if (!stream::finishoutput("seq")) { return 1; };
    return status;
};
