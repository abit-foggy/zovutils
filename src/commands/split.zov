use std::env as args;
use std::io;
use <stdio.h> as c;
use <split_backend.h> as backend;
use shared::io as stream;

fn key(arg: str) str = {
    for (let i in 0usize..arg.len) { if (arg.data[i] == 61u8) { return arg[0usize..i]; }; };
    return arg;
};

fn prefix(value: str, full: str) bool = {
    return value.len > 2usize && value.len <= full.len && value == full[0usize..value.len];
};

fn parse_number(value: str, out: &mut u64) bool = {
    if (value.len == 0usize) { return false; };
    let mut n: u64 = 0u64;
    for (let i in 0usize..value.len) {
        let ch: u8 = value.data[i];
        if (ch < 48u8 || ch > 57u8) { return false; };
        let d: u64 = (ch - 48u8) as u64;
        if (n > (18446744073709551615u64 - d) / 10u64) { return false; };
        n = n * 10u64 + d;
    };
    *out = n; return true;
};

fn parse_size(value: str, out: &mut u64) bool = {
    let mut end: usize = 0usize;
    while (end < value.len && value.data[end] >= 48u8 && value.data[end] <= 57u8) { end += 1usize; };
    if (end == 0usize) { return false; };
    let mut n: u64 = 0u64;
    if (!parse_number(value[0usize..end], &mut n)) { return false; };
    if (end < value.len) {
        let unit: u8 = value.data[end];
        let mut power: u32 = 0u32;
        if (unit == 75u8 || unit == 107u8) { power = 1u32; } else if (unit == 77u8 || unit == 109u8) { power = 2u32; } else if (unit == 71u8 || unit == 103u8) { power = 3u32; } else if (unit == 84u8 || unit == 116u8) { power = 4u32; } else if (unit == 80u8 || unit == 112u8) { power = 5u32; } else if (unit == 69u8 || unit == 101u8) { power = 6u32; } else if (unit == 90u8 || unit == 122u8) { power = 7u32; } else if (unit == 89u8 || unit == 121u8) { power = 8u32; } else if (unit == 82u8 || unit == 114u8) { power = 9u32; } else if (unit == 81u8 || unit == 113u8) { power = 10u32; } else { return false; };
        let decimal: bool = end + 1usize < value.len && value.data[end + 1usize] == 66u8;
        if (end + 1usize < value.len && !decimal && !(value.data[end + 1usize] == 105u8 && end + 2usize < value.len && value.data[end + 2usize] == 66u8)) { return false; };
        let mut base: u64 = 1024u64; if (decimal) { base = 1000u64; };
        for (let _j in 0u32..power) { if (n > 18446744073709551615u64 / base) { return false; }; n *= base; };
    };
    *out = n; return true;
};

fn help() void = {
    io::print("Usage: split [OPTION]... [FILE [PREFIX]]\nOutput pieces of FILE to PREFIXaa, PREFIXab, ...;\ndefault size is 1000 lines, and default PREFIX is 'x'.\n\nWith no FILE, or when FILE is -, read standard input.\n\nMandatory arguments to long options are mandatory for short options too.\n  -a, --suffix-length=N\n         generate suffixes of length N (default 2)\n      --additional-suffix=SUFFIX\n         append an additional SUFFIX to file names\n  -b, --bytes=SIZE\n         put SIZE bytes per output file\n  -C, --line-bytes=SIZE\n         put at most SIZE bytes of records per output file\n  -d\n         use numeric suffixes starting at 0, not alphabetic\n      --numeric-suffixes[=FROM]\n         same as -d, but allow setting the start value\n  -x\n         use hex suffixes starting at 0, not alphabetic\n      --hex-suffixes[=FROM]\n         same as -x, but allow setting the start value\n  -e, --elide-empty-files\n         do not generate empty output files with '-n'\n      --filter=COMMAND\n         write to shell COMMAND; file name is $FILE\n  -l, --lines=NUMBER\n         put NUMBER lines/records per output file\n  -n, --number=CHUNKS\n         generate CHUNKS output files; see explanation below\n  -t, --separator=SEP\n         use SEP instead of newline as the record separator;\n         '"); c::putchar(92); io::print("0' (zero) specifies the NUL character\n  -u, --unbuffered\n         immediately copy input to output with '-n r/...'\n      --verbose\n         print a diagnostic just before each output file is opened\n      --help\n         display this help and exit\n      --version\n         output version information and exit\n\nThe SIZE argument is an integer and optional unit (example: 10K is 10*1024).\nUnits are K,M,G,T,P,E,Z,Y,R,Q (powers of 1024) or KB,MB,... (powers of 1000).\nBinary prefixes can be used, too: KiB=K, MiB=M, and so on.\n\nCHUNKS may be:\n  N       split into N files based on size of input\n  K/N     output Kth of N to standard output\n  l/N     split into N files without splitting lines/records\n  l/K/N   output Kth of N to standard output without splitting lines/records\n  r/N     like 'l' but use round robin distribution\n  r/K/N   likewise but only output Kth of N to standard output\n\n-n (except -nr) will buffer to $TMPDIR, defaulting to /tmp,\nif the input size cannot easily be determined.\n\nReport bugs to: bug-coreutils@gnu.org\nGNU coreutils home page: <https://www.gnu.org/software/coreutils/>\nGeneral help using GNU software: <https://www.gnu.org/gethelp/>\nReport any translation bugs to <https://translationproject.org/team/>\nFull documentation <https://www.gnu.org/software/coreutils/split>\nor available locally via: info '(coreutils) split invocation'\n");
};

export fn run(start: usize, argc: usize) i32 = {
    let mut mode: u8 = 1u8;
    let mut amount: u64 = 1000u64;
    let mut selector: u64 = 0u64;
    let mut prefix_value: str = "x";
    let mut additional: str = "";
    let mut filter_command: str = "";
    let mut width: usize = 2usize;
    let mut suffix_mode: i32 = 0i32;
    let mut from: u64 = 0u64;
    let mut verbose: bool = false;
    let mut separator: u8 = 10u8;
    let mut elide_empty: bool = false;
    let mut operands: [3]str;
    let mut operand_count: usize = 0usize;
    let mut i: usize = start;
    let mut options_done: bool = false;
    while (i < argc) {
        let arg: str = args::argat(i);
        if (!options_done && arg == "--") { options_done = true; i += 1usize; continue; };
        if (!options_done && arg.len > 2usize && arg[0usize..2usize] == "--") {
            let option: str = key(arg);
            if (option == "--help" || prefix(option, "--help")) { help(); stream::finishoutput("split"); return 0; };
            if (option == "--version" || prefix(option, "--version")) { io::println("split (zovutils) 0.10.16"); stream::finishoutput("split"); return 0; };
            if (option == "--verbose" || prefix(option, "--verbose")) { verbose = true; i += 1usize; continue; };
            if (option == "--elide-empty-files" || prefix(option, "--elide-empty-files")) { elide_empty = true; i += 1usize; continue; };
            if (option == "--unbuffered" || prefix(option, "--unbuffered")) { i += 1usize; continue; };
            if (option == "--numeric-suffixes" || option == "--hex-suffixes") {
                if (option == "--numeric-suffixes") { suffix_mode = 1i32; } else { suffix_mode = 2i32; };
                if (arg.len > option.len) { if (!parse_number(arg[option.len + 1usize..arg.len], &mut from)) { io::eprintln("split: invalid suffix start value"); return 1; }; i += 1usize; }
                else { i += 1usize; };
                continue;
            };
            let mut kind: u8 = 0u8;
            if (option == "--bytes" || prefix(option, "--bytes")) { kind = 1u8; }
            if (option == "--lines" || prefix(option, "--lines")) { kind = 2u8; }
            if (option == "--number" || prefix(option, "--number")) { kind = 3u8; }
            if (option == "--line-bytes" || prefix(option, "--line-bytes")) { kind = 4u8; }
            if (option == "--suffix-length" || prefix(option, "--suffix-length")) { kind = 5u8; }
            if (option == "--additional-suffix" || prefix(option, "--additional-suffix")) { kind = 6u8; }
            if (option == "--separator" || prefix(option, "--separator")) { kind = 7u8; }
            if (option == "--filter" || prefix(option, "--filter")) { kind = 8u8; }
            if (kind != 0u8) {
                let mut value: str = "";
                if (arg.len > option.len) { value = arg[option.len + 1usize..arg.len]; i += 1usize; }
                else if (i + 1usize < argc) { value = args::argat(i + 1usize); i += 2usize; }
                else { io::eprintln("split: option '" + option + "' requires an argument"); return 1; };
                if (kind == 1u8 || kind == 4u8) { if (!parse_size(value, &mut amount)) { io::eprintln("split: invalid number of bytes: '" + value + "'"); return 1; }; if (kind == 1u8) { mode = 0u8; } else { mode = 3u8; }; }
                else if (kind == 2u8) { if (!parse_number(value, &mut amount) || amount == 0u64) { io::eprintln("split: invalid number of lines: '" + value + "'"); return 1; }; mode = 1u8; }
                else if (kind == 3u8) {
                    let mut n: u64 = 0u64;
                    if (value == "") { return 1; };
                    let mut a: usize = 0usize; while (a < value.len && value.data[a] != 47u8) { a += 1usize; };
                    if (a == value.len) { if (!parse_number(value, &mut amount)) { io::eprintln("split: invalid number of chunks: '" + value + "'"); return 1; }; mode = 2u8; }
                    else if (a == 1usize && (value.data[0usize] == 108u8 || value.data[0usize] == 114u8)) {
                        let round: bool = value.data[0usize] == 114u8; let mut b: usize = a + 1usize; while (b < value.len && value.data[b] != 47u8) { b += 1usize; };
                        if (b == value.len) { if (!parse_number(value[a + 1usize..value.len], &mut amount)) { return 1; }; if (round) { mode = 4u8; } else { mode = 5u8; }; }
                        else { if (!parse_number(value[a + 1usize..b], &mut n) || n == 0u64 || !parse_number(value[b + 1usize..value.len], &mut amount)) { io::eprintln("split: invalid number of chunks: '" + value + "'"); return 1; }; selector = n; if (round) { mode = 4u8; } else { mode = 5u8; }; };
                    } else {
                        if (!parse_number(value[0usize..a], &mut n) || n == 0u64 || !parse_number(value[a + 1usize..value.len], &mut amount)) { io::eprintln("split: invalid number of chunks: '" + value + "'"); return 1; }; selector = n; mode = 2u8;
                    };
                    if (amount == 0u64) { io::eprintln("split: invalid number of chunks: '" + value + "'"); return 1; };
                } else if (kind == 5u8) { let mut n: u64 = 0u64; if (!parse_number(value, &mut n) || n == 0u64 || n > 32u64) { io::eprintln("split: invalid suffix length: '" + value + "'"); return 1; }; width = n as usize; }
                else if (kind == 6u8) { additional = value; }
                else if (kind == 7u8) { if (value == "\\0") { separator = 0u8; } else if (value.len == 1usize) { separator = value.data[0usize]; } else { io::eprintln("split: multi-character separator '" + value + "'"); return 1; } }
                else { filter_command = value; };
                continue;
            };
            io::eprintln("split: unrecognized option '" + arg + "'\nTry 'split --help' for more information."); return 1;
        };
        if (!options_done && arg.len > 1usize && arg.data[0usize] == 45u8) {
            let mut j: usize = 1usize;
            while (j < arg.len) {
                let option: u8 = arg.data[j];
                if (option == 100u8) { suffix_mode = 1i32; j += 1usize; continue; };
                if (option == 120u8) { suffix_mode = 2i32; j += 1usize; continue; };
                if (option == 101u8) { elide_empty = true; j += 1usize; continue; };
                if (option == 117u8) { j += 1usize; continue; };
                if (option == 97u8 || option == 98u8 || option == 67u8 || option == 108u8 || option == 110u8 || option == 116u8) {
                    let mut value: str = "";
                    if (j + 1usize < arg.len) { value = arg[j + 1usize..arg.len]; j = arg.len; }
                    else if (i + 1usize < argc) { i += 1usize; value = args::argat(i); j = arg.len; }
                    else { c::fprintf(c::stderr, "split: option requires an argument -- '%c'\n", option as i32); return 1; };
                    if (option == 97u8) { let mut n: u64 = 0u64; if (!parse_number(value, &mut n) || n == 0u64 || n > 32u64) { return 1; }; width = n as usize; }
                    else if (option == 98u8 || option == 67u8) { if (!parse_size(value, &mut amount)) { io::eprintln("split: invalid number of bytes: '" + value + "'"); return 1; }; if (option == 98u8) { mode = 0u8; } else { mode = 3u8; }; }
                    else if (option == 108u8) { if (!parse_number(value, &mut amount) || amount == 0u64) { return 1; }; mode = 1u8; }
                    else if (option == 110u8) {
                        let mut slash: usize = 0usize; while (slash < value.len && value.data[slash] != 47u8) { slash += 1usize; };
                        if (slash == value.len) { if (!parse_number(value, &mut amount)) { return 1; }; mode = 2u8; }
                        else if (slash == 1usize && (value.data[0usize] == 108u8 || value.data[0usize] == 114u8)) {
                            let round: bool = value.data[0usize] == 114u8; let mut slash2: usize = slash + 1usize; while (slash2 < value.len && value.data[slash2] != 47u8) { slash2 += 1usize; };
                            if (slash2 == value.len) { if (!parse_number(value[slash + 1usize..value.len], &mut amount)) { return 1; }; if (round) { mode = 4u8; } else { mode = 5u8; }; }
                            else { if (!parse_number(value[slash + 1usize..slash2], &mut selector) || !parse_number(value[slash2 + 1usize..value.len], &mut amount)) { return 1; }; if (round) { mode = 4u8; } else { mode = 5u8; }; };
                        } else { if (!parse_number(value[0usize..slash], &mut selector) || !parse_number(value[slash + 1usize..value.len], &mut amount)) { return 1; }; mode = 2u8; };
                    } else { if (value == "\\0") { separator = 0u8; } else if (value.len == 1usize) { separator = value.data[0usize]; } else { return 1; } };
                    break;
                };
                if (option == 109u8) { io::eprintln("split: invalid option -- 'm'"); return 1; };
                c::fprintf(c::stderr, "split: invalid option -- '%c'\nTry 'split --help' for more information.\n", option as i32); return 1;
            };
            i += 1usize; continue;
        };
        if (operand_count >= 2usize) { io::eprintln("split: extra operand '" + arg + "'\nTry 'split --help' for more information."); return 1; };
        operands[operand_count] = arg; operand_count += 1usize; i += 1usize;
    };
    let mut input: str = "-";
    if (operand_count == 1usize) { input = operands[0usize]; }
    if (operand_count == 2usize) { input = operands[0usize]; prefix_value = operands[1usize]; };
    if (amount == 0u64) { io::eprintln("split: invalid number or size"); return 1; };
    return backend::zov_split_run(input.data as *i8, prefix_value.data as *i8,
        additional.data as *i8, width, suffix_mode, from, verbose as i32,
        separator, mode as i32, amount, selector, (mode == 4u8) as i32, elide_empty as i32,
        filter_command.data as *i8);
};
