use std::env;
use std::io;
use std::vec as vec;
use <stdio.h> as c;
use <unistd.h> as posix;
use <platform_env.h> as platform_env;
use <platform_errno.h> as platform_errno;
use <stdlib.h> as libc;
use <string.h> as strc;
use <tail_watch.h> as tailwatch;
use shared::io as stream;
use shared::numbers as numparse;
use shared::platform as platform;

fn readinput(fp: *c::FILE, buf: *u8, cap: usize, raw: bool) i64 = {
    if (raw) { return stream::readonce(fp, buf, cap); };
    return stream::readbytes(fp, buf, cap) as i64;
};

fn spool(fp: *c::FILE, tmp: *c::FILE, raw_input: bool) bool = {
    let buf: [65536]u8;
    while (true) {
        let read_count: i64 = readinput(fp, ((&buf[0usize]) as *u8), 65536usize, raw_input);
        if (read_count == 0i64) { break; };
        if (read_count < 0i64) {
            if (raw_input && platform_errno::zov_errno_would_block() != 0i32) { break; };
            return false;
        };
        let n: usize = read_count as usize;
        if (!stream::writebytes(tmp, ((&buf[0usize]) as *u8), n)) { return false; };
    };
    if (!raw_input) { return !stream::readerror(fp); };
    return true;
};

fn copyfrom(fp: *c::FILE, start: i64, dest: *c::FILE) bool = {
    if (c::fseek(fp, start, c::SEEK_SET) != 0) { return false; };
    let buf: [65536]u8;
    while (true) {
        let n: usize = stream::readbytes(fp, ((&buf[0usize]) as *u8), 65536usize);
        if (n == 0usize) { break; };
        if (!stream::writebytes(dest, ((&buf[0usize]) as *u8), n)) { return false; };
    };
    return !stream::readerror(fp);
};

fn tail_bytes_pipe(fp: *c::FILE, count: usize, dest: *c::FILE, raw_input: bool) bool = {
    let mut ring: nullable *u8 = null;
    let mut capacity: usize = count;
    if (capacity > 65536usize) { capacity = 65536usize; };
    if (count > 0usize) {
        let allocated: nullable *void = libc::malloc(capacity);
        if (allocated == null) { return false; };
        ring = (allocated! as *u8) as nullable *u8;
    };
    let mut kept: usize = 0usize;
    let mut next: usize = 0usize;
    let buf: [65536]u8;
    let mut ok: bool = true;
    while (ok) {
        let read_count: i64 = readinput(fp, ((&buf[0usize]) as *u8), 65536usize, raw_input);
        if (read_count == 0i64) { break; };
        if (read_count < 0i64) {
            if (raw_input && platform_errno::zov_errno_would_block() != 0i32) { break; };
            ok = false; break;
        };
        let n: usize = read_count as usize;
        if (count == 0usize) { continue; };
        for (let i in 0..n) {
            if (kept == capacity && capacity < count) {
                let mut new_capacity: usize = count;
                if (capacity <= count - capacity) { new_capacity = capacity * 2usize; };
                let grown: nullable *void = libc::realloc(ring! as *void, new_capacity);
                if (grown == null) { ok = false; break; };
                ring = (grown! as *u8) as nullable *u8;
                capacity = new_capacity;
                next = kept;
            };
            ring![next] = buf[i];
            next += 1usize;
            if (next == capacity) { next = 0usize; };
            if (kept < count) { kept += 1usize; };
        };
        if (!ok) { break; };
    };
    if (ok && !raw_input && stream::readerror(fp)) { ok = false; };
    if (ok && kept > 0usize) {
        if (kept < count) {
            ok = stream::writebytes(dest, ((&ring![0usize]) as *u8), kept);
        } else {
            let tail_len: usize = count - next;
            if (tail_len > 0usize) { ok = stream::writebytes(dest, ((&ring![next]) as *u8), tail_len); };
            if (ok && next > 0usize) { ok = stream::writebytes(dest, ((&ring![0usize]) as *u8), next); };
        };
    };
    if (ring != null) { libc::free(ring! as *void); };
    return ok;
};

fn tailfrom(fp: *c::FILE, count: usize, bytes: bool, delim: u8, dest: *c::FILE, raw_input: bool, presume_input_pipe: bool) bool = {
    if (bytes && presume_input_pipe) { return tail_bytes_pipe(fp, count, dest, raw_input); };
    if (bytes && stream::characterfile(fp)) {
        let descriptor: i32 = c::fileno(fp);
        let initial: i64 = posix::lseek(descriptor, 0i64, c::SEEK_CUR);
        if (initial >= 0i64) {
            let end: i64 = posix::lseek(descriptor, 0i64, c::SEEK_END);
            if (end >= 0i64) {
                let mut target: i64 = initial;
                if (end > initial && count < (end - initial) as usize) {
                    target = end - count as i64;
                };
                if (c::fseek(fp, target, c::SEEK_SET) != 0
                    || !stream::seekdescriptor(fp, target)) { return false; };
                let buf: [65536]u8;
                let mut remaining: usize = count;
                while (remaining > 0usize) {
                    let mut want: usize = remaining;
                    if (want > 65536usize) { want = 65536usize; };
                    let read_count: i64 = readinput(fp, ((&buf[0usize]) as *u8), want, raw_input);
                    if (read_count < 0i64) {
                        if (raw_input && platform_errno::zov_errno_would_block() != 0i32) { break; };
                        return false;
                    };
                    if (read_count == 0i64) { break; };
                    let n: usize = read_count as usize;
                    if (!stream::writebytes(dest, ((&buf[0usize]) as *u8), n)) { return false; };
                    remaining -= n;
                };
                return true;
            };
            posix::lseek(descriptor, initial, c::SEEK_SET);
        };
    };
    let raw: nullable *c::FILE = c::tmpfile();
    if (raw == null) { return false; };
    let tmp: *c::FILE = raw!;
    if (!spool(fp, tmp, raw_input)) { c::fclose(tmp); return false; };
    if (c::fseek(tmp, 0i64, c::SEEK_END) != 0) { c::fclose(tmp); return false; };
    let size: i64 = c::ftell(tmp);
    if (size < 0i64) { c::fclose(tmp); return false; };
    let mut start: i64 = 0i64;
    if (count == 0usize) {
        start = size;
    } else if (bytes) {
        if (count == 0usize) { start = size; }
        else if (count < size as usize) { start = size - count as i64; };
    } else if (size > 0i64) {
        let mut pos: i64 = size;
        if (c::fseek(tmp, size - 1i64, c::SEEK_SET) == 0 && c::fgetc(tmp) == delim as i32) { pos = size - 1i64; };
        let mut found: usize = 0usize;
        while (pos > 0i64 && found < count) {
            pos -= 1i64;
            if (c::fseek(tmp, pos, c::SEEK_SET) != 0) { c::fclose(tmp); return false; };
            if (c::fgetc(tmp) == delim as i32) { found += 1usize; start = pos + 1i64; };
        };
        if (found < count) { start = 0i64; };
    };
    let ok: bool = copyfrom(tmp, start, dest);
    c::fclose(tmp);
    return ok;
};

fn tailplus(fp: *c::FILE, count: usize, bytes: bool, delim: u8, dest: *c::FILE, raw_input: bool) bool = {
    let buf: [65536]u8;
    let mut remain: usize = 0usize;
    if (count > 0usize) { remain = count - 1usize; };
    let mut output: bool = remain == 0usize;
    while (true) {
        let read_count: i64 = readinput(fp, ((&buf[0usize]) as *u8), 65536usize, raw_input);
        if (read_count == 0i64) { break; };
        if (read_count < 0i64) { return false; };
        let n: usize = read_count as usize;
        let mut begin: usize = 0usize;
        if (!output) {
            let mut i: usize = 0usize;
            while (i < n) {
                if (bytes) {
                    if (remain == 0usize) { begin = i; output = true; break; };
                    remain -= 1usize;
                } else if (buf[i] == delim) {
                    remain -= 1usize;
                    if (remain == 0usize) { begin = i + 1usize; output = true; break; };
                };
                i += 1usize;
            };
        };
        if (output && begin < n && !stream::writebytes(dest, ((&buf[begin]) as *u8), n - begin)) { return false; };
    };
    if (!raw_input) { return !stream::readerror(fp); };
    return true;
};

fn parsevalue(text: str) (numparse::ByteCount | ParseError) = {
    return numparse::bytecountsize(text);
};

fn startsplus(text: str) bool = {
    return text.len > 0usize && text.data[0usize] == 43u8;
};

fn invalidnumber(unit: str, text: str) void = {
    c::fprintf(c::stderr, "tail: invalid number of %s: ", unit);
    let mut shown: str = text;
    if (text.len > 0usize && text.data[0usize] == 45u8) { shown = text[1usize..text.len]; };
    stream::printquotedargument(c::stderr, shown);
    c::fputc(10, c::stderr);
};

fn invalidvalue(prefix: str, value: str) void = {
    c::fprintf(c::stderr, "%s", prefix);
    stream::printquotedargument(c::stderr, value);
    c::fputc(10, c::stderr);
};

fn followargumentending() void = {
    c::fprintf(c::stderr, " for ");
    stream::printquotedargument(c::stderr, "--follow");
    c::fprintf(c::stderr, "\nValid arguments are:\n  - ");
    stream::printquotedargument(c::stderr, "descriptor");
    c::fprintf(c::stderr, "\n  - ");
    stream::printquotedargument(c::stderr, "name");
    c::fprintf(c::stderr, "\nTry 'tail --help' for more information.\n");
};

fn badshort(opt: u8) void = {
    c::fprintf(c::stderr, "tail: invalid option -- '%c'\nTry 'tail --help' for more information.\n", opt as i32);
};

fn invalidcontext(opt: u8) void = {
    c::fprintf(c::stderr, "tail: option used in invalid context -- %c\n", opt as i32);
};

fn badlong(arg: str) void = {
    c::fprintf(c::stderr, "tail: unrecognized option '%s'\nTry 'tail --help' for more information.\n", arg);
};

fn badargument(option: str) void = {
    c::fprintf(c::stderr, "tail: option '%s' doesn't allow an argument\nTry 'tail --help' for more information.\n", option);
};

fn readerror(path: str) void = {
    c::fprintf(c::stderr, "tail: error reading ");
    stream::printquoted(c::stderr, path, false);
    c::fprintf(c::stderr, ": ");
    c::perror((0i64 as *i8));
};

fn longmatch(arg: str, option: str) bool = {
    return arg.len > 2usize && arg.len <= option.len && arg == option[0usize..arg.len];
};

fn triplematch(arg: str, option: str) bool = {
    return arg.len >= 3usize && arg.len <= option.len && arg == option[0usize..arg.len];
};

fn tripleambiguity(arg: str) bool = {
    if (triplematch(arg, "---disable-inotify") && triplematch(arg, "---presume-input-pipe")) {
        c::fprintf(c::stderr, "tail: option '%s' is ambiguous; possibilities: '---disable-inotify' '---presume-input-pipe'\nTry 'tail --help' for more information.\n", arg);
        return true;
    };
    return false;
};

fn longambiguity(arg: str) bool = {
    if (longmatch(arg, "--silent") && longmatch(arg, "--sleep-interval")) {
        c::fprintf(c::stderr, "tail: option '%s' is ambiguous; possibilities: '--silent' '--sleep-interval'\nTry 'tail --help' for more information.\n", arg);
        return true;
    };
    if (longmatch(arg, "--verbose") && longmatch(arg, "--version")) {
        c::fprintf(c::stderr, "tail: option '%s' is ambiguous; possibilities: '--verbose' '--version'\nTry 'tail --help' for more information.\n", arg);
        return true;
    };
    return false;
};

fn help() void = {
    io::print("Usage: tail [OPTION]... [FILE]...\n");
    io::print("Print the last 10 lines of each FILE to standard output.\n");
    io::print("With more than one FILE, precede each with a header giving the file name.\n\n");
    io::print("With no FILE, or when FILE is -, read standard input.\n\n");
    io::print("Mandatory arguments to long options are mandatory for short options too.\n");
    io::print("  -c, --bytes=[+]NUM\n");
    io::print("         output the last NUM bytes;\n");
    io::print("         or use -c +NUM to output starting with byte NUM of each file\n");
    io::print("      --debug\n");
    io::print("         indicate which --follow implementation is used\n");
    io::print("  -f, --follow[=");
    c::putchar(123);
    io::print("name|descriptor");
    io::print("}]\n");
    io::print("         output appended data as the file grows;\n");
    io::print("         an absent option argument means 'descriptor'\n");
    io::print("  -F\n");
    io::print("         same as --follow=name --retry\n");
    io::print("  -n, --lines=[+]NUM\n");
    io::print("         output the last NUM lines, instead of the last 10;\n");
    io::print("         or use -n +NUM to skip NUM-1 lines at the start\n");
    io::print("      --max-unchanged-stats=N\n");
    io::print("         with --follow=name, reopen a FILE which has not\n");
    io::print("         changed size after N (default 5) iterations\n");
    io::print("         to see if it has been unlinked or renamed\n");
    io::print("         (this is the usual case of rotated log files);\n");
    io::print("         with inotify, this option is rarely useful\n");
    io::print("      --pid=PID\n");
    io::print("         with -f, exit after PID no longer exists;\n");
    io::print("         can be repeated to watch multiple processes\n");
    io::print("  -q, --quiet, --silent\n");
    io::print("         never output headers giving file names\n");
    io::print("      --retry\n");
    io::print("         keep trying to open a file if it is inaccessible\n");
    io::print("  -s, --sleep-interval=N\n");
    io::print("         with -f, sleep for approximately N seconds\n");
    io::print("         (default 1.0) between iterations;\n");
    io::print("         with inotify and --pid=P,\n");
    io::print("         check process P at least once every N seconds\n");
    io::print("  -v, --verbose\n");
    io::print("         always output headers giving file names\n");
    io::print("  -z, --zero-terminated\n");
    io::print("         line delimiter is NUL, not newline\n");
    io::print("      --help\n");
    io::print("         display this help and exit\n");
    io::print("      --version\n");
    io::print("         output version information and exit\n\n");
    io::print("NUM may have a multiplier suffix:\n");
    io::print("b 512, kB 1000, K 1024, MB 1000*1000, M 1024*1024,\n");
    io::print("GB 1000*1000*1000, G 1024*1024*1024, and so on for T, P, E, Z, Y, R, Q.\n");
    io::print("Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n\n");
    io::print("With --follow (-f), tail defaults to following the file descriptor, which\n");
    io::print("means that even if a tail'ed file is renamed, tail will continue to track\n");
    io::print("its end.  This default behavior is not desirable when you really want to\n");
    io::print("track the actual name of the file, not the file descriptor (e.g., log\n");
    io::print("rotation).  Use --follow=name in that case.  That causes tail to track the\n");
    io::print("named file in a way that accommodates renaming, removal and creation.\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/tail>\n");
    io::print("or available locally via: info '(coreutils) tail invocation'\n");
};

fn printheader(path: str, index: usize, printed: &mut bool, last_index: &mut usize) void = {
    if (*printed) { io::println(""); };
    let mut label: str = path;
    if (path == "-") { label = "standard input"; };
    c::fprintf(c::stdout, "==> %s <==\n", label);
    *printed = true;
    *last_index = index;
};

fn printfollowheader(path: str, index: usize, printed: &mut bool, last_index: &mut usize) void = {
    if (*last_index != index) { printheader(path, index, printed, last_index); };
};

fn interval(text: str) (f64 | ParseError) = {
    if (text.len == 0usize) { return ParseError; };
    let start: *i8 = text.data as *i8;
    let mut end: *i8 = 0i64 as *i8;
    let seconds: f64 = libc::strtod(start, (&mut end) as *void);
    if (end == start || strc::strlen(end as *i8) != 0usize || !(seconds >= 0.0f64)) { return ParseError; };
    return seconds;
};

export fn run(start: usize, argc: usize) i32 = {
    let mut count: usize = 10usize;
    let mut plus: bool = false;
    let mut bytes: bool = false;
    let mut delim: u8 = 10u8;
    let mut quiet: bool = false;
    let mut verbose: bool = false;
    let mut follow: bool = false;
    let mut follow_name: bool = false;
    let mut retry: bool = false;
    let mut debug: bool = false;
    let mut disable_inotify: bool = false;
    let mut presume_input_pipe: bool = false;
    let mut interval_secs: f64 = 1.0f64;
    let mut pid_ignored: bool = false;
    let mut files = vec::new[str]();
    defer files.free();
    let mut follow_fps = vec::new[nullable *c::FILE]();
    defer follow_fps.free();
    let mut follow_owned = vec::new[bool]();
    defer follow_owned.free();
    let mut follow_paths = vec::new[str]();
    defer follow_paths.free();
    let mut pids = vec::new[i32]();
    defer pids.free();
    let mut operands: bool = false;
    let posixly_correct: bool = platform_env::zov_posixly_correct() != 0i32;
    let mut i: usize = start;
    while (i < argc) {
        let arg: str = env::argat(i);
        if (operands || arg == "-") { if (posixly_correct) { operands = true; }; files.push(arg); i += 1usize; continue; };
        if (arg == "--") { operands = true; i += 1usize; continue; };
        if (i == start && (arg == "+"
            || (arg.len == 2usize && arg.data[0usize] == 43u8 && (arg.data[1usize] == 98u8 || arg.data[1usize] == 99u8 || arg.data[1usize] == 108u8 || arg.data[1usize] == 102u8))
            || (arg.len == 3usize && arg.data[0usize] == 43u8 && arg.data[2usize] == 102u8 && (arg.data[1usize] == 98u8 || arg.data[1usize] == 99u8 || arg.data[1usize] == 108u8)))) {
            let mut legacy_ok: bool = true;
            let mut look: usize = i + 1usize;
            let mut ended_options: bool = false;
            let mut operands_after_legacy: usize = 0usize;
            while (look < argc) {
                let next: str = env::argat(look);
                if (!ended_options && next == "--") {
                    if (operands_after_legacy > 0usize) { legacy_ok = false; break; };
                    ended_options = true; look += 1usize; continue;
                };
                if (!ended_options && next.len > 1usize && next.data[0usize] == 45u8) { legacy_ok = false; break; };
                operands_after_legacy += 1usize;
                if (operands_after_legacy > 1usize) { legacy_ok = false; break; };
                look += 1usize;
            };
            if (legacy_ok) {
                plus = true; count = 10usize;
                if (arg.len == 2usize) {
                    bytes = arg.data[1usize] == 98u8 || arg.data[1usize] == 99u8;
                    if (arg.data[1usize] == 98u8) { count = 5120usize; };
                    if (arg.data[1usize] == 102u8) { follow = true; };
                } else if (arg.len == 3usize) {
                    follow = true;
                    bytes = arg.data[1usize] == 98u8 || arg.data[1usize] == 99u8;
                    if (arg.data[1usize] == 98u8) { count = 5120usize; };
                };
                i += 1usize; continue;
            };
        };
        if (arg.len > 1usize && arg.data[0usize] == 43u8 && arg.data[1usize] >= 48u8 && arg.data[1usize] <= 57u8) {
            let mut legacy_ok: bool = i == start;
            let mut look: usize = i + 1usize;
            let mut ended_options: bool = false;
            let mut operands_after_legacy: usize = 0usize;
            while (look < argc) {
                let next: str = env::argat(look);
                if (!ended_options && next == "--") {
                    if (operands_after_legacy > 0usize) { legacy_ok = false; break; };
                    ended_options = true; look += 1usize; continue;
                };
                if (!ended_options && next.len > 1usize && next.data[0usize] == 45u8) { legacy_ok = false; break; };
                operands_after_legacy += 1usize;
                if (operands_after_legacy > 1usize) { legacy_ok = false; break; };
                look += 1usize;
            };
            if (legacy_ok) {
            let raw_value: str = arg[1usize..arg.len];
            let mut digit_end: usize = 0usize;
            while (digit_end < raw_value.len && raw_value.data[digit_end] >= 48u8 && raw_value.data[digit_end] <= 57u8) { digit_end += 1usize; };
            let suffix: str = raw_value[digit_end..raw_value.len];
            if (suffix == "c" || suffix == "cf") { bytes = true; }
            else if (suffix == "b" || suffix == "bf") { bytes = true; }
            else if (suffix == "f" || suffix == "lf") { follow = true; }
            else if (suffix == "l") { }
            else if (suffix.len > 0usize) { legacy_ok = false; };
            if (suffix == "cf" || suffix == "bf") { follow = true; };
            if (legacy_ok) {
            let value_text: str = raw_value[0usize..digit_end];
            let mut blocks: bool = suffix == "b" || suffix == "bf";
            if (suffix == "c" || suffix == "l") { bytes = suffix == "c"; };
            let r = parsevalue(value_text);
            let value: numparse::ByteCount = match (r) { case let n: numparse::ByteCount => n, case ParseError => { if (bytes) { invalidnumber("bytes", value_text); } else { invalidnumber("lines", value_text); }; return 1; } };
            let mut magnitude: usize = value.magnitude;
            if (blocks) {
                if (magnitude > 36028797018963967usize) { invalidnumber("bytes", value_text); return 1; };
                magnitude *= 512usize;
            };
            plus = true; count = magnitude; i += 1usize; continue;
            };
            };
        };
        if (arg == "-q" || arg == "--quiet" || arg == "--silent") { quiet = true; verbose = false; i += 1usize; continue; };
        if (arg == "-v" || arg == "--verbose") { verbose = true; quiet = false; i += 1usize; continue; };
        if (arg == "-z" || arg == "--zero-terminated") { delim = 0u8; i += 1usize; continue; };
        if (arg == "-f" || arg == "--follow") { follow = true; i += 1usize; continue; };
        if (arg == "-F") { follow = true; follow_name = true; retry = true; i += 1usize; continue; };
        if (arg == "--retry") { retry = true; i += 1usize; continue; };
        if (arg.len > 2usize && arg[0usize..2usize] == "--") {
            let mut eqpos: usize = arg.len;
            for (let j in 2usize..arg.len) { if (arg.data[j] == 61u8) { eqpos = j; break; }; };
            let key: str = arg[0usize..eqpos];
            let has_equal: bool = eqpos < arg.len;
            if (tripleambiguity(key)) { return 1; };
            if (triplematch(key, "---disable-inotify")) {
                if (has_equal) { badargument("---disable-inotify"); return 1; };
                disable_inotify = true;
                i += 1usize; continue;
            };
            if (triplematch(key, "---presume-input-pipe")) {
                if (has_equal) { badargument("---presume-input-pipe"); return 1; };
                presume_input_pipe = true;
                i += 1usize; continue;
            };
            if (longambiguity(key)) { return 1; };
            if (longmatch(key, "--bytes") || longmatch(key, "--lines")) {
                bytes = longmatch(key, "--bytes");
                let mut value_text: str = "";
