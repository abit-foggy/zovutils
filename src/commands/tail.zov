use std::env;
use std::io;
use std::vec as vec;
use std::time as time;
use <stdio.h> as c;
use <stdlib.h> as libc;
use <string.h> as strc;
use <unistd.h> as u;
use <signal.h> as sig;
use shared::io as stream;
use shared::numbers as numparse;

fn spool(fp: *c::FILE, tmp: *c::FILE) bool = {
    let buf: [65536]u8;
    while (true) {
        let n: usize = stream::readbytes(fp, ((&buf[0usize]) as *u8), 65536usize);
        if (n == 0usize) { break; };
        if (!stream::writebytes(tmp, ((&buf[0usize]) as *u8), n)) { return false; };
    };
    return !stream::readerror(fp);
};

fn copyfrom(fp: *c::FILE, start: i64) bool = {
    if (c::fseek(fp, start, c::SEEK_SET) != 0) { return false; };
    let buf: [65536]u8;
    while (true) {
        let n: usize = stream::readbytes(fp, ((&buf[0usize]) as *u8), 65536usize);
        if (n == 0usize) { break; };
        if (!stream::writebytes(c::stdout, ((&buf[0usize]) as *u8), n)) { return false; };
    };
    return !stream::readerror(fp);
};

fn tailfrom(fp: *c::FILE, count: usize, bytes: bool, delim: u8) bool = {
    let raw: nullable *c::FILE = c::tmpfile();
    if (raw == null) { return false; };
    let tmp: *c::FILE = raw!;
    if (!spool(fp, tmp)) { c::fclose(tmp); return false; };
    if (c::fseek(tmp, 0i64, c::SEEK_END) != 0) { c::fclose(tmp); return false; };
    let size: i64 = c::ftell(tmp);
    if (size < 0i64) { c::fclose(tmp); return false; };
    let mut start: i64 = 0i64;
    if (count == 0usize) {
        start = size;
    } else if (bytes) {
        if (count == 0usize) { start = size; }
        else if (count < size as usize) { start = size - count as i64; };
    } else if (size > 0i64) {
        let mut pos: i64 = size;
        if (c::fseek(tmp, size - 1i64, c::SEEK_SET) == 0 && c::fgetc(tmp) == delim as i32) { pos = size - 1i64; };
        let mut found: usize = 0usize;
        while (pos > 0i64 && found < count) {
            pos -= 1i64;
            if (c::fseek(tmp, pos, c::SEEK_SET) != 0) { c::fclose(tmp); return false; };
            if (c::fgetc(tmp) == delim as i32) { found += 1usize; start = pos + 1i64; };
        };
        if (found < count) { start = 0i64; };
    };
    let ok: bool = copyfrom(tmp, start);
    c::fclose(tmp);
    return ok;
};

fn tailplus(fp: *c::FILE, count: usize, bytes: bool, delim: u8) bool = {
    let buf: [65536]u8;
    let mut remain: usize = 0usize;
    if (count > 0usize) { remain = count - 1usize; };
    let mut output: bool = remain == 0usize;
    while (true) {
        let n: usize = stream::readbytes(fp, ((&buf[0usize]) as *u8), 65536usize);
        if (n == 0usize) { break; };
        let mut begin: usize = 0usize;
        if (!output) {
            let mut i: usize = 0usize;
            while (i < n) {
                if (bytes) {
                    if (remain == 0usize) { begin = i; output = true; break; };
                    remain -= 1usize;
                } else if (buf[i] == delim) {
                    remain -= 1usize;
                    if (remain == 0usize) { begin = i + 1usize; output = true; break; };
                };
                i += 1usize;
            };
        };
        if (output && begin < n && !stream::writebytes(c::stdout, ((&buf[begin]) as *u8), n - begin)) { return false; };
    };
    return !stream::readerror(fp);
};

fn parsevalue(text: str) (numparse::ByteCount | ParseError) = {
    return numparse::bytecountsize(text);
};

fn startsplus(text: str) bool = {
    return text.len > 0usize && text.data[0usize] == 43u8;
};

fn invalidnumber(unit: str, text: str) void = {
    c::fprintf(c::stderr, "tail: invalid number of %s: '%s'\n", unit, text);
};

fn badshort(opt: u8) void = {
    c::fprintf(c::stderr, "tail: invalid option -- '%c'\nTry 'tail --help' for more information.\n", opt as i32);
};

fn badlong(arg: str) void = {
    c::fprintf(c::stderr, "tail: unrecognized option '%s'\nTry 'tail --help' for more information.\n", arg);
};

fn badargument(option: str) void = {
    c::fprintf(c::stderr, "tail: option '%s' doesn't allow an argument\nTry 'tail --help' for more information.\n", option);
};

fn longmatch(arg: str, option: str) bool = {
    return arg.len > 2usize && arg.len <= option.len && arg == option[0usize..arg.len];
};

fn longambiguity(arg: str) bool = {
    if (longmatch(arg, "--silent") && longmatch(arg, "--sleep-interval")) {
        c::fprintf(c::stderr, "tail: option '%s' is ambiguous; possibilities: '--silent' '--sleep-interval'\nTry 'tail --help' for more information.\n", arg);
        return true;
    };
    if (longmatch(arg, "--verbose") && longmatch(arg, "--version")) {
        c::fprintf(c::stderr, "tail: option '%s' is ambiguous; possibilities: '--verbose' '--version'\nTry 'tail --help' for more information.\n", arg);
        return true;
    };
    return false;
};

fn help() void = {
    io::print("Usage: tail [OPTION]... [FILE]...\n");
    io::print("Print the last 10 lines of each FILE to standard output.\n");
    io::print("With more than one FILE, precede each with a header giving the file name.\n\n");
    io::print("With no FILE, or when FILE is -, read standard input.\n\n");
    io::print("Mandatory arguments to long options are mandatory for short options too.\n");
    io::print("  -c, --bytes=[+]NUM\n");
    io::print("         output the last NUM bytes;\n");
    io::print("         or use -c +NUM to output starting with byte NUM of each file\n");
    io::print("      --debug\n");
    io::print("         indicate which --follow implementation is used\n");
    io::print("  -f, --follow[=");
    c::putchar(123);
    io::print("name|descriptor");
    io::print("}]\n");
    io::print("         output appended data as the file grows;\n");
    io::print("         an absent option argument means 'descriptor'\n");
    io::print("  -F\n");
    io::print("         same as --follow=name --retry\n");
    io::print("  -n, --lines=[+]NUM\n");
    io::print("         output the last NUM lines, instead of the last 10;\n");
    io::print("         or use -n +NUM to skip NUM-1 lines at the start\n");
    io::print("      --max-unchanged-stats=N\n");
    io::print("         with --follow=name, reopen a FILE which has not\n");
    io::print("         changed size after N (default 5) iterations\n");
    io::print("         to see if it has been unlinked or renamed\n");
    io::print("         (this is the usual case of rotated log files);\n");
    io::print("         with inotify, this option is rarely useful\n");
    io::print("      --pid=PID\n");
    io::print("         with -f, exit after PID no longer exists;\n");
    io::print("         can be repeated to watch multiple processes\n");
    io::print("  -q, --quiet, --silent\n");
    io::print("         never output headers giving file names\n");
    io::print("      --retry\n");
    io::print("         keep trying to open a file if it is inaccessible\n");
    io::print("  -s, --sleep-interval=N\n");
    io::print("         with -f, sleep for approximately N seconds\n");
    io::print("         (default 1.0) between iterations;\n");
    io::print("         with inotify and --pid=P,\n");
    io::print("         check process P at least once every N seconds\n");
    io::print("  -v, --verbose\n");
    io::print("         always output headers giving file names\n");
    io::print("  -z, --zero-terminated\n");
    io::print("         line delimiter is NUL, not newline\n");
    io::print("      --help\n");
    io::print("         display this help and exit\n");
    io::print("      --version\n");
    io::print("         output version information and exit\n\n");
    io::print("NUM may have a multiplier suffix:\n");
    io::print("b 512, kB 1000, K 1024, MB 1000*1000, M 1024*1024,\n");
    io::print("GB 1000*1000*1000, G 1024*1024*1024, and so on for T, P, E, Z, Y, R, Q.\n");
    io::print("Binary prefixes can be used, too: KiB=K, MiB=M, and so on.\n\n");
    io::print("With --follow (-f), tail defaults to following the file descriptor, which\n");
    io::print("means that even if a tail'ed file is renamed, tail will continue to track\n");
    io::print("its end.  This default behavior is not desirable when you really want to\n");
    io::print("track the actual name of the file, not the file descriptor (e.g., log\n");
    io::print("rotation).  Use --follow=name in that case.  That causes tail to track the\n");
    io::print("named file in a way that accommodates renaming, removal and creation.\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/tail>\n");
    io::print("or available locally via: info '(coreutils) tail invocation'\n");
};

fn interval(text: str) (f64 | ParseError) = {
    if (text.len == 0usize) { return ParseError; };
    let start: *i8 = text.data as *i8;
    let mut end: *i8 = 0i64 as *i8;
    let seconds: f64 = libc::strtod(start, (&mut end) as *void);
    if (end == start || strc::strlen(end as *i8) != 0usize || !(seconds >= 0.0f64)) { return ParseError; };
    return seconds;
};

export fn run(start: usize, argc: usize) i32 = {
    let mut count: usize = 10usize;
    let mut plus: bool = false;
    let mut bytes: bool = false;
    let mut delim: u8 = 10u8;
    let mut quiet: bool = false;
    let mut verbose: bool = false;
    let mut follow: bool = false;
    let mut follow_name: bool = false;
    let mut retry: bool = false;
    let mut debug: bool = false;
    let mut interval_secs: f64 = 1.0f64;
    let mut pid_ignored: bool = false;
    let mut files = vec::new[str]();
    defer files.free();
    let mut follow_fps = vec::new[nullable *c::FILE]();
    defer follow_fps.free();
    let mut follow_owned = vec::new[bool]();
    defer follow_owned.free();
    let mut follow_paths = vec::new[str]();
    defer follow_paths.free();
    let mut pids = vec::new[i32]();
    defer pids.free();
    let mut operands: bool = false;
    let mut i: usize = start;
    while (i < argc) {
        let arg: str = env::argat(i);
        if (operands || arg == "-") { files.push(arg); i += 1usize; continue; };
        if (arg == "--") { operands = true; i += 1usize; continue; };
        if (arg == "-q" || arg == "--quiet" || arg == "--silent") { quiet = true; i += 1usize; continue; };
        if (arg == "-v" || arg == "--verbose") { verbose = true; i += 1usize; continue; };
        if (arg == "-z" || arg == "--zero-terminated") { delim = 0u8; i += 1usize; continue; };
        if (arg == "-f" || arg == "--follow") { follow = true; i += 1usize; continue; };
        if (arg == "-F") { follow = true; follow_name = true; retry = true; i += 1usize; continue; };
        if (arg == "--retry") { retry = true; i += 1usize; continue; };
        if (arg.len > 2usize && arg[0usize..2usize] == "--") {
            let mut eqpos: usize = arg.len;
            for (let j in 2usize..arg.len) { if (arg.data[j] == 61u8) { eqpos = j; break; }; };
            let key: str = arg[0usize..eqpos];
            let has_equal: bool = eqpos < arg.len;
            if (longambiguity(key)) { return 1; };
            if (longmatch(key, "--bytes") || longmatch(key, "--lines")) {
                bytes = longmatch(key, "--bytes");
                let mut value_text: str = "";
                if (has_equal) { value_text = arg[eqpos + 1usize..arg.len]; }
                else if (i + 1usize < argc) { value_text = env::argat(i + 1usize); }
                else {
                    let mut canonical: str = "--lines";
                    if (bytes) { canonical = "--bytes"; };
                    c::fprintf(c::stderr, "tail: option '%s' requires an argument\nTry 'tail --help' for more information.\n", canonical);
                    return 1;
                };
                let r = parsevalue(value_text);
                let value: numparse::ByteCount = match (r) { case let n: numparse::ByteCount => n, case ParseError => { if (bytes) { invalidnumber("bytes", value_text); } else { invalidnumber("lines", value_text); }; return 1; } };
                plus = startsplus(value_text); count = value.magnitude;
                if (!has_equal) { i += 1usize; };
                i += 1usize; continue;
            };
            if (longmatch(key, "--follow")) {
                follow = true;
                if (has_equal) {
                    let mode: str = arg[eqpos + 1usize..arg.len];
                    if (mode == "name") { follow_name = true; }
                    else if (mode == "descriptor") { follow_name = false; }
                    else if (mode.len == 0usize) { c::fprintf(c::stderr, "tail: ambiguous argument '' for '--follow'\nValid arguments are:\n  - 'descriptor'\n  - 'name'\nTry 'tail --help' for more information.\n"); return 1; }
                    else { c::fprintf(c::stderr, "tail: invalid argument '%s' for '--follow'\nValid arguments are:\n  - 'descriptor'\n  - 'name'\nTry 'tail --help' for more information.\n", mode); return 1; };
                };
                i += 1usize; continue;
            };
            if (longmatch(key, "--pid")) {
                let mut value_text: str = "";
                if (has_equal) { value_text = arg[eqpos + 1usize..arg.len]; }
                else if (i + 1usize < argc) { value_text = env::argat(i + 1usize); }
                else { c::fprintf(c::stderr, "tail: option '--pid' requires an argument\nTry 'tail --help' for more information.\n"); return 1; };
                let n: i64 = match (numparse::signednumber(value_text)) { case let v: i64 => v, case ParseError => { c::fprintf(c::stderr, "tail: invalid PID: '%s'\n", value_text); return 1; } };
                if (n < 0i64 || n > 2147483647i64) { c::fprintf(c::stderr, "tail: invalid PID: '%s'\n", value_text); return 1; };
                if (n > 0i64) { pids.push(n as i32); } else { pid_ignored = true; };
                if (!has_equal) { i += 1usize; };
                i += 1usize; continue;
            };
            if (longmatch(key, "--sleep-interval")) {
                let mut value_text: str = "";
                if (has_equal) { value_text = arg[eqpos + 1usize..arg.len]; }
                else if (i + 1usize < argc) { value_text = env::argat(i + 1usize); }
                else { c::fprintf(c::stderr, "tail: option '--sleep-interval' requires an argument\nTry 'tail --help' for more information.\n"); return 1; };
                interval_secs = match (interval(value_text)) { case let v: f64 => v, case ParseError => { c::fprintf(c::stderr, "tail: invalid number of seconds: '%s'\n", value_text); return 1; } };
                if (!has_equal) { i += 1usize; };
                i += 1usize; continue;
            };
            if (longmatch(key, "--max-unchanged-stats")) {
                let mut value_text: str = "";
                if (has_equal) { value_text = arg[eqpos + 1usize..arg.len]; }
                else if (i + 1usize < argc) { value_text = env::argat(i + 1usize); }
                else { c::fprintf(c::stderr, "tail: invalid maximum number of unchanged stats between opens: ''\n"); return 1; };
                let _value = match (numparse::number(value_text)) { case let v: usize => v, case ParseError => { c::fprintf(c::stderr, "tail: invalid maximum number of unchanged stats between opens: '%s'\n", value_text); return 1; } };
                if (!has_equal) { i += 1usize; };
                i += 1usize; continue;
            };
            if (longmatch(key, "--quiet") || longmatch(key, "--silent")) {
                if (has_equal) { badargument("--quiet"); return 1; };
                quiet = true; i += 1usize; continue;
            };
            if (longmatch(key, "--verbose")) {
                if (has_equal) { badargument("--verbose"); return 1; };
                verbose = true; i += 1usize; continue;
            };
            if (longmatch(key, "--zero-terminated")) {
                if (has_equal) { badargument("--zero-terminated"); return 1; };
                delim = 0u8; i += 1usize; continue;
            };
            if (longmatch(key, "--retry")) {
                if (has_equal) { badargument("--retry"); return 1; };
                retry = true; i += 1usize; continue;
            };
            if (longmatch(key, "--debug")) {
                if (has_equal) { badargument("--debug"); return 1; };
                debug = true; i += 1usize; continue;
            };
            if (longmatch(key, "--help")) {
                if (has_equal) { badargument("--help"); return 1; };
                help(); if (!stream::finishoutput("tail")) { return 1; }; return 0;
            };
            if (longmatch(key, "--version")) {
                if (has_equal) { badargument("--version"); return 1; };
                io::println("tail (zovutils) 0.1.4"); if (!stream::finishoutput("tail")) { return 1; }; return 0;
            };
            badlong(arg); return 1;
        };
        if (arg == "-s") {
            if (i + 1usize >= argc) { c::fprintf(c::stderr, "tail: option requires an argument -- 's'\nTry 'tail --help' for more information.\n"); return 1; };
            interval_secs = match (interval(env::argat(i + 1usize))) { case let v: f64 => v, case ParseError => { c::fprintf(c::stderr, "tail: invalid number of seconds: '%s'\n", env::argat(i + 1usize)); return 1; } };
            i += 2usize; continue;
        };
        if (arg == "-n" || arg == "--lines" || arg == "-c" || arg == "--bytes") {
            if (i + 1usize >= argc) {
                if (arg == "-n") { c::fprintf(c::stderr, "tail: option requires an argument -- 'n'\nTry 'tail --help' for more information.\n"); }
                else if (arg == "-c") { c::fprintf(c::stderr, "tail: option requires an argument -- 'c'\nTry 'tail --help' for more information.\n"); }
                else { c::fprintf(c::stderr, "tail: option '%s' requires an argument\nTry 'tail --help' for more information.\n", arg); };
                return 1;
            };
            bytes = (arg == "-c" || arg == "--bytes");
            let r = parsevalue(env::argat(i + 1usize));
            let value: numparse::ByteCount = match (r) { case let n: numparse::ByteCount => n, case ParseError => { if (bytes) { invalidnumber("bytes", env::argat(i + 1usize)); } else { invalidnumber("lines", env::argat(i + 1usize)); }; return 1; } };
            plus = startsplus(env::argat(i + 1usize));
            count = value.magnitude;
            i += 2usize; continue;
        };
        if (arg.len > 2usize && arg.data[0usize] == 45u8 && arg.data[1usize] == 110u8) {
            let r = parsevalue(arg[2usize..arg.len]);
            let value: numparse::ByteCount = match (r) { case let n: numparse::ByteCount => n, case ParseError => { invalidnumber("lines", arg[2usize..arg.len]); return 1; } };
            plus = startsplus(arg[2usize..arg.len]); count = value.magnitude; bytes = false; i += 1usize; continue;
        };
        if (arg.len > 2usize && arg.data[0usize] == 45u8 && arg.data[1usize] == 99u8) {
            let r = parsevalue(arg[2usize..arg.len]);
            let value: numparse::ByteCount = match (r) { case let n: numparse::ByteCount => n, case ParseError => { invalidnumber("bytes", arg[2usize..arg.len]); return 1; } };
            plus = startsplus(arg[2usize..arg.len]); count = value.magnitude; bytes = true; i += 1usize; continue;
        };
        if (arg.len > 1usize && arg.data[0usize] == 45u8 && arg.data[1usize] >= 48u8 && arg.data[1usize] <= 57u8) {
            let r = parsevalue(arg[1usize..arg.len]);
            let value: numparse::ByteCount = match (r) { case let n: numparse::ByteCount => n, case ParseError => { invalidnumber("lines", arg[1usize..arg.len]); return 1; } };
            plus = startsplus(arg[1usize..arg.len]); count = value.magnitude; bytes = false; i += 1usize; continue;
        };
        if (arg.len > 1usize && arg.data[0usize] == 45u8 && arg.data[1usize] != 45u8) {
            let mut j: usize = 1usize;
            let mut advance: usize = 1usize;
            while (j < arg.len) {
                let ch: u8 = arg.data[j];
                if (ch == 113u8) { quiet = true; }
                else if (ch == 118u8) { verbose = true; }
                else if (ch == 122u8) { delim = 0u8; }
                else if (ch == 102u8) { follow = true; }
                else if (ch == 70u8) { follow = true; follow_name = true; retry = true; }
                else if (ch == 110u8 || ch == 99u8) {
                    bytes = ch == 99u8;
                    let mut value_text: str = "";
                    if (j + 1usize < arg.len) { value_text = arg[j + 1usize..arg.len]; }
                    else if (i + 1usize < argc) { value_text = env::argat(i + 1usize); advance = 2usize; }
                    else {
                        if (ch == 110u8) { c::fprintf(c::stderr, "tail: option requires an argument -- 'n'\nTry 'tail --help' for more information.\n"); }
                        else { c::fprintf(c::stderr, "tail: option requires an argument -- 'c'\nTry 'tail --help' for more information.\n"); };
                        return 1;
                    };
                    let r = parsevalue(value_text);
                    let value: numparse::ByteCount = match (r) { case let n: numparse::ByteCount => n, case ParseError => { if (bytes) { invalidnumber("bytes", value_text); } else { invalidnumber("lines", value_text); }; return 1; } };
                    plus = startsplus(value_text); count = value.magnitude; j = arg.len;
                } else if (ch == 115u8) {
                    let mut value_text: str = "";
                    if (j + 1usize < arg.len) { value_text = arg[j + 1usize..arg.len]; }
                    else if (i + 1usize < argc) { value_text = env::argat(i + 1usize); advance = 2usize; }
                    else { c::fprintf(c::stderr, "tail: option requires an argument -- 's'\nTry 'tail --help' for more information.\n"); return 1; };
                    interval_secs = match (interval(value_text)) { case let v: f64 => v, case ParseError => { c::fprintf(c::stderr, "tail: invalid number of seconds: '%s'\n", value_text); return 1; } };
                    j = arg.len;
                } else { badshort(ch); return 1; };
                if (j < arg.len) { j += 1usize; };
            };
            i += advance; continue;
        };
        if (arg.data[0usize] == 45u8) { badlong(arg); return 1; };
        files.push(arg); i += 1usize;
    };
    if (pid_ignored && !follow) { c::fprintf(c::stderr, "tail: warning: PID ignored; --pid=PID is useful only when following\n"); };
    if (retry && !follow) { c::fprintf(c::stderr, "tail: warning: --retry ignored; --retry is useful only when following\n"); };
    if (files.len() == 0usize) { files.push("-"); };
    if (debug && follow) { c::fprintf(c::stderr, "tail: using polling method\n"); };
    let headers: bool = verbose || (!quiet && files.len() > 1usize);
    let mut status: i32 = 0;
    let mut printed: bool = false;
    for (let k in 0..files.len()) {
        let path: str = files.get(k);
        let mut fp: *c::FILE = c::stdin;
        let mut owned: bool = false;
        if (path != "-") {
            let raw: nullable *c::FILE = stream::openread(path);
            if (raw == null) {
                stream::erroropen("tail", path); status = 1;
                if (follow && retry) { follow_fps.push(null); follow_owned.push(false); follow_paths.push(path); };
                continue;
            };
            fp = raw!; owned = true;
        };
        if (headers) {
            if (printed) { io::println(""); };
            let mut label: str = path;
            if (path == "-") { label = "standard input"; };
            c::fprintf(c::stdout, "==> %s <==\n", label); printed = true;
        };
        let mut ok: bool = false;
        if (plus) { ok = tailplus(fp, count, bytes, delim); }
        else { ok = tailfrom(fp, count, bytes, delim); };
        if (!ok) {
            if (!stream::outputfailed()) { stream::errorprefix("tail", path); };
            status = 1;
        };
        if (stream::outputfailed()) {
            if (owned) { stream::closefile(fp); };
            break;
        };
        if (follow) {
            let follow_fp: nullable *c::FILE = fp;
            follow_fps.push(follow_fp); follow_owned.push(owned); follow_paths.push(path);
        } else if (owned && !stream::closefile(fp)) { stream::errorprefix("tail", path); status = 1; };
    };
    let mut follow_write_failed: bool = false;
    if (follow) {
        if (follow_fps.len() == 0usize) {
            c::fprintf(c::stderr, "tail: no files remaining\n");
            if (!stream::finishoutput("tail")) { status = 1; };
            return 1;
        };
        if (!stream::finishoutput("tail")) { status = 1; follow_write_failed = true; };
        let buf: [65536]u8;
        while (!follow_write_failed) {
            for (let k in 0..follow_fps.len()) {
                let path: str = follow_paths.get(k);
                let rawfp: nullable *c::FILE = follow_fps.get(k);
                if (rawfp == null) {
                    let raw: nullable *c::FILE = stream::openread(path);
                    if (raw != null) {
                        let next: *c::FILE = raw!;
                        c::fprintf(c::stderr, "tail: "); stream::printquoted(c::stderr, path, true);
                        c::fprintf(c::stderr, " has appeared;  following new file\n");
                        while (true) {
                            let n: usize = stream::readbytes(next, ((&buf[0usize]) as *u8), 65536usize);
                            if (n == 0usize) { break; };
                            if (!stream::writebytes(c::stdout, ((&buf[0usize]) as *u8), n)) { follow_write_failed = true; status = 1; break; };
                        };
                        if (!follow_write_failed && !stream::finishoutput("tail")) { follow_write_failed = true; status = 1; };
                        let next_follow: nullable *c::FILE = next;
                        follow_fps.set(k, next_follow); follow_owned.set(k, true);
                    };
                    continue;
                };
                let mut fp: *c::FILE = rawfp!;
                if (follow_name && path != "-") {
                    let pos: i64 = c::ftell(fp);
                    let raw: nullable *c::FILE = stream::openread(path);
                    if (raw != null) {
                        let next: *c::FILE = raw!;
                        c::fseek(next, 0i64, c::SEEK_END);
                        let end: i64 = c::ftell(next);
                        let mut begin: i64 = pos;
                        let replaced: bool = !stream::samefile(fp, path);
                        if (end < begin || replaced) { begin = 0i64; };
                        if (replaced) {
                            c::fprintf(c::stderr, "tail: "); stream::printquoted(c::stderr, path, true);
                            c::fprintf(c::stderr, " has been replaced;  following new file\n");
                        };
                        if (end > begin && c::fseek(next, begin, c::SEEK_SET) == 0) {
                            while (true) {
                                let n: usize = stream::readbytes(next, ((&buf[0usize]) as *u8), 65536usize);
                                if (n == 0usize) { break; };
                                if (!stream::writebytes(c::stdout, ((&buf[0usize]) as *u8), n)) { follow_write_failed = true; status = 1; break; };
                            };
                            if (!follow_write_failed && !stream::finishoutput("tail")) { follow_write_failed = true; status = 1; };
                        } else { c::fseek(next, end, c::SEEK_SET); };
                        if (follow_owned.get(k)) { stream::closefile(fp); };
                        let next_follow: nullable *c::FILE = next;
                        follow_fps.set(k, next_follow);
                        follow_owned.set(k, true);
                    } else if (retry) { }
                    else { };
                } else {
                    let n: usize = stream::readbytes(fp, ((&buf[0usize]) as *u8), 65536usize);
                    if (n > 0usize) {
                        stream::writebytes(c::stdout, ((&buf[0usize]) as *u8), n);
                        if (!stream::finishoutput("tail")) { follow_write_failed = true; status = 1; break; };
                    }
                    else { c::clearerr(fp); };
                };
            };
            if (follow_write_failed) { break; };
            let mut alive: bool = pids.len() == 0usize;
            for (let k in 0..pids.len()) { if (sig::kill(pids.get(k), 0) == 0) { alive = true; }; };
            if (!alive) { break; };
            time::sleep(interval_secs);
        };
        for (let k in 0..follow_fps.len()) {
            let fp: nullable *c::FILE = follow_fps.get(k);
            if (fp != null && follow_owned.get(k)) { stream::closefile(fp!); };
        };
    };
    if (!follow || !follow_write_failed) { if (!stream::finishoutput("tail")) { status = 1; }; };
    return status;
};
