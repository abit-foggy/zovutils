use std::env as args;
use std::io;
use <stdio.h> as c;
use <unistd.h> as posix;
use shared::io as stream;

fn help() void = {
    io::print("Usage: tty [OPTION]...\n");
    io::print("Print the file name of the terminal connected to standard input.\n\n");
    io::print("  -s, --silent, --quiet  print nothing, only return an exit status\n");
    io::print("      --help             display this help and exit\n");
    io::print("      --version          output version information and exit\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/tty>\n");
    io::print("or available locally via: info '(coreutils) tty invocation'\n");
};

export fn run(start: usize, argc: usize) i32 = {
    let mut silent: bool = false;
    let mut i: usize = start;
    while (i < argc) {
        let a: str = args::argat(i);
        if (a == "--help") {
            help();
            stream::finishoutput("tty");
            return 0;
        };
        if (a == "--version") {
            io::println("tty (zovutils) 0.10.61");
            stream::finishoutput("tty");
            return 0;
        };
        if (a == "-s" || a == "--silent" || a == "--quiet") {
            silent = true;
            i += 1usize;
            continue;
        };
        if (a.len > 0usize && a.data[0usize] == 45u8) {
            if (a.len > 1usize && a.data[1usize] == 45u8) {
                c::fprintf(c::stderr, "tty: unrecognized option '%s'\nTry 'tty --help' for more information.\n", a.data as *i8);
            } else {
                let mut ch: u8 = 45u8;
                if (a.len > 1usize) { ch = a.data[1usize]; };
                c::fprintf(c::stderr, "tty: invalid option -- '%c'\nTry 'tty --help' for more information.\n", ch as i32);
            };
            return 2;
        };
        c::fprintf(c::stderr, "tty: extra operand '%s'\nTry 'tty --help' for more information.\n", a.data as *i8);
        return 2;
    };

    if (posix::isatty(0i32) != 0i32) {
        if (!silent) {
            let p: nullable *i8 = posix::ttyname(0i32);
            match (p) {
                case let name: *i8 => {
                    c::puts(name);
                },
                case null => {
                    io::println("not a tty");
                    return 1;
                },
            };
        };
        return 0;
    };
    if (!silent) {
        io::println("not a tty");
    };
    return 1;
};
