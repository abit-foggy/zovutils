use std::env as args;
use std::io;
use std::mem as mem;
use <ctype.h> as ct;
use <stdio.h> as c;
use <string.h> as strc;
use <platform_errno.h> as platform_errno;
use <platform_locale.h> as platform_locale;
use shared::io as stream;

fn usage_error() void = { io::eprintln("Try 'uniq --help' for more information."); };

fn longkey(arg: str) str = {
    for (let i in 0usize..arg.len) { if (arg.data[i] == 61u8) { return arg[0usize..i]; }; };
    return arg;
};

fn is_prefix(value: str, full: str) bool = {
    return value.len > 2usize && value.len <= full.len && value == full[0usize..value.len];
};

fn parse_count(value: str, out: &mut usize) bool = {
    if (value.len == 0usize) { return false; };
    let mut start: usize = 0usize;
    while (start < value.len && (value.data[start] == 32u8 || (value.data[start] >= 9u8 && value.data[start] <= 13u8))) {
        start += 1usize;
    };
    if (start < value.len && value.data[start] == 43u8) {
        start += 1usize;
    };
    if (start >= value.len) { return false; };
    let mut n: usize = 0usize;
    for (let i in start..value.len) {
        let b: u8 = value.data[i];
        if (b < 48u8 || b > 57u8) { return false; };
        let digit: usize = (b - 48u8) as usize;
        let max_val: usize = 18446744073709551615usize;
        if (n > (max_val - digit) / 10usize) { return false; };
        n = n * 10usize + digit;
    };
    *out = n;
    return true;
};

fn help() void = {
    io::print("Usage: uniq [OPTION]... [INPUT [OUTPUT]]\n");
    io::print("Filter adjacent matching lines from INPUT (or standard input),\nwriting to OUTPUT (or standard output).\n\n");
    io::print("With no options, matching lines are merged to the first occurrence.\n\n");
    io::print("Mandatory arguments to long options are mandatory for short options too.\n");
    io::print("  -c, --count\n         prefix lines by the number of occurrences\n");
    io::print("  -d, --repeated\n         only print duplicate lines, one for each group\n");
    io::print("  -D\n         print all duplicate lines\n");
    io::print("      --all-repeated[=METHOD]\n         like -D, but allow separating groups with an empty line;\n         METHOD=");
    c::fputc(123i32, c::stdout); io::print("none(default),prepend,separate"); c::fputc(125i32, c::stdout); io::print("\n");
    io::print("  -f, --skip-fields=N\n         avoid comparing the first N fields\n");
    io::print("      --group[=METHOD]\n         show all items, separating groups with an empty line;\n         METHOD=");
    c::fputc(123i32, c::stdout); io::print("separate(default),prepend,append,both"); c::fputc(125i32, c::stdout); io::print("\n");
    io::print("  -i, --ignore-case\n         ignore differences in case when comparing\n");
    io::print("  -s, --skip-chars=N\n         avoid comparing the first N characters\n");
    io::print("  -u, --unique\n         only print unique lines\n");
    io::print("  -z, --zero-terminated\n         line delimiter is NUL, not newline\n");
    io::print("  -w, --check-chars=N\n         compare no more than N characters in lines\n");
    io::print("      --help\n         display this help and exit\n");
    io::print("      --version\n         output version information and exit\n\n");
    io::print("A field is a run of blanks (usually spaces and/or TABs), then non-blank\ncharacters.  Fields are skipped before chars.\n\n");
    io::print("'uniq' does not detect repeated lines unless they are adjacent.\n");
    io::print("You may want to sort the input first, or use 'sort -u' without 'uniq'.\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/uniq>\n");
    io::print("or available locally via: info '(coreutils) uniq invocation'\n");
};

type UniqLine = struct {
    data: *u8,
    len: usize,
    cap: usize,
};

fn line_init() UniqLine = {
    return UniqLine { data = mem::alloc[u8](256usize), len = 0usize, cap = 256usize };
};

fn line_copy(dest: &mut UniqLine, src: &UniqLine) void = {
    while (dest.cap < src.len) {
        let new_cap: usize = dest.cap * 2usize;
        dest.data = mem::reallocbuf[u8](dest.data, new_cap);
        dest.cap = new_cap;
    };
    for (let i in 0usize..src.len) {
        dest.data[i] = src.data[i];
    };
    dest.len = src.len;
};

fn read_line(fp: *c::FILE, term: u8, line: &mut UniqLine) i32 = {
    line.len = 0usize;
    while (true) {
        let ch: i32 = c::fgetc(fp);
        if (ch == -1i32) {
            if (stream::readerror(fp)) { return -1i32; };
            if (line.len == 0usize) { return 0i32; };
            return 1i32;
        };
        if ((ch as u8) == term) {
            return 1i32;
        };
        if (line.len == line.cap) {
            let next: usize = line.cap * 2usize;
            line.data = mem::reallocbuf[u8](line.data, next);
            line.cap = next;
        };
        line.data[line.len] = ch as u8;
        line.len += 1usize;
    };
    return 0i32;
};

fn get_offset(line: &UniqLine, fields: usize, chars: usize) usize = {
    let mut i: usize = 0usize;
    let mut f: usize = fields;
    while (f > 0usize) {
        while (i < line.len && (line.data[i] == 32u8 || line.data[i] == 9u8)) { i += 1usize; };
        while (i < line.len && line.data[i] != 32u8 && line.data[i] != 9u8) { i += 1usize; };
        f -= 1usize;
    };
    let remain: usize = line.len - i;
    let mut skip: usize = remain;
    if (chars < remain) { skip = chars; };
    return i + skip;
};

fn lines_equal(a: &UniqLine, b: &UniqLine, ignore_case: bool,
               skip_fields: usize, skip_chars: usize, check_chars: usize) bool = {
    let ai: usize = get_offset(a, skip_fields, skip_chars);
    let bi: usize = get_offset(b, skip_fields, skip_chars);
    let mut an: usize = a.len - ai;
    let mut bn: usize = b.len - bi;
    if (check_chars != 0usize && check_chars < an) { an = check_chars; };
    if (check_chars != 0usize && check_chars < bn) { bn = check_chars; };
    let mut n: usize = an;
    if (bn < n) { n = bn; };
    for (let i in 0usize..n) {
        let mut ac: u8 = a.data[ai + i];
        let mut bc: u8 = b.data[bi + i];
        if (ignore_case) {
            ac = ct::tolower(ac as i32) as u8;
            bc = ct::tolower(bc as i32) as u8;
        };
        if (ac != bc) { return false; };
    };
    return an == bn;
};

fn emit_line(out: *c::FILE, line: &UniqLine, term: u8, count: usize, count_mode: bool) bool = {
    if (count_mode) {
        if (c::fprintf(out, "%7zu ", count) < 0i32) { return false; };
    };
    if (line.len > 0usize && !stream::writebytes(out, line.data, line.len)) { return false; };
    return stream::putbyte(out, term);
};

fn emit_group(out: *c::FILE, term: u8, line: &UniqLine, count: usize,
              count_mode: bool, duplicates: bool, only_unique: bool) bool = {
    let mut emit: bool = false;
    if (duplicates && only_unique) {
        emit = false;
    } else if (duplicates) {
        emit = count > 1usize;
    } else if (only_unique) {
        emit = count == 1usize;
    } else {
        emit = true;
    };
    if (!emit) { return true; };
    return emit_line(out, line, term, count, count_mode);
};

export fn run(start: usize, argc: usize) i32 = {
    let mut count_mode: bool = false;
    let mut duplicates: bool = false;
    let mut only_unique: bool = false;
    let mut all_repeated: bool = false;
    let mut ignore_case: bool = false;
    let mut skip_fields: usize = 0usize;
    let mut skip_chars: usize = 0usize;
    let mut check_chars: usize = 0usize;
    let mut zero_terminated: bool = false;
    let mut files: [2]str;
    let mut file_count: usize = 0usize;
    let mut i: usize = start;
    let mut options_done: bool = false;
    while (i < argc) {
        let arg: str = args::argat(i);
        if (!options_done && arg == "--") { options_done = true; i += 1usize; continue; };
        if (!options_done && arg.len > 2usize && arg[0usize..2usize] == "--") {
            let key: str = longkey(arg);
            if (key == "--count" || is_prefix(key, "--count")) { count_mode = true; i += 1usize; continue; };
            if (key == "--repeated" || is_prefix(key, "--repeated")) { duplicates = true; i += 1usize; continue; };
            if (key == "--unique" || is_prefix(key, "--unique")) { only_unique = true; i += 1usize; continue; };
            if (key == "--all-repeated" || is_prefix(key, "--all-repeated")) { all_repeated = true; i += 1usize; continue; };
            if (key == "--ignore-case" || is_prefix(key, "--ignore-case")) { ignore_case = true; i += 1usize; continue; };
            if (key == "--zero-terminated" || is_prefix(key, "--zero-terminated")) { zero_terminated = true; i += 1usize; continue; };
            if (key == "--skip-fields" || key == "--skip-chars" || key == "--check-chars") {
                if (arg.len == key.len && i + 1usize >= argc) { io::eprintln("uniq: option '" + key + "' requires an argument"); usage_error(); return 1; };
                let mut value: str = "";
                if (arg.len > key.len) { value = arg[key.len + 1usize..arg.len]; i += 1usize; }
                else { value = args::argat(i + 1usize); i += 2usize; };
                let mut parsed: usize = 0usize;
                if (!parse_count(value, &mut parsed)) { io::eprintln("uniq: invalid number of fields/characters: '" + value + "'"); usage_error(); return 1; };
                if (key == "--skip-fields") { skip_fields = parsed; }
                else if (key == "--skip-chars") { skip_chars = parsed; }
                else { check_chars = parsed; };
                continue;
            };
            if (key == "--help" || is_prefix(key, "--help")) { help(); stream::finishoutput("uniq"); return 0; };
            if (key == "--version" || is_prefix(key, "--version")) { io::println("uniq (zovutils) 0.10.61"); stream::finishoutput("uniq"); return 0; };
            io::eprintln("uniq: unrecognized option '" + arg + "'"); usage_error(); return 1;
        };
        if (!options_done && arg.len > 1usize && arg.data[0usize] == 45u8) {
            let mut j: usize = 1usize;
            while (j < arg.len) {
                let option: u8 = arg.data[j];
                if (option == 99u8) { count_mode = true; j += 1usize; continue; };
                if (option == 100u8) { duplicates = true; j += 1usize; continue; };
                if (option == 68u8) { all_repeated = true; j += 1usize; continue; };
                if (option == 105u8) { ignore_case = true; j += 1usize; continue; };
                if (option == 117u8) { only_unique = true; j += 1usize; continue; };
                if (option == 122u8) { zero_terminated = true; j += 1usize; continue; };
                if (option == 102u8 || option == 115u8 || option == 119u8) {
                    let mut value: str = "";
                    if (j + 1usize < arg.len) { value = arg[j + 1usize..arg.len]; }
                    else if (i + 1usize < argc) { i += 1usize; value = args::argat(i); }
                    else { c::fprintf(c::stderr, "uniq: option requires an argument -- '%c'\n", option as i32); usage_error(); return 1; };
                    let mut parsed: usize = 0usize;
                    if (!parse_count(value, &mut parsed)) { io::eprintln("uniq: invalid number of fields/characters: '" + value + "'"); usage_error(); return 1; };
                    if (option == 102u8) { skip_fields = parsed; }
                    else if (option == 115u8) { skip_chars = parsed; }
                    else { check_chars = parsed; };
                    j = arg.len; continue;
                };
                c::fprintf(c::stderr, "uniq: invalid option -- '%c'\n", option as i32); usage_error(); return 1;
            };
            i += 1usize; continue;
        };
        if (file_count >= 2usize) { io::eprintln("uniq: extra operand '" + arg + "'"); usage_error(); return 1; };
        files[file_count] = arg; file_count += 1usize; i += 1usize;
    };

    platform_locale::zov_init_ctype_locale();

    let mut input: str = "-";
    let mut output: str = "";
    let mut has_output: bool = false;
    if (file_count > 0usize) { input = files[0usize]; };
    if (file_count > 1usize) { output = files[1usize]; has_output = true; };

    let mut in_fp: *c::FILE = c::stdin;
    let mut close_in: bool = false;
    if (input != "-") {
        let open_res: nullable *c::FILE = stream::openread(input);
        match (open_res) {
            case let opened: *c::FILE => { in_fp = opened; close_in = true; },
            case null => {
                let err: i32 = platform_errno::zov_errno_value();
                c::fprintf(c::stderr, "uniq: %s: %s\n", input.data as *i8, strc::strerror(err));
                return 1;
            },
        };
    };

    let mut out_fp: *c::FILE = c::stdout;
    let mut close_out: bool = false;
    if (has_output) {
        let opened_out: nullable *c::FILE = c::fopen(output.data as *i8, "wb");
        match (opened_out) {
            case let opened: *c::FILE => { out_fp = opened; close_out = true; },
            case null => {
                let err: i32 = platform_errno::zov_errno_value();
                c::fprintf(c::stderr, "uniq: %s: %s\n", output.data as *i8, strc::strerror(err));
                if (close_in) { stream::closefile(in_fp); };
                return 1;
            },
        };
    };

    let mut term: u8 = 10u8;
    if (zero_terminated) { term = 0u8; };
    let mut prev_line: UniqLine = line_init();
    let mut curr_line: UniqLine = line_init();
    let mut group_count: usize = 0usize;
    let mut have_group: bool = false;
    let mut status: i32 = 0;
    let mut read_err: bool = false;

    while (true) {
        let rc: i32 = read_line(in_fp, term, &mut curr_line);
        if (rc < 0i32) {
            c::fprintf(c::stderr, "uniq: read error: %s\n", input.data as *i8);
            status = 1;
            read_err = true;
            break;
        };
        if (rc == 0i32) {
            break;
        };
        if (!have_group) {
            line_copy(&mut prev_line, &curr_line);
            group_count = 1usize;
            have_group = true;
            continue;
        };
        if (lines_equal(&prev_line, &curr_line, ignore_case, skip_fields, skip_chars, check_chars)) {
            group_count += 1usize;
            if (all_repeated) {
                if (group_count == 2usize) {
                    if (!emit_line(out_fp, &prev_line, term, 1usize, false)) { status = 1; break; };
                };
                if (!emit_line(out_fp, &curr_line, term, 1usize, false)) { status = 1; break; };
            };
        } else {
            if (!all_repeated) {
                if (!emit_group(out_fp, term, &prev_line, group_count, count_mode, duplicates, only_unique)) {
                    status = 1;
                    break;
                };
            };
            line_copy(&mut prev_line, &curr_line);
            group_count = 1usize;
        };
    };

    if (status == 0 && !read_err && have_group && !all_repeated) {
        if (!emit_group(out_fp, term, &prev_line, group_count, count_mode, duplicates, only_unique)) {
            status = 1;
        };
    };

    if (c::fflush(out_fp) != 0i32) { status = 1; };
    if (close_out && c::fclose(out_fp) != 0i32) { status = 1; };
    if (close_in) { stream::closefile(in_fp); };
    mem::freeptr[u8](prev_line.data);
    mem::freeptr[u8](curr_line.data);
    if (!has_output && !stream::finishoutput("uniq")) { status = 1; };
    return status;
};
