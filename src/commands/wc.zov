use std::env;
use std::io;
use std::vec as vec;
use std::mem as mem;
use <stdio.h> as c;
use <platform_env.h> as platform_env;
use <ctype.h> as ct;
use <locale.h> as lc;
use <wchar.h> as wide;
use <string.h> as strc;
use <zov_wcwidth.h> as display;
use <platform_locale.h> as platform_locale;
use <platform_errno.h> as platform_errno;
use shared::io as stream;

type Counts = struct { lines: usize, words: usize, chars: usize, bytes: usize, maxline: usize };
type FileListError = struct { entry: usize, dash: bool };
type CountOutput = struct { data: [512]u8, used: usize };

fn report_files0_error(from: str, item: FileListError) void = {
    if (item.dash) { io::eprintln("wc: when reading file names from standard input, no file name of '-' allowed"); }
    else {
        io::eprint("wc: "); stream::printquoted(c::stderr, from, false);
        io::eprintln(":" + item.entry + ": invalid zero-length file name");
    };
};
fn singlebyte_c_locale() bool = {
    let current: nullable *i8 = lc::setlocale(0i32, 0i64 as *i8);
    if (current == null) { return false; };
    return strc::strcmp(current!, "C") == 0 || strc::strcmp(current!, "POSIX") == 0;
};

fn consume(character: i32, out: &mut Counts, linebytes: &mut usize, inword: &mut bool,
           posixly_correct: bool) void = {
    out.chars += 1usize;
    if (display::zov_iswspace(character as u32) != 0 || (!posixly_correct
        && (character == 160i32 || character == 8199i32 || character == 8239i32
            || character == 8288i32))) { *inword = false; }
    else if (!*inword) { out.words += 1usize; *inword = true; };
    if (character == 10i32) {
        out.lines += 1usize;
        if (*linebytes > out.maxline) { out.maxline = *linebytes; };
        *linebytes = 0usize;
    } else if (character == 13i32 || character == 12i32) {
        if (*linebytes > out.maxline) { out.maxline = *linebytes; };
        *linebytes = 0usize;
    } else if (character == 9i32) { *linebytes += 8usize - (*linebytes % 8usize); }
    else {
        let width: i32 = display::zov_wcwidth(character as u32);
        if (width > 0i32) { *linebytes += width as usize; };
    };
};

fn scan(fp: *c::FILE, out: &mut Counts, singlebyte_c: bool, line_fast: bool,
        utf8_locale: bool, chars: bool, debug: bool, posixly_correct: bool,
        backend_reported: &mut bool) bool = {
    out.lines = 0usize; out.words = 0usize; out.chars = 0usize; out.bytes = 0usize; out.maxline = 0usize;
    if (debug && line_fast && !*backend_reported) {
        let backend: i32 = stream::wcnewlinebackend();
        if (backend == 2i32) { io::eprintln("wc: using avx512 hardware support"); }
        else if (backend == 1i32) {
            io::eprintln("wc: avx512 support not detected");
            io::eprintln("wc: using avx2 hardware support");
        } else if (backend == 3i32) { io::eprintln("wc: using neon hardware support"); };
        *backend_reported = true;
    };
    let mut linebytes: usize = 0usize;
    let mut inword: bool = false;
    let mut pending: usize = 0usize;
    let mut state: [32]u64;
    strc::memset((&mut state[0usize]) as *void, 0, 256usize);
    let buf: [65536]u8;
    while (true) {
        let mut read_count: i64 = 0i64;
        // GNU wc retries EINTR in multibyte locales but exposes it in C mode.
        if (singlebyte_c) {
            read_count = stream::readonce(fp, ((&buf[0usize]) as *u8), 65536usize);
        } else {
            read_count = stream::readchunk(fp, ((&buf[0usize]) as *u8), 65536usize);
        };
        if (read_count == 0i64) { break; };
        if (read_count < 0i64) {
            if (linebytes > out.maxline) { out.maxline = linebytes; };
            return false;
        };
        let n: usize = read_count as usize;
        out.bytes += n;
        if (line_fast) {
            out.lines += stream::wccountnewlines((&buf[0usize]) as *u8, n);
            if (chars) { out.chars += n; };
            continue;
        };
        if (singlebyte_c) {
            for (let i in 0..n) {
                let b: u8 = buf[i];
                out.chars += 1usize;
                if (b == 10u8) {
                    out.lines += 1usize;
                    if (linebytes > out.maxline) { out.maxline = linebytes; };
                    linebytes = 0usize;
                } else if (b == 13u8 || b == 12u8) {
                    if (linebytes > out.maxline) { out.maxline = linebytes; };
                    linebytes = 0usize;
                } else if (b == 9u8) { linebytes += 8usize - (linebytes % 8usize); }
                else if (b >= 32u8 && b < 128u8 && b != 127u8) { linebytes += 1usize; };
                if (ct::isspace(b as i32) != 0 || (!posixly_correct && b == 160u8)) { inword = false; }
                else if (!inword) { out.words += 1usize; inword = true; };
            };
            continue;
        };
        let mut i: usize = 0usize;
        while (i < n) {
            if (utf8_locale && buf[i] > 244u8) {
                if (pending > 0usize) {
                    pending = 0usize;
                    strc::memset((&mut state[0usize]) as *void, 0, 256usize);
                    continue;
                };
                if (!inword) { out.words += 1usize; inword = true; };
                strc::memset((&mut state[0usize]) as *void, 0, 256usize);
                i += 1usize;
                continue;
            };
            let mut character: i32 = 0i32;
            let decoded: usize = wide::mbrtowc((&mut character) as *void, ((&buf[i]) as *i8), n - i, ((&mut state[0usize]) as *void));
            if (decoded == 18446744073709551614usize) { pending += n - i; i = n; continue; };
            if (decoded == 18446744073709551615usize) {
                if (pending > 0usize) {
                    if (!inword) { out.words += 1usize; inword = true; };
                    pending = 0usize;
                    strc::memset((&mut state[0usize]) as *void, 0, 256usize);
                    continue;
                };
                if (!inword) { out.words += 1usize; inword = true; };
                strc::memset((&mut state[0usize]) as *void, 0, 256usize);
                i += 1usize;
                continue;
            };
            pending = 0usize;
            consume(character, out, &mut linebytes, &mut inword, posixly_correct);
            if (decoded == 0usize) { i += 1usize; }
            else { i += decoded; };
        };
    };
    if (pending > 0usize && !inword) { out.words += 1usize; };
    if (linebytes > out.maxline) { out.maxline = linebytes; };
    return true;
};

fn readlist(fp: *c::FILE, out: &mut String) bool = {
    let mut cap: usize = 1024usize;
    let mut len: usize = 0usize;
    let mut buf: *u8 = mem::alloc[u8](cap);
    while (true) {
        let byte: i32 = c::fgetc(fp);
        if (byte == -1) { break; };
        if (len == cap) {
            if (cap > 1073741824usize) { mem::freeptr[u8](buf); return false; };
            cap = cap * 2usize;
            buf = mem::reallocbuf[u8](buf, cap);
        };
        buf[len] = byte as u8;
        len += 1usize;
    };
    if (stream::readerror(fp)) { mem::freeptr[u8](buf); return false; };
    *out = String::fromowned(buf, len, cap);
    return true;
};

fn digits(n: usize) usize = {
    let mut value: usize = n;
    let mut width: usize = 1usize;
    while (value >= 10usize) { value = value / 10usize; width += 1usize; };
    return width;
};

fn saturating_add(target: &mut usize, value: usize) bool = {
    let maximum: usize = ~0usize;
    if (maximum - *target < value) { *target = maximum; return true; };
    *target += value;
    return false;
};

fn total_overflow(unit: str) void = {
    io::eprintln("wc: total " + unit + ": Value too large for defined data type");
};

fn columns(lines: bool, words: bool, chars: bool, bytes: bool, maxline: bool) usize = {
    let mut count: usize = 0usize;
    if (lines) { count += 1usize; };
    if (words) { count += 1usize; };
    if (chars) { count += 1usize; };
    if (bytes) { count += 1usize; };
    if (maxline) { count += 1usize; };
    return count;
};

fn append_output(output: &mut CountOutput, value: u8) bool = {
    if (output.used == 512usize) { return false; };
    output.data[output.used] = value;
    output.used += 1usize;
    return true;
};

fn append_count(output: &mut CountOutput, value: usize, width: usize) bool = {
    let mut current: usize = value;
    let mut digits: [32]u8;
    let mut used: usize = 0usize;
    while (true) {
        digits[used] = (48usize + (current % 10usize)) as u8;
        used += 1usize;
        current /= 10usize;
        if (current == 0usize) { break; };
    };
    let mut padding: usize = 0usize;
    if (width > used) { padding = width - used; };
    while (padding > 0usize) { if (!append_output(output, 32u8)) { return false; }; padding -= 1usize; };
    while (used > 0usize) { used -= 1usize; if (!append_output(output, digits[used])) { return false; }; };
    return true;
};

fn print_counts(v: Counts, lines: bool, words: bool, chars: bool, bytes: bool, maxline: bool, name: str, hasname: bool, width: usize) bool = {
    let mut newline: bool = false;
    if (hasname) { for (let i in 0..name.len) { if (name.data[i] == 10u8) { newline = true; }; }; };
    let mut estimated: usize = 1usize;
    let field_count: usize = columns(lines, words, chars, bytes, maxline);
    if (field_count > 0usize) { estimated += width * field_count + field_count - 1usize; };
    if (hasname) { estimated += name.len + 1usize; };
    if (newline || estimated > 512usize) {
        if (c::fflush(c::stdout) != 0) { return false; };
        let mut old_first: bool = true;
        if (lines) { c::fprintf(c::stdout, "%*zu", width as i32, v.lines); old_first = false; };
        if (words) { if (!old_first) { c::putchar(32); }; c::fprintf(c::stdout, "%*zu", width as i32, v.words); old_first = false; };
        if (chars) { if (!old_first) { c::putchar(32); }; c::fprintf(c::stdout, "%*zu", width as i32, v.chars); old_first = false; };
        if (bytes) { if (!old_first) { c::putchar(32); }; c::fprintf(c::stdout, "%*zu", width as i32, v.bytes); old_first = false; };
        if (maxline) { if (!old_first) { c::putchar(32); }; c::fprintf(c::stdout, "%*zu", width as i32, v.maxline); };
        if (hasname) {
            c::putchar(32);
            if (newline) { stream::printquoted(c::stdout, name, false); }
            else { for (let i in 0..name.len) { c::fputc(name.data[i] as i32, c::stdout); }; };
        };
        c::putchar(10);
        return c::fflush(c::stdout) == 0;
    };
    let mut output: CountOutput;
    output.used = 0usize;
    let mut first: bool = true;
    if (lines) { if (!append_count(&mut output, v.lines, width)) { return false; }; first = false; };
    if (words) { if (!first && !append_output(&mut output, 32u8)) { return false; }; if (!append_count(&mut output, v.words, width)) { return false; }; first = false; };
    if (chars) { if (!first && !append_output(&mut output, 32u8)) { return false; }; if (!append_count(&mut output, v.chars, width)) { return false; }; first = false; };
    if (bytes) { if (!first && !append_output(&mut output, 32u8)) { return false; }; if (!append_count(&mut output, v.bytes, width)) { return false; }; first = false; };
    if (maxline) { if (!first && !append_output(&mut output, 32u8)) { return false; }; if (!append_count(&mut output, v.maxline, width)) { return false; }; first = false; };
    if (hasname) {
        if (!append_output(&mut output, 32u8)) { return false; };
        for (let i in 0..name.len) { if (!append_output(&mut output, name.data[i])) { return false; }; };
    };
    if (!append_output(&mut output, 10u8)) { return false; };
    if (!stream::writeatomic(c::stdout, ((&output.data[0usize]) as *u8), output.used)) {
        platform_errno::zov_report_wc_write_error();
        return false;
    };
    return true;
};

fn longmatch(arg: str, option: str) bool = {
    return arg.len > 2usize && arg.len <= option.len && arg == option[0usize..arg.len];
};

fn valueprefix(arg: str, option: str) bool = {
    return arg.len <= option.len && arg == option[0usize..arg.len];
};

fn badargument(option: str) void = {
    io::eprintln("wc: option '" + option + "' doesn't allow an argument\nTry 'wc --help' for more information.");
};

fn badlong(arg: str) void = {
    io::eprintln("wc: unrecognized option '" + arg + "'\nTry 'wc --help' for more information.");
};

fn badshort(opt: u8) void = {
    c::fprintf(c::stderr, "wc: invalid option -- '%c'\nTry 'wc --help' for more information.\n", opt as i32);
};

fn totalvalue(value: str) void = {
    io::eprint("  - ");
    stream::printquotedargument(c::stderr, value);
    c::fputc(10, c::stderr);
};

fn totalargumentending() void = {
    io::eprint(" for ");
    stream::printquotedargument(c::stderr, "--total");
    io::eprintln("\nValid arguments are:");
    totalvalue("auto");
    totalvalue("always");
    totalvalue("only");
    totalvalue("never");
    io::eprintln("Try 'wc --help' for more information.");
};

fn badtotal(value: str) void = {
    io::eprint("wc: invalid argument ");
    stream::printquotedargument(c::stderr, value);
    totalargumentending();
};

fn missingargument(option: str) void = {
    io::eprintln("wc: option '" + option + "' requires an argument\nTry 'wc --help' for more information.");
};

fn ambiguous_total(value: str) void = {
    io::eprint("wc: ambiguous argument ");
    stream::printquotedargument(c::stderr, value);
    totalargumentending();
};

fn help() void = {
    io::print("Usage: wc [OPTION]... [FILE]...\n");
    io::print("  or:  wc [OPTION]... --files0-from=F\n");
    io::print("Print newline, word, and byte counts for each FILE, and a total line if\n");
    io::print("more than one FILE is specified.  A word is a nonempty sequence of non white\n");
    io::print("space delimited by white space characters or by start or end of input.\n\n");
    io::print("With no FILE, or when FILE is -, read standard input.\n\n");
    io::print("The options below may be used to select which counts are printed, always in\n");
    io::print("the following order: newline, word, character, byte, maximum line length.\n");
    io::print("  -c, --bytes\n         print the byte counts\n");
    io::print("  -m, --chars\n         print the character counts\n");
    io::print("  -l, --lines\n         print the newline counts\n");
    io::print("      --debug\n         indicate what line count acceleration is used\n");
    io::print("      --files0-from=F\n");
    io::print("         read input from the files specified by\n");
    io::print("         NUL-terminated names in file F;\n");
    io::print("         If F is -, read names from standard input\n");
    io::print("  -L, --max-line-length\n         print the maximum display width\n");
    io::print("  -w, --words\n         print the word counts\n");
    io::print("      --total=WHEN\n");
    io::print("         when to print a line with total counts;\n");
    io::print("         WHEN can be: auto, always, only, never\n");
    io::print("      --help\n         display this help and exit\n");
    io::print("      --version\n         output version information and exit\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/wc>\n");
    io::print("or available locally via: info '(coreutils) wc invocation'\n");
};

export fn run(start: usize, argc: usize) i32 = {
    lc::setlocale(0i32, "");
    let singlebyte_c: bool = singlebyte_c_locale();
    let utf8_locale: bool = platform_locale::zov_locale_uses_unicode_quotes() != 0i32;
    let mut lines: bool = false;
    let mut words: bool = false;
    let mut chars: bool = false;
    let mut bytes: bool = false;
    let mut maxline: bool = false;
    let mut debug: bool = false;
    let mut total_mode: str = "auto";
    let mut files0_from: str = "";
    let mut files0_given: bool = false;
    let mut operands: bool = false;
    let posixly_correct: bool = platform_env::zov_posixly_correct() != 0i32;
    let mut files = vec::new[str]();
    defer files.free();
    let mut files0_errors = vec::new[FileListError]();
    defer files0_errors.free();
    let mut files0_file_entries = vec::new[usize]();
    defer files0_file_entries.free();
    let mut i: usize = start;
    while (i < argc) {
        let arg: str = env::argat(i);
        if (!operands && arg == "--") { operands = true; i += 1usize; continue; };
        if (operands || arg == "-" || arg.len == 0usize || arg.data[0usize] != 45u8) {
            if (posixly_correct) { operands = true; };
            files.push(arg); i += 1usize; continue;
        };
        if (arg.len >= 2usize && arg[0usize..2usize] == "--") {
            let mut eq: usize = arg.len;
            for (let j in 2usize..arg.len) { if (arg.data[j] == 61u8) { eq = j; break; }; };
            let key: str = arg[0usize..eq];
            let has_value: bool = eq < arg.len;
            let mut matches: usize = 0usize;
            if (longmatch(key, "--lines")) { matches += 1usize; };
            if (longmatch(key, "--words")) { matches += 1usize; };
            if (longmatch(key, "--chars")) { matches += 1usize; };
            if (longmatch(key, "--bytes")) { matches += 1usize; };
            if (longmatch(key, "--max-line-length")) { matches += 1usize; };
            if (longmatch(key, "--debug")) { matches += 1usize; };
            if (longmatch(key, "--help")) { matches += 1usize; };
            if (longmatch(key, "--version")) { matches += 1usize; };
            if (longmatch(key, "--total")) { matches += 1usize; };
            if (longmatch(key, "--files0-from")) { matches += 1usize; };
            if (matches == 0usize) { badlong(arg); return 1; };
            if (longmatch(key, "--total")) {
                if (has_value) { total_mode = arg[eq + 1usize..arg.len]; }
                else {
                    if (i + 1usize >= argc) { missingargument("--total"); return 1; };
                    total_mode = env::argat(i + 1usize);
                    i += 1usize;
                };
                let mut total_matches: usize = 0usize;
                if (valueprefix(total_mode, "auto")) { total_matches += 1usize; };
                if (valueprefix(total_mode, "always")) { total_matches += 1usize; };
                if (valueprefix(total_mode, "only")) { total_matches += 1usize; };
                if (valueprefix(total_mode, "never")) { total_matches += 1usize; };
                if (total_matches == 0usize) { badtotal(total_mode); return 1; };
                if (total_matches > 1usize) { ambiguous_total(total_mode); return 1; };
                if (valueprefix(total_mode, "auto")) { total_mode = "auto"; }
                else if (valueprefix(total_mode, "always")) { total_mode = "always"; }
                else if (valueprefix(total_mode, "only")) { total_mode = "only"; }
                else { total_mode = "never"; };
                i += 1usize; continue;
            };
            if (longmatch(key, "--files0-from")) {
                if (has_value) { files0_from = arg[eq + 1usize..arg.len]; }
                else {
                    if (i + 1usize >= argc) { missingargument("--files0-from"); return 1; };
                    files0_from = env::argat(i + 1usize);
                    i += 1usize;
                };
                files0_given = true; i += 1usize; continue;
            };
            if (has_value) {
                if (longmatch(key, "--lines")) { badargument("--lines"); }
                else if (longmatch(key, "--words")) { badargument("--words"); }
                else if (longmatch(key, "--chars")) { badargument("--chars"); }
                else if (longmatch(key, "--bytes")) { badargument("--bytes"); }
                else if (longmatch(key, "--max-line-length")) { badargument("--max-line-length"); }
                else if (longmatch(key, "--debug")) { badargument("--debug"); }
                else if (longmatch(key, "--help")) { badargument("--help"); }
                else { badargument("--version"); };
                return 1;
            };
            if (longmatch(key, "--lines")) { lines = true; }
            else if (longmatch(key, "--words")) { words = true; }
            else if (longmatch(key, "--chars")) { chars = true; }
            else if (longmatch(key, "--bytes")) { bytes = true; }
            else if (longmatch(key, "--max-line-length")) { maxline = true; }
            else if (longmatch(key, "--debug")) { debug = true; }
            else if (longmatch(key, "--help")) {
                help();
                if (platform_errno::zov_platform_is_apple() != 0i32) {
                    if (platform_errno::zov_finish_wc_output() == 0i32) { return 1; };
                } else if (!stream::finishoutputbrief("wc")) { return 1; };
                return 0;
            }
            else if (longmatch(key, "--version")) {
                io::println("wc (zovutils) 0.10.4");
                if (platform_errno::zov_platform_is_apple() != 0i32) {
                    if (platform_errno::zov_finish_wc_output() == 0i32) { return 1; };
                } else if (!stream::finishoutputbrief("wc")) { return 1; };
                return 0;
            };
            i += 1usize; continue;
        };
        if (arg.len >= 2usize && arg.data[1usize] != 45u8) {
            for (let j in 1usize..arg.len) {
                let ch: u8 = arg.data[j];
                if (ch == 108u8) { lines = true; }
                else if (ch == 119u8) { words = true; }
                else if (ch == 109u8) { chars = true; }
                else if (ch == 99u8) { bytes = true; }
                else if (ch == 76u8) { maxline = true; }
                else { badshort(ch); return 1; };
            };
        } else { badlong(arg); return 1; };
        i += 1usize;
    };
    if (!lines && !words && !chars && !bytes && !maxline) { lines = true; words = true; bytes = true; };
    let line_fast: bool = lines && !words && !maxline && (!chars || singlebyte_c);
    let mut backend_reported: bool = false;
    let mut file_list: String = String::new();
    defer file_list.free();
    let mut files0_invalid: bool = false;
    if (files0_given) {
        if (files.len() > 0usize) {
            io::eprint("wc: extra operand ");
            stream::printquoted(c::stderr, files.get(0), true);
            io::eprintln("\nfile operands cannot be combined with --files0-from\nTry 'wc --help' for more information.");
            return 1;
        };
        let mut listfp: *c::FILE = c::stdin;
        let mut list_owned: bool = false;
        if (files0_from != "-") {
            let raw: nullable *c::FILE = stream::openread(files0_from);
            if (raw == null) { stream::erroropen("wc", files0_from); return 1; };
            listfp = raw!; list_owned = true;
        };
        if (!readlist(listfp, &mut file_list)) { stream::errorprefix("wc", files0_from); if (list_owned) { stream::closefile(listfp); }; return 1; };
        if (list_owned) { stream::closefile(listfp); };
        let list_view: str = file_list.view();
        let mut begin: usize = 0usize;
        let mut list_entry: usize = 0usize;
        for (let j in 0..list_view.len) {
            if (list_view.data[j] == 0u8) {
                list_entry += 1usize;
                if (j == begin) {
                    files0_invalid = true;
                    files0_errors.push(FileListError{ entry = list_entry, dash = false });
                    begin = j + 1usize;
                    continue;
                };
                let listed_path: str = list_view[begin..j];
                if (files0_from == "-" && listed_path == "-") {
                    files0_invalid = true;
                    files0_errors.push(FileListError{ entry = list_entry, dash = true });
                } else { files.push(listed_path); files0_file_entries.push(list_entry); };
                begin = j + 1usize;
            };
        };
        if (begin < list_view.len) {
            let listed_path: str = list_view[begin..list_view.len];
            if (files0_from == "-" && listed_path == "-") {
                files0_invalid = true;
                list_entry += 1usize;
                files0_errors.push(FileListError{ entry = list_entry, dash = true });
            } else { list_entry += 1usize; files.push(listed_path); files0_file_entries.push(list_entry); };
        };
    };
    if (files0_given && files.len() == 0usize) {
        for (let k in 0..files0_errors.len()) {
            report_files0_error(files0_from, files0_errors.get(k));
        };
        let zero: Counts = Counts{ lines = 0usize, words = 0usize, chars = 0usize, bytes = 0usize, maxline = 0usize };
        if (total_mode == "always") { if (!print_counts(zero, lines, words, chars, bytes, maxline, "total", true, 1usize)) { return 1; }; }
        else if (total_mode == "only") { if (!print_counts(zero, lines, words, chars, bytes, maxline, "", false, 1usize)) { return 1; }; };
        if (platform_errno::zov_finish_wc_output() == 0i32) { return 1; };
        if (files0_invalid) { return 1; };
        return 0;
    };

    let mut total: Counts = Counts{ lines = 0usize, words = 0usize, chars = 0usize, bytes = 0usize, maxline = 0usize };
    let mut status: i32 = 0;
    let mut output_failed: bool = false;
    let mut total_lines_overflow: bool = false;
    let mut total_words_overflow: bool = false;
    let mut total_chars_overflow: bool = false;
    let mut total_bytes_overflow: bool = false;
    if (files0_invalid) { status = 1; };
    let mut counts = vec::new[Counts]();
    defer counts.free();
    let mut names = vec::new[str]();
    defer names.free();
    let nfiles: usize = files.len();
    let mut total_operands: usize = nfiles;
    if (files0_given) { total_operands += files0_errors.len(); };
    let mut stdin_operand: bool = false;
    for (let k in 0..nfiles) { if (files.get(k) == "-") { stdin_operand = true; }; };
    let mut stdin_seekable: bool = true;
    if (stdin_operand) {
        stdin_seekable = stream::regularfile(c::stdin);
    };
    if (nfiles == 0usize) {
        let seekable: bool = stream::regularfile(c::stdin);
        let mut v: Counts = Counts{ lines = 0usize, words = 0usize, chars = 0usize, bytes = 0usize, maxline = 0usize };
        let mut scanned: bool = true;
        if (bytes && !lines && !words && !chars && !maxline) {
            let remaining: i64 = stream::regularbytesremaining(c::stdin);
            if (remaining >= 0i64) { v.bytes = remaining as usize; }
            else { scanned = scan(c::stdin, &mut v, singlebyte_c, line_fast, utf8_locale, chars, debug, posixly_correct, &mut backend_reported); };
        } else { scanned = scan(c::stdin, &mut v, singlebyte_c, line_fast, utf8_locale, chars, debug, posixly_correct, &mut backend_reported); };
        if (!scanned) { stream::errorprefix("wc", "standard input"); status = 1; };
        let mut width: usize = 1usize;
        if (seekable) {
            if (lines && digits(v.lines) > width) { width = digits(v.lines); };
            if (words && digits(v.words) > width) { width = digits(v.words); };
            if (chars && digits(v.chars) > width) { width = digits(v.chars); };
            if (bytes && digits(v.bytes) > width) { width = digits(v.bytes); };
            if (maxline && digits(v.maxline) > width) { width = digits(v.maxline); };
            if (columns(lines, words, chars, bytes, maxline) > 1usize && digits(v.bytes) > width) { width = digits(v.bytes); };
        } else {
            let mut columns: usize = 0usize;
            if (lines) { columns += 1usize; };
            if (words) { columns += 1usize; };
            if (chars) { columns += 1usize; };
            if (bytes) { columns += 1usize; };
            if (maxline) { columns += 1usize; };
            if (columns > 1usize) { width = 7usize; };
        };
        if (total_mode == "only") { width = 1usize; };
        if (total_mode != "only" && !print_counts(v, lines, words, chars, bytes, maxline, "", false, width)) { status = 1; output_failed = true; };
        if (!output_failed && (total_mode == "always" || total_mode == "only")) {
            if (total_mode == "only") { if (!print_counts(v, lines, words, chars, bytes, maxline, "", false, width)) { status = 1; output_failed = true; }; }
            else if (!print_counts(v, lines, words, chars, bytes, maxline, "total", true, width)) { status = 1; output_failed = true; };
        };
    } else {
        let mut first: usize = 0usize;
        let mut list_error_index: usize = 0usize;
        while (first < files.len()) {
            if (files0_given) {
                let file_entry: usize = files0_file_entries.get(first);
                while (list_error_index < files0_errors.len() && files0_errors.get(list_error_index).entry < file_entry) {
                    report_files0_error(files0_from, files0_errors.get(list_error_index));
                    list_error_index += 1usize;
                };
            };
            let path: str = files.get(first);
            if (path.len == 0usize) {
                io::eprintln("wc: invalid zero-length file name");
                status = 1;
                first += 1usize;
                continue;
            };
            let mut fp: *c::FILE = c::stdin;
            let mut owned: bool = false;
            if (path != "-") {
                let raw: nullable *c::FILE = stream::openread(path);
                if (raw == null) { stream::errorprefix("wc", path); status = 1; first += 1usize; continue; };
                fp = raw!; owned = true;
            };
            let mut v: Counts = Counts{ lines = 0usize, words = 0usize, chars = 0usize, bytes = 0usize, maxline = 0usize };
            let mut scanned: bool = true;
            if (bytes && !lines && !words && !chars && !maxline) {
                let remaining: i64 = stream::regularbytesremaining(fp);
                if (remaining >= 0i64) { v.bytes = remaining as usize; }
                else { scanned = scan(fp, &mut v, singlebyte_c, line_fast, utf8_locale, chars, debug, posixly_correct, &mut backend_reported); };
            } else { scanned = scan(fp, &mut v, singlebyte_c, line_fast, utf8_locale, chars, debug, posixly_correct, &mut backend_reported); };
            if (scanned) {
                counts.push(v); names.push(path);
                if (saturating_add(&mut total.lines, v.lines)) { total_lines_overflow = true; };
                if (saturating_add(&mut total.words, v.words)) { total_words_overflow = true; };
                if (saturating_add(&mut total.chars, v.chars)) { total_chars_overflow = true; };
                if (saturating_add(&mut total.bytes, v.bytes)) { total_bytes_overflow = true; };
                if (v.maxline > total.maxline) { total.maxline = v.maxline; };
            } else {
                if (path == "-") { stream::errorprefix("wc", "standard input"); }
                else { stream::errorprefix("wc", path); };
                status = 1;
            };
            if (owned && !stream::closefile(fp)) { stream::errorprefix("wc", path); status = 1; };
            first += 1usize;
        };
        while (list_error_index < files0_errors.len()) {
            report_files0_error(files0_from, files0_errors.get(list_error_index));
            list_error_index += 1usize;
        };
        let mut width: usize = 1usize;
        for (let k in 0..counts.len()) {
            let v: Counts = counts.get(k);
            if (lines && digits(v.lines) > width) { width = digits(v.lines); };
            if (words && digits(v.words) > width) { width = digits(v.words); };
            if (chars && digits(v.chars) > width) { width = digits(v.chars); };
            if (bytes && digits(v.bytes) > width) { width = digits(v.bytes); };
            if (maxline && digits(v.maxline) > width) { width = digits(v.maxline); };
            if ((columns(lines, words, chars, bytes, maxline) > 1usize || total_operands > 1usize) && digits(v.bytes) > width) { width = digits(v.bytes); };
        };
        if (total_operands > 1usize || total_mode == "always") {
            if (lines && digits(total.lines) > width) { width = digits(total.lines); };
            if (words && digits(total.words) > width) { width = digits(total.words); };
            if (chars && digits(total.chars) > width) { width = digits(total.chars); };
            if (bytes && digits(total.bytes) > width) { width = digits(total.bytes); };
            if (maxline && digits(total.maxline) > width) { width = digits(total.maxline); };
            if ((columns(lines, words, chars, bytes, maxline) > 1usize || total_operands > 1usize) && digits(total.bytes) > width) { width = digits(total.bytes); };
        };
        if (stdin_operand && !stdin_seekable && (total_operands > 1usize || columns(lines, words, chars, bytes, maxline) > 1usize) && width < 7usize) { width = 7usize; };
        if (files0_given && files0_from == "-" && !stream::regularfile(c::stdin)) { width = 1usize; };
        if (total_mode == "only") { width = 1usize; };
        if (total_mode != "only") {
            for (let k in 0..counts.len()) {
                if (!print_counts(counts.get(k), lines, words, chars, bytes, maxline, names.get(k), true, width)) { status = 1; output_failed = true; break; };
            };
        };
        if (!output_failed && ((total_operands > 1usize && total_mode != "never") || total_mode == "always" || total_mode == "only")) {
            let mut total_name: str = "total";
            let mut total_hasname: bool = true;
            if (total_mode == "only") { total_name = ""; total_hasname = false; };
            if (!print_counts(total, lines, words, chars, bytes, maxline, total_name, total_hasname, width)) { status = 1; output_failed = true; };
            if (lines && total_lines_overflow) { total_overflow("lines"); status = 1; };
            if (words && total_words_overflow) { total_overflow("words"); status = 1; };
            if (chars && total_chars_overflow) { total_overflow("characters"); status = 1; };
            if (bytes && total_bytes_overflow) { total_overflow("bytes"); status = 1; };
        };
    };
    if (platform_errno::zov_finish_wc_output() == 0i32) { status = 1; };
    return status;
};
