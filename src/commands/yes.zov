use std::env as args;
use std::io;
use std::vec as vec;
use std::mem as mem;
use <stdio.h> as c;
use shared::io as stream;

fn is_prefix(value: str, full: str) bool = {
    return value.len > 2usize && value.len <= full.len && value == full[0usize..value.len];
};

fn usage_error() void = {
    io::eprintln("Try 'yes --help' for more information.");
};

fn help() void = {
    io::print("Usage: yes [STRING]...\n");
    io::print("  or:  yes OPTION\n");
    io::print("Repeatedly output a line with all specified STRING(s), or 'y'.\n\n");
    io::print("      --help\n");
    io::print("         display this help and exit\n");
    io::print("      --version\n");
    io::print("         output version information and exit\n\n");
    io::print("Report bugs to: bug-coreutils@gnu.org\n");
    io::print("GNU coreutils home page: <https://www.gnu.org/software/coreutils/>\n");
    io::print("General help using GNU software: <https://www.gnu.org/gethelp/>\n");
    io::print("Report any translation bugs to <https://translationproject.org/team/>\n");
    io::print("Full documentation <https://www.gnu.org/software/coreutils/yes>\n");
    io::print("or available locally via: info '(coreutils) yes invocation'\n");
};

export fn run(start: usize, argc: usize) i32 = {
    let mut scan: usize = start;
    let mut options_done: bool = false;
    let mut operand_count: usize = 0usize;
    while (scan < argc) {
        let arg: str = args::argat(scan);
        if (!options_done && arg == "--") { options_done = true; scan += 1usize; continue; };
        if (!options_done && arg.len > 2usize && arg[0usize..2usize] == "--") {
            let mut key: str = arg;
            for (let i in 0usize..arg.len) {
                if (arg.data[i] == 61u8) { key = arg[0usize..i]; break; };
            };
            if (key == "--help" || is_prefix(key, "--help")) {
                if (arg.len != key.len) {
                    io::eprintln("yes: option '--help' doesn't allow an argument"); usage_error(); return 1;
                };
                help(); stream::finishoutput("yes"); return 0;
            };
            if (key == "--version" || is_prefix(key, "--version")) {
                if (arg.len != key.len) {
                    io::eprintln("yes: option '--version' doesn't allow an argument"); usage_error(); return 1;
                };
                io::println("yes (zovutils) 0.11.0"); stream::finishoutput("yes"); return 0;
            };
            io::eprintln("yes: unrecognized option '" + arg + "'"); usage_error(); return 1;
        };
        if (!options_done && arg.len > 1usize && arg.data[0usize] == 45u8) {
            c::fprintf(c::stderr, "yes: invalid option -- '%c'\n", arg.data[1usize] as i32); usage_error(); return 1;
        };
        operand_count += 1usize;
        scan += 1usize;
    };
    let mut line_buf = vec::new[u8]();
    if (operand_count == 0usize) {
        line_buf.push(121u8);
        line_buf.push(10u8);
    } else {
        let mut i: usize = start;
        let mut opts_done: bool = false;
        let mut first: bool = true;
        while (i < argc) {
            let arg: str = args::argat(i);
            if (!opts_done && arg == "--") { opts_done = true; i += 1usize; continue; };
            if (!opts_done && arg.len > 1usize && arg.data[0usize] == 45u8) { i += 1usize; continue; };
            if (!first) { line_buf.push(32u8); };
            for (let j in 0usize..arg.len) {
                line_buf.push(arg.data[j]);
            };
            first = false;
            i += 1usize;
        };
        line_buf.push(10u8);
    };

    let line_len: usize = line_buf.length;
    let target_buf_size: usize = 16384usize;
    let mut tile_count: usize = target_buf_size / line_len;
    if (tile_count == 0usize) { tile_count = 1usize; };
    let full_buf_size: usize = tile_count * line_len;
    let out_buf: *u8 = mem::alloc[u8](full_buf_size);
    for (let t in 0usize..tile_count) {
        let offset: usize = t * line_len;
        for (let j in 0usize..line_len) {
            out_buf[offset + j] = line_buf.get(j);
        };
    };

    while (true) {
        if (!stream::writebytes(c::stdout, out_buf, full_buf_size)) {
            mem::freeptr[u8](out_buf);
            line_buf.free();
            return 1;
        };
    };
    return 0;
};
