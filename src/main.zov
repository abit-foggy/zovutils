use std::env;
use std::io;
use <stdio.h> as c;

use commands::cat;
use commands::comm;
use commands::csplit;
use commands::split;
use commands::tac;
use commands::od;
use commands::mkdir;
use commands::rmdir;
use commands::touch;
use commands::ln;
use commands::cp;
use commands::mv;
use commands::rm;
use commands::chmod;
use commands::chown;
use commands::chgrp;
use commands::cut;
use commands::basename;
use commands::dirname;
use commands::echo;
use commands::expand;
use commands::environment;
use commands::false_cmd;
use commands::fold;
use commands::fmt;
use commands::head;
use commands::join;
use commands::nl;
use commands::paste;
use commands::printenv;
use commands::printf;
use commands::pwd;
use commands::seq as sequence;
use commands::sleep as sleeper;
use commands::sort;
use commands::test_cmd as testcmd;
use commands::tail;
use commands::tr;
use commands::unexpand;
use commands::true_cmd;
use commands::uniq;
use commands::yes as yescmd;
use commands::wc;

fn program_name(path: str) str = {
    let mut start: usize = 0usize;
    for (let i in 0..path.len) {
        if (path.data[i] == 47u8) { start = i + 1usize; };
    };
    return path[start..path.len];
};

fn dispatch(name: str, start: usize, argc: usize) i32 = {
    if (name == "basename") { return basename::run(start, argc); };
    if (name == "dirname") { return dirname::run(start, argc); };
    if (name == "echo") { return echo::run(start, argc); };
    if (name == "expand") { return expand::run(start, argc); };
    if (name == "env") { return environment::run(start, argc); };
    if (name == "false") { return false_cmd::run(start, argc); };
    if (name == "fold") { return fold::run(start, argc); };
    if (name == "fmt") { return fmt::run(start, argc); };
    if (name == "true") { return true_cmd::run(start, argc); };
    if (name == "uniq") { return uniq::run(start, argc); };
    if (name == "yes") { return yescmd::run(start, argc); };
    if (name == "cat") { return cat::run(start, argc); };
    if (name == "comm") { return comm::run(start, argc); };
    if (name == "csplit") { return csplit::run(start, argc); };
    if (name == "split") { return split::run(start, argc); };
    if (name == "tac") { return tac::run(start, argc); };
    if (name == "od") { return od::run(start, argc); };
    if (name == "mkdir") { return mkdir::run(start, argc); };
    if (name == "rmdir") { return rmdir::run(start, argc); };
    if (name == "touch") { return touch::run(start, argc); };
    if (name == "ln") { return ln::run(start, argc); };
    if (name == "cp") { return cp::run(start, argc); };
    if (name == "mv") { return mv::run(start, argc); };
    if (name == "rm") { return rm::run(start, argc); };
    if (name == "chmod") { return chmod::run(start, argc); };
    if (name == "chown") { return chown::run(start, argc); };
    if (name == "chgrp") { return chgrp::run(start, argc); };
    if (name == "cut") { return cut::run(start, argc); };
    if (name == "head") { return head::run(start, argc); };
    if (name == "join") { return join::run(start, argc); };
    if (name == "nl") { return nl::run(start, argc); };
    if (name == "paste") { return paste::run(start, argc); };
    if (name == "printenv") { return printenv::run(start, argc); };
    if (name == "printf") { return printf::run(start, argc); };
    if (name == "pwd") { return pwd::run(start, argc); };
    if (name == "seq") { return sequence::run(start, argc); };
    if (name == "sleep") { return sleeper::run(start, argc); };
    if (name == "sort") { return sort::run(start, argc); };
    if (name == "test") { return testcmd::run(start, argc, false); };
    if (name == "[") { return testcmd::run(start, argc, true); };
    if (name == "tail") { return tail::run(start, argc); };
    if (name == "tr") { return tr::run(start, argc); };
    if (name == "unexpand") { return unexpand::run(start, argc); };
    if (name == "wc") { return wc::run(start, argc); };
    io::println("zovutils: unknown utility '" + name + "'");
    io::println("usage: zovutils <utility> [arguments...]");
    return 1;
};

export fn main() i32 = {
    let argc: usize = env::argscount();
    if (argc == 0usize) { return 1; };

    let invoked_as: str = program_name(env::argat(0usize));
    if (invoked_as != "zovutils" && invoked_as != "main") {
        return dispatch(invoked_as, 1usize, argc);
    };
    if (argc < 2usize) {
        io::println("usage: zovutils <utility> [arguments...]");
        io::println("utilities: basename cat chgrp chmod chown comm cp csplit cut dirname echo env expand false fold fmt head join ln mkdir mv nl od paste printenv printf pwd rm rmdir seq sleep sort split tac tail test touch tr true uniq unexpand wc yes");
        return 1;
    };
    if (env::argat(1usize) == "--help" || env::argat(1usize) == "-h") {
        io::println("usage: zovutils <utility> [arguments...]");
        io::println("utilities: basename cat chgrp chmod chown comm cp csplit cut dirname echo env expand false fold fmt head join ln mkdir mv nl od paste printenv printf pwd rm rmdir seq sleep sort split tac tail test touch tr true uniq unexpand wc yes");
        return 0;
    };
    if (argc >= 2usize && (env::argat(1usize) == "--version" || env::argat(1usize) == "-V")) {
        io::println("zovutils 0.6.0 (GNU Coreutils 9.11 compatibility target)");
        return 0;
    };
    return dispatch(env::argat(1usize), 2usize, argc);
};

test "byte stream helpers preserve binary bytes" {
    let raw: nullable *c::FILE = c::tmpfile();
    assert(raw != null);
    let fp: *c::FILE = raw!;
    let input: [3]u8 = [0u8, 65u8, 255u8];
    assert(shared::io::writebytes(fp, ((&input[0usize]) as *u8), 2usize));
    assert(shared::io::putbyte(fp, input[2usize]));
    assert(c::fseek(fp, 0i64, c::SEEK_SET) == 0);
    let mut output: [3]u8;
    assert(shared::io::readbytes(fp, ((&output[0usize]) as *u8), 3usize) == 3usize);
    assert(output[0usize] == 0u8);
    assert(output[1usize] == 65u8);
    assert(output[2usize] == 255u8);
    assert(shared::io::closefile(fp));
};
