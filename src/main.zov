fn program_name(path: str) str = {
    let mut start: usize = 0usize;
    for (let i in 0..path.len) {
        if (path.data[i] == 47u8) { start = i + 1usize; };
    };
    return path[start..path.len];
};

fn dispatch(name: str, start: usize, argc: usize) i32 = {
    if (name == "b2sum") { return b2sum::run(start, argc); };
    if (name == "base32") { return base32::run(start, argc); };
    if (name == "base64") { return base64::run(start, argc); };
    if (name == "basenc") { return basenc::run(start, argc); };
    if (name == "basename") { return basename::run(start, argc); };
    if (name == "du") { return du::run(start, argc); };
    if (name == "dircolors") { return dircolors::run(start, argc); };
    if (name == "dirname") { return dirname::run(start, argc); };
    if (name == "echo") { return echo::run(start, argc); };
    if (name == "expr") { return expr::run(start, argc); };
    if (name == "expand") { return expand::run(start, argc); };
    if (name == "env") { return environment::run(start, argc); };
    if (name == "false") { return false_cmd::run(start, argc); };
    if (name == "factor") { return factor::run(start, argc); };
    if (name == "fold") { return fold::run(start, argc); };
    if (name == "fmt") { return fmt::run(start, argc); };
    if (name == "true") { return true_cmd::run(start, argc); };
    if (name == "uname") { return uname::run(start, argc); };
    if (name == "whoami") { return whoami::run(start, argc); };
    if (name == "users") { return users::run(start, argc); };
    if (name == "who") { return who::run(start, argc); };
    if (name == "stty") { return stty::run(start, argc); };
    if (name == "stdbuf") { return stdbuf::run(start, argc); };
    if (name == "uniq") { return uniq::run(start, argc); };
    if (name == "yes") { return yescmd::run(start, argc); };
    if (name == "cksum") { return cksum::run(start, argc); };
    if (name == "sum") { return sum::run(start, argc); };
    if (name == "md5sum") { return md5sum::run(start, argc); };
    if (name == "sha1sum") { return sha1sum::run(start, argc); };
    if (name == "sha224sum") { return sha224sum::run(start, argc); };
    if (name == "sha384sum") { return sha384sum::run(start, argc); };
    if (name == "sha512sum") { return sha512sum::run(start, argc); };
    if (name == "sha256sum") { return sha256sum::run(start, argc); };
    if (name == "cat") { return cat::run(start, argc); };
    if (name == "comm") { return comm::run(start, argc); };
    if (name == "dd") { return dd::run(start, argc); };
    if (name == "df") { return df::run(start, argc); };
    if (name == "date") { return date::run(start, argc); };
    if (name == "csplit") { return csplit::run(start, argc); };
    if (name == "split") { return split::run(start, argc); };
    if (name == "tac") { return tac::run(start, argc); };
    if (name == "od") { return od::run(start, argc); };
    if (name == "mkdir") { return mkdir::run(start, argc); };
    if (name == "rmdir") { return rmdir::run(start, argc); };
    if (name == "sync") { return sync::run(start, argc); };
    if (name == "tty") { return tty::run(start, argc); };
    if (name == "truncate") { return truncate::run(start, argc); };
    if (name == "timeout") { return timeout::run(start, argc); };
    if (name == "touch") { return touch::run(start, argc); };
    if (name == "ln") { return ln::run(start, argc); };
    if (name == "cp") { return cp::run(start, argc); };
    if (name == "mv") { return mv::run(start, argc); };
    if (name == "rm") { return rm::run(start, argc); };
    if (name == "chmod") { return chmod::run(start, argc); };
    if (name == "chown") { return chown::run(start, argc); };
    if (name == "chcon") { return chcon::run(start, argc); };
    if (name == "runcon") { return runcon::run(start, argc); };
    if (name == "chroot") { return chroot::run(start, argc); };
    if (name == "chgrp") { return chgrp::run(start, argc); };
    if (name == "cut") { return cut::run(start, argc); };
    if (name == "groups") { return groups::run(start, argc); };
    if (name == "id") { return id::run(start, argc); };
    if (name == "hostid") { return hostid::run(start, argc); };
    if (name == "head") { return head::run(start, argc); };
    if (name == "install") { return install::run(start, argc); };
    if (name == "join") { return join::run(start, argc); };
    if (name == "logname") { return logname::run(start, argc); };
    if (name == "nice") { return nice::run(start, argc); };
    if (name == "ls") { return ls::run(start, argc); };
    if (name == "dir") { return dir::run(start, argc); };
    if (name == "vdir") { return vdir::run(start, argc); };
    if (name == "link") { return link::run(start, argc); };
    if (name == "mknod") { return mknod::run(start, argc); };
    if (name == "mkfifo") { return mkfifo::run(start, argc); };
    if (name == "mktemp") { return mktemp::run(start, argc); };
    if (name == "nohup") { return nohup::run(start, argc); };
    if (name == "nl") { return nl::run(start, argc); };
    if (name == "nproc") { return nproc::run(start, argc); };
    if (name == "numfmt") { return numfmt::run(start, argc); };
    if (name == "pinky") { return pinky::run(start, argc); };
    if (name == "pr") { return pr::run(start, argc); };
    if (name == "ptx") { return ptx::run(start, argc); };
    if (name == "paste") { return paste::run(start, argc); };
    if (name == "pathchk") { return pathchk::run(start, argc); };
    if (name == "printenv") { return printenv::run(start, argc); };
    if (name == "readlink") { return readlink::run(start, argc); };
    if (name == "realpath") { return realpath::run(start, argc); };
    if (name == "printf") { return printf::run(start, argc); };
    if (name == "pwd") { return pwd::run(start, argc); };
    if (name == "seq") { return sequence::run(start, argc); };
    if (name == "shred") { return shred::run(start, argc); };
    if (name == "shuf") { return shuf::run(start, argc); };
    if (name == "sleep") { return sleeper::run(start, argc); };
    if (name == "stat") { return stat::run(start, argc); };
    if (name == "sort") { return sort::run(start, argc); };
    if (name == "test") { return testcmd::run(start, argc, false); };
    if (name == "[") { return testcmd::run(start, argc, true); };
    if (name == "tee") { return tee::run(start, argc); };
    if (name == "tail") { return tail::run(start, argc); };
    if (name == "tsort") { return tsort::run(start, argc); };
    if (name == "tr") { return tr::run(start, argc); };
    if (name == "unlink") { return unlink::run(start, argc); };
    if (name == "unexpand") { return unexpand::run(start, argc); };
    if (name == "wc") { return wc::run(start, argc); };
    io::eprintln("zovutils: unknown utility '" + name + "'");
    io::eprintln("usage: zovutils <utility> [arguments...]");
    return 1;
};

export fn main() i32 = {
    let argc: usize = env::argscount();
    if (argc == 0usize) { return 1; };

    let invoked_as: str = program_name(env::argat(0usize));
    if (invoked_as != "zovutils" && invoked_as != "main") {
        return dispatch(invoked_as, 1usize, argc);
    };
    if (argc < 2usize) {
        io::eprintln("usage: zovutils <utility> [arguments...]");
        io::eprintln("utilities: [ b2sum base32 base64 basename basenc cat chcon chgrp chmod chown chroot cksum comm cp csplit cut date dd df dir dircolors dirname du echo env expand expr factor false fmt fold groups head hostid id install join link ln logname ls md5sum mkdir mkfifo mknod mktemp mv nice nl nohup nproc numfmt od paste pathchk pinky pr printenv printf ptx pwd readlink realpath rm rmdir runcon seq sha1sum sha224sum sha256sum sha384sum sha512sum shred shuf sleep sort split stat stdbuf stty sum sync tac tail tee test timeout touch tr true truncate tsort tty uname unexpand uniq unlink users vdir wc who whoami yes");
        return 1;
    };
    if (env::argat(1usize) == "--help" || env::argat(1usize) == "-h") {
        io::println("usage: zovutils <utility> [arguments...]");
        io::println("utilities: [ b2sum base32 base64 basename basenc cat chcon chgrp chmod chown chroot cksum comm cp csplit cut date dd df dir dircolors dirname du echo env expand expr factor false fmt fold groups head hostid id install join link ln logname ls md5sum mkdir mkfifo mknod mktemp mv nice nl nohup nproc numfmt od paste pathchk pinky pr printenv printf ptx pwd readlink realpath rm rmdir runcon seq sha1sum sha224sum sha256sum sha384sum sha512sum shred shuf sleep sort split stat stdbuf stty sum sync tac tail tee test timeout touch tr true truncate tsort tty uname unexpand uniq unlink users vdir wc who whoami yes");
        return 0;
    };
    if (argc >= 2usize && (env::argat(1usize) == "--version" || env::argat(1usize) == "-V")) {
        io::println("zovutils 0.10.0 (GNU Coreutils 9.11 compatibility target)");
        return 0;
    };
    return dispatch(env::argat(1usize), 2usize, argc);
};

test "byte stream helpers preserve binary bytes" {
    let raw: nullable *c::FILE = c::tmpfile();
    assert(raw != null);
    let fp: *c::FILE = raw!;
    let input: [3]u8 = [0u8, 65u8, 255u8];
    assert(shared::io::writebytes(fp, ((&input[0usize]) as *u8), 2usize));
    assert(shared::io::putbyte(fp, input[2usize]));
    assert(c::fseek(fp, 0i64, c::SEEK_SET) == 0);
    let mut output: [3]u8;
    assert(shared::io::readbytes(fp, ((&output[0usize]) as *u8), 3usize) == 3usize);
    assert(output[0usize] == 0u8);
    assert(output[1usize] == 65u8);
    assert(output[2usize] == 255u8);
    assert(shared::io::closefile(fp));
};
