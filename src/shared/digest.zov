use std::env as args;
use std::vec;
use <stdio.h> as c;
use <string.h> as strc;
use <platform_errno.h> as platform_errno;
use <platform_digest.h> as platform_digest;

export fn alg_md5() i32 = { return 0i32; };
export fn alg_sha1() i32 = { return 1i32; };
export fn alg_sha224() i32 = { return 2i32; };
export fn alg_sha256() i32 = { return 3i32; };
export fn alg_sha384() i32 = { return 4i32; };
export fn alg_sha512() i32 = { return 5i32; };
export fn alg_blake2b() i32 = { return 6i32; };

fn rotl32(x: u32, n: u32) u32 = {
    return (x << n) | (x >> (32u32 - n));
};

fn rotr32(x: u32, n: u32) u32 = {
    return (x >> n) | (x << (32u32 - n));
};

fn rotr64(x: u64, n: u64) u64 = {
    return (x >> n) | (x << (64u64 - n));
};

// ---------------- MD5 ----------------
type Md5 = struct {
    h0: u32,
    h1: u32,
    h2: u32,
    h3: u32,
    bytes: u64,
    buf: [64]u8,
    used: usize,
};

fn md5_init(m: &mut Md5) void = {
    m.h0 = 0x67452301u32;
    m.h1 = 0xefcdab89u32;
    m.h2 = 0x98badcfeu32;
    m.h3 = 0x10325476u32;
    m.bytes = 0u64;
    m.used = 0usize;
};

fn md5_transform(ctx: &mut Md5) void = {
    let k: [64]u32 = [
        0xd76aa478u32, 0xe8c7b756u32, 0x242070dbu32, 0xc1bdceeeu32,
        0xf57c0fafu32, 0x4787c62au32, 0xa8304613u32, 0xfd469501u32,
        0x698098d8u32, 0x8b44f7afu32, 0xffff5bb1u32, 0x895cd7beu32,
        0x6b901122u32, 0xfd987193u32, 0xa679438eu32, 0x49b40821u32,
        0xf61e2562u32, 0xc040b340u32, 0x265e5a51u32, 0xe9b6c7aau32,
        0xd62f105du32, 0x02441453u32, 0xd8a1e681u32, 0xe7d3fbc8u32,
        0x21e1cde6u32, 0xc33707d6u32, 0xf4d50d87u32, 0x455a14edu32,
        0xa9e3e905u32, 0xfcefa3f8u32, 0x676f02d9u32, 0x8d2a4c8au32,
        0xfffa3942u32, 0x8771f681u32, 0x6d9d6122u32, 0xfde5380cu32,
        0xa4beea44u32, 0x4bdecfa9u32, 0xf6bb4b60u32, 0xbebfbc70u32,
        0x289b7ec6u32, 0xeaa127fau32, 0xd4ef3085u32, 0x04881d05u32,
        0xd9d4d039u32, 0xe6db99e5u32, 0x1fa27cf8u32, 0xc4ac5665u32,
        0xf4292244u32, 0x432aff97u32, 0xab9423a7u32, 0xfc93a039u32,
        0x655b59c3u32, 0x8f0ccc92u32, 0xffeff47du32, 0x85845dd1u32,
        0x6fa87e4fu32, 0xfe2ce6e0u32, 0xa3014314u32, 0x4e0811a1u32,
        0xf7537e82u32, 0xbd3af235u32, 0x2ad7d2bbu32, 0xeb86d391u32
    ];
    let s: [64]u32 = [
        7u32, 12u32, 17u32, 22u32, 7u32, 12u32, 17u32, 22u32, 7u32, 12u32, 17u32, 22u32, 7u32, 12u32, 17u32, 22u32,
        5u32,  9u32, 14u32, 20u32, 5u32,  9u32, 14u32, 20u32, 5u32,  9u32, 14u32, 20u32, 5u32,  9u32, 14u32, 20u32,
        4u32, 11u32, 16u32, 23u32, 4u32, 11u32, 16u32, 23u32, 4u32, 11u32, 16u32, 23u32, 4u32, 11u32, 16u32, 23u32,
        6u32, 10u32, 15u32, 21u32, 6u32, 10u32, 15u32, 21u32, 6u32, 10u32, 15u32, 21u32, 6u32, 10u32, 15u32, 21u32
    ];
    let mut m: [16]u32;
    for (let i in 0usize..16usize) {
        let base: usize = i * 4usize;
        m[i] = (ctx.buf[base] as u32) | ((ctx.buf[base + 1usize] as u32) << 8u32) |
               ((ctx.buf[base + 2usize] as u32) << 16u32) | ((ctx.buf[base + 3usize] as u32) << 24u32);
    };

    let mut a: u32 = ctx.h0;
    let mut b: u32 = ctx.h1;
    let mut d: u32 = ctx.h3;
    let mut e: u32 = ctx.h2;

    for (let i in 0usize..64usize) {
        let mut f: u32 = 0u32;
        let mut g: usize = 0usize;
        if (i < 16usize) {
            f = (b & e) | (~b & d);
            g = i;
        } else if (i < 32usize) {
            f = (d & b) | (~d & e);
            g = (5usize * i + 1usize) % 16usize;
        } else if (i < 48usize) {
            f = b ^ e ^ d;
            g = (3usize * i + 5usize) % 16usize;
        } else {
            f = e ^ (b | ~d);
            g = (7usize * i) % 16usize;
        };
        let t: u32 = d;
        d = e;
        e = b;
        b += rotl32(a + f + k[i] + m[g], s[i]);
        a = t;
    };
    ctx.h0 += a;
    ctx.h1 += b;
    ctx.h2 += e;
    ctx.h3 += d;
};

fn md5_update(ctx: &mut Md5, data: *u8, len: usize) void = {
    ctx.bytes += len as u64;
    let mut offset: usize = 0usize;
    let mut n: usize = len;
    while (n > 0usize) {
        let mut rem: usize = 64usize - ctx.used;
        if (rem > n) { rem = n; };
        strc::memcpy(((&mut ctx.buf[ctx.used]) as *void), ((&data[offset]) as *void), rem);
        ctx.used += rem;
        offset += rem;
        n -= rem;
        if (ctx.used == 64usize) {
            md5_transform(ctx);
            ctx.used = 0usize;
        };
    };
};

fn md5_final(ctx: &mut Md5, out: *u8) void = {
    let bits: u64 = ctx.bytes * 8u64;
    ctx.buf[ctx.used] = 0x80u8;
    ctx.used += 1usize;
    if (ctx.used > 56usize) {
        for (let i in ctx.used..64usize) { ctx.buf[i] = 0u8; };
        md5_transform(ctx);
        ctx.used = 0usize;
    };
    for (let i in ctx.used..56usize) { ctx.buf[i] = 0u8; };
    for (let i in 0usize..8usize) {
        ctx.buf[56usize + i] = ((bits >> ((8usize * i) as u64)) & 0xffu64) as u8;
    };
    md5_transform(ctx);
    let h: [4]u32 = [ctx.h0, ctx.h1, ctx.h2, ctx.h3];
    for (let i in 0usize..4usize) {
        let val: u32 = h[i];
        out[i * 4usize] = (val & 0xffu32) as u8;
        out[i * 4usize + 1usize] = ((val >> 8u32) & 0xffu32) as u8;
        out[i * 4usize + 2usize] = ((val >> 16u32) & 0xffu32) as u8;
        out[i * 4usize + 3usize] = ((val >> 24u32) & 0xffu32) as u8;
    };
};

// ---------------- SHA-1 ----------------
type Sha1 = struct {
    h0: u32,
    h1: u32,
    h2: u32,
    h3: u32,
    h4: u32,
    bytes: u64,
    buf: [64]u8,
    used: usize,
};

fn sha1_init(s: &mut Sha1) void = {
    s.h0 = 0x67452301u32;
    s.h1 = 0xefcdab89u32;
    s.h2 = 0x98badcfeu32;
    s.h3 = 0x10325476u32;
    s.h4 = 0xc3d2e1f0u32;
    s.bytes = 0u64;
    s.used = 0usize;
};

fn sha1_transform(ctx: &mut Sha1) void = {
    if (platform_digest::zov_sha1_transform_block(&mut ctx.h0, &mut ctx.h1, &mut ctx.h2, &mut ctx.h3, &mut ctx.h4, (&ctx.buf[0usize]) as *u8) == 1i32) {
        return;
    };
    let mut w: [80]u32;
    for (let i in 0usize..16usize) {
        let base: usize = i * 4usize;
        w[i] = ((ctx.buf[base] as u32) << 24u32) | ((ctx.buf[base + 1usize] as u32) << 16u32) |
               ((ctx.buf[base + 2usize] as u32) << 8u32) | (ctx.buf[base + 3usize] as u32);
    };
    for (let i in 16usize..80usize) {
        w[i] = rotl32(w[i - 3usize] ^ w[i - 8usize] ^ w[i - 14usize] ^ w[i - 16usize], 1u32);
    };
    let mut a: u32 = ctx.h0;
    let mut b: u32 = ctx.h1;
    let mut d: u32 = ctx.h3;
    let mut e: u32 = ctx.h4;
    let mut f: u32 = ctx.h2;

    for (let i in 0usize..80usize) {
        let mut q: u32 = 0u32;
        let mut k: u32 = 0u32;
        if (i < 20usize) {
            q = (b & f) | (~b & d);
            k = 0x5a827999u32;
        } else if (i < 40usize) {
            q = b ^ f ^ d;
            k = 0x6ed9eba1u32;
        } else if (i < 60usize) {
            q = (b & f) | (b & d) | (f & d);
            k = 0x8f1bbcdcu32;
        } else {
            q = b ^ f ^ d;
            k = 0xca62c1d6u32;
        };
        let t: u32 = rotl32(a, 5u32) + q + e + k + w[i];
        e = d;
        d = f;
        f = rotl32(b, 30u32);
        b = a;
        a = t;
    };
    ctx.h0 += a;
    ctx.h1 += b;
    ctx.h2 += f;
    ctx.h3 += d;
    ctx.h4 += e;
};

fn sha1_update(ctx: &mut Sha1, data: *u8, len: usize) void = {
    ctx.bytes += len as u64;
    let mut offset: usize = 0usize;
    let mut n: usize = len;
    while (n > 0usize) {
        let mut rem: usize = 64usize - ctx.used;
        if (rem > n) { rem = n; };
        strc::memcpy(((&mut ctx.buf[ctx.used]) as *void), ((&data[offset]) as *void), rem);
        ctx.used += rem;
        offset += rem;
        n -= rem;
        if (ctx.used == 64usize) {
            sha1_transform(ctx);
            ctx.used = 0usize;
        };
    };
};

fn sha1_final(ctx: &mut Sha1, out: *u8) void = {
    let bits: u64 = ctx.bytes * 8u64;
    ctx.buf[ctx.used] = 0x80u8;
    ctx.used += 1usize;
    if (ctx.used > 56usize) {
        for (let i in ctx.used..64usize) { ctx.buf[i] = 0u8; };
        sha1_transform(ctx);
        ctx.used = 0usize;
    };
    for (let i in ctx.used..56usize) { ctx.buf[i] = 0u8; };
    for (let i in 0usize..8usize) {
        ctx.buf[63usize - i] = ((bits >> ((8usize * i) as u64)) & 0xffu64) as u8;
    };
    sha1_transform(ctx);
    let h: [5]u32 = [ctx.h0, ctx.h1, ctx.h2, ctx.h3, ctx.h4];
    for (let i in 0usize..5usize) {
        let val: u32 = h[i];
        out[i * 4usize] = ((val >> 24u32) & 0xffu32) as u8;
        out[i * 4usize + 1usize] = ((val >> 16u32) & 0xffu32) as u8;
        out[i * 4usize + 2usize] = ((val >> 8u32) & 0xffu32) as u8;
        out[i * 4usize + 3usize] = (val & 0xffu32) as u8;
    };
};

// ---------------- SHA-224 / SHA-256 ----------------
type Sha256 = struct {
    h0: u32,
    h1: u32,
    h2: u32,
    h3: u32,
    h4: u32,
    h5: u32,
    h6: u32,
    h7: u32,
    bytes: u64,
    buf: [64]u8,
    used: usize,
    is224: bool,
};

fn sha256_init(s: &mut Sha256, is224: bool) void = {
    if (is224) {
        s.h0 = 0xc1059ed8u32;
        s.h1 = 0x367cd507u32;
        s.h2 = 0x3070dd17u32;
        s.h3 = 0xf70e5939u32;
        s.h4 = 0xffc00b31u32;
        s.h5 = 0x68581511u32;
        s.h6 = 0x64f98fa7u32;
        s.h7 = 0xbefa4fa4u32;
    } else {
        s.h0 = 0x6a09e667u32;
        s.h1 = 0xbb67ae85u32;
        s.h2 = 0x3c6ef372u32;
        s.h3 = 0xa54ff53au32;
        s.h4 = 0x510e527fu32;
        s.h5 = 0x9b05688cu32;
        s.h6 = 0x1f83d9abu32;
        s.h7 = 0x5be0cd19u32;
    };
    s.bytes = 0u64;
    s.used = 0usize;
    s.is224 = is224;
};

fn sha256_transform(ctx: &mut Sha256) void = {
    if (platform_digest::zov_sha256_transform_block(&mut ctx.h0, &mut ctx.h1, &mut ctx.h2, &mut ctx.h3, &mut ctx.h4, &mut ctx.h5, &mut ctx.h6, &mut ctx.h7, (&ctx.buf[0usize]) as *u8) == 1i32) {
        return;
    };
    let k: [64]u32 = [
        0x428a2f98u32,0x71374491u32,0xb5c0fbcfu32,0xe9b5dba5u32,
        0x3956c25bu32,0x59f111f1u32,0x923f82a4u32,0xab1c5ed5u32,
        0xd807aa98u32,0x12835b01u32,0x243185beu32,0x550c7dc3u32,
        0x72be5d74u32,0x80deb1feu32,0x9bdc06a7u32,0xc19bf174u32,
        0xe49b69c1u32,0xefbe4786u32,0x0fc19dc6u32,0x240ca1ccu32,
        0x2de92c6fu32,0x4a7484aau32,0x5cb0a9dcu32,0x76f988dau32,
        0x983e5152u32,0xa831c66du32,0xb00327c8u32,0xbf597fc7u32,
        0xc6e00bf3u32,0xd5a79147u32,0x06ca6351u32,0x14292967u32,
        0x27b70a85u32,0x2e1b2138u32,0x4d2c6dfcu32,0x53380d13u32,
        0x650a7354u32,0x766a0abbu32,0x81c2c92eu32,0x92722c85u32,
        0xa2bfe8a1u32,0xa81a664bu32,0xc24b8b70u32,0xc76c51a3u32,
        0xd192e819u32,0xd6990624u32,0xf40e3585u32,0x106aa070u32,
        0x19a4c116u32,0x1e376c08u32,0x2748774cu32,0x34b0bcb5u32,
        0x391c0cb3u32,0x4ed8aa4au32,0x5b9cca4fu32,0x682e6ff3u32,
        0x748f82eeu32,0x78a5636fu32,0x84c87814u32,0x8cc70208u32,
        0x90befffau32,0xa4506cebu32,0xbef9a3f7u32,0xc67178f2u32
    ];
    let mut w: [64]u32;
    for (let i in 0usize..16usize) {
        let base: usize = i * 4usize;
        w[i] = ((ctx.buf[base] as u32) << 24u32) | ((ctx.buf[base + 1usize] as u32) << 16u32) |
               ((ctx.buf[base + 2usize] as u32) << 8u32) | (ctx.buf[base + 3usize] as u32);
    };
    for (let i in 16usize..64usize) {
        let x: u32 = w[i - 15usize];
        let y: u32 = w[i - 2usize];
        let s0: u32 = rotr32(x, 7u32) ^ rotr32(x, 18u32) ^ (x >> 3u32);
        let s1: u32 = rotr32(y, 17u32) ^ rotr32(y, 19u32) ^ (y >> 10u32);
        w[i] = w[i - 16usize] + s0 + w[i - 7usize] + s1;
    };
    let mut a: u32 = ctx.h0;
    let mut b: u32 = ctx.h1;
    let mut cc: u32 = ctx.h2;
    let mut d: u32 = ctx.h3;
    let mut e: u32 = ctx.h4;
    let mut f: u32 = ctx.h5;
    let mut g: u32 = ctx.h6;
    let mut h: u32 = ctx.h7;

    for (let i in 0usize..64usize) {
        let s1: u32 = rotr32(e, 6u32) ^ rotr32(e, 11u32) ^ rotr32(e, 25u32);
        let ch: u32 = (e & f) ^ (~e & g);
        let t1: u32 = h + s1 + ch + k[i] + w[i];
        let s0: u32 = rotr32(a, 2u32) ^ rotr32(a, 13u32) ^ rotr32(a, 22u32);
        let maj: u32 = (a & b) ^ (a & cc) ^ (b & cc);
        let t2: u32 = s0 + maj;
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = cc;
        cc = b;
        b = a;
        a = t1 + t2;
    };
    ctx.h0 += a;
    ctx.h1 += b;
    ctx.h2 += cc;
    ctx.h3 += d;
    ctx.h4 += e;
    ctx.h5 += f;
    ctx.h6 += g;
    ctx.h7 += h;
};

fn sha256_update(ctx: &mut Sha256, data: *u8, len: usize) void = {
    ctx.bytes += len as u64;
    let mut offset: usize = 0usize;
    let mut n: usize = len;
    while (n > 0usize) {
        let mut rem: usize = 64usize - ctx.used;
        if (rem > n) { rem = n; };
        strc::memcpy(((&mut ctx.buf[ctx.used]) as *void), ((&data[offset]) as *void), rem);
        ctx.used += rem;
        offset += rem;
        n -= rem;
        if (ctx.used == 64usize) {
            sha256_transform(ctx);
            ctx.used = 0usize;
        };
    };
};

fn sha256_final(ctx: &mut Sha256, out: *u8) usize = {
    let bits: u64 = ctx.bytes * 8u64;
    ctx.buf[ctx.used] = 0x80u8;
    ctx.used += 1usize;
    if (ctx.used > 56usize) {
        for (let i in ctx.used..64usize) { ctx.buf[i] = 0u8; };
        sha256_transform(ctx);
        ctx.used = 0usize;
    };
    for (let i in ctx.used..56usize) { ctx.buf[i] = 0u8; };
    for (let i in 0usize..8usize) {
        ctx.buf[63usize - i] = ((bits >> ((8usize * i) as u64)) & 0xffu64) as u8;
    };
    sha256_transform(ctx);
    let mut words: usize = 8usize;
    if (ctx.is224) { words = 7usize; };
    let h: [8]u32 = [ctx.h0, ctx.h1, ctx.h2, ctx.h3, ctx.h4, ctx.h5, ctx.h6, ctx.h7];
    for (let i in 0usize..words) {
        let val: u32 = h[i];
        out[i * 4usize] = ((val >> 24u32) & 0xffu32) as u8;
        out[i * 4usize + 1usize] = ((val >> 16u32) & 0xffu32) as u8;
        out[i * 4usize + 2usize] = ((val >> 8u32) & 0xffu32) as u8;
        out[i * 4usize + 3usize] = (val & 0xffu32) as u8;
    };
    return words * 4usize;
};

// ---------------- SHA-384 / SHA-512 ----------------
type Sha512 = struct {
    h0: u64,
    h1: u64,
    h2: u64,
    h3: u64,
    h4: u64,
    h5: u64,
    h6: u64,
    h7: u64,
    bytes: u64,
    buf: [128]u8,
    used: usize,
    is384: bool,
};

fn sha512_init(s: &mut Sha512, is384: bool) void = {
    if (is384) {
        s.h0 = 0xcbbb9d5dc1059ed8u64;
        s.h1 = 0x629a292a367cd507u64;
        s.h2 = 0x9159015a3070dd17u64;
        s.h3 = 0x152fecd8f70e5939u64;
        s.h4 = 0x67332667ffc00b31u64;
        s.h5 = 0x8eb44a8768581511u64;
        s.h6 = 0xdb0c2e0d64f98fa7u64;
        s.h7 = 0x47b5481dbefa4fa4u64;
    } else {
        s.h0 = 0x6a09e667f3bcc908u64;
        s.h1 = 0xbb67ae8584caa73bu64;
        s.h2 = 0x3c6ef372fe94f82bu64;
        s.h3 = 0xa54ff53a5f1d36f1u64;
        s.h4 = 0x510e527fade682d1u64;
        s.h5 = 0x9b05688c2b3e6c1fu64;
        s.h6 = 0x1f83d9abfb41bd6bu64;
        s.h7 = 0x5be0cd19137e2179u64;
    };
    s.bytes = 0u64;
    s.used = 0usize;
    s.is384 = is384;
};

fn sha512_transform(ctx: &mut Sha512) void = {
    let k: [80]u64 = [
        0x428a2f98d728ae22u64,0x7137449123ef65cdu64,0xb5c0fbcfec4d3b2fu64,0xe9b5dba58189dbbcu64,
        0x3956c25bf348b538u64,0x59f111f1b605d019u64,0x923f82a4af194f9bu64,0xab1c5ed5da6d8118u64,
        0xd807aa98a3030242u64,0x12835b0145706fbeu64,0x243185be4ee4b28cu64,0x550c7dc3d5ffb4e2u64,
        0x72be5d74f27b896fu64,0x80deb1fe3b1696b1u64,0x9bdc06a725c71235u64,0xc19bf174cf692694u64,
        0xe49b69c19ef14ad2u64,0xefbe4786384f25e3u64,0x0fc19dc68b8cd5b5u64,0x240ca1cc77ac9c65u64,
        0x2de92c6f592b0275u64,0x4a7484aa6ea6e483u64,0x5cb0a9dcbd41fbd4u64,0x76f988da831153b5u64,
        0x983e5152ee66dfabu64,0xa831c66d2db43210u64,0xb00327c898fb213fu64,0xbf597fc7beef0ee4u64,
        0xc6e00bf33da88fc2u64,0xd5a79147930aa725u64,0x06ca6351e003826fu64,0x142929670a0e6e70u64,
        0x27b70a8546d22ffcu64,0x2e1b21385c26c926u64,0x4d2c6dfc5ac42aedu64,0x53380d139d95b3dfu64,
        0x650a73548baf63deu64,0x766a0abb3c77b2a8u64,0x81c2c92e47edaee6u64,0x92722c851482353bu64,
        0xa2bfe8a14cf10364u64,0xa81a664bbc423001u64,0xc24b8b70d0f89791u64,0xc76c51a30654be30u64,
        0xd192e819d6ef5218u64,0xd69906245565a910u64,0xf40e35855771202au64,0x106aa07032bbd1b8u64,
        0x19a4c116b8d2d0c8u64,0x1e376c085141ab53u64,0x2748774cdf8eeb99u64,0x34b0bcb5e19b48a8u64,
        0x391c0cb3c5c95a63u64,0x4ed8aa4ae3418acbu64,0x5b9cca4f7763e373u64,0x682e6ff3d6b2b8a3u64,
        0x748f82ee5defb2fcu64,0x78a5636f43172f60u64,0x84c87814a1f0ab72u64,0x8cc702081a6439ecu64,
        0x90befffa23631e28u64,0xa4506cebde82bde9u64,0xbef9a3f7b2c67915u64,0xc67178f2e372532bu64,
        0xca273eceea26619cu64,0xd186b8c721c0c207u64,0xeada7dd6cde0eb1eu64,0xf57d4f7fee6ed178u64,
        0x06f067aa72176fbau64,0x0a637dc5a2c898a6u64,0x113f9804bef90daeu64,0x1b710b35131c471bu64,
        0x28db77f523047d84u64,0x32caab7b40c72493u64,0x3c9ebe0a15c9bebcu64,0x431d67c49c100d4cu64,
        0x4cc5d4becb3e42b6u64,0x597f299cfc657e2au64,0x5fcb6fab3ad6faecu64,0x6c44198c4a475817u64
    ];
    let mut w: [80]u64;
    for (let i in 0usize..16usize) {
        let base: usize = i * 8usize;
        let mut x: u64 = 0u64;
        for (let j in 0usize..8usize) {
            x = (x << 8u64) | (ctx.buf[base + j] as u64);
        };
        w[i] = x;
    };
    for (let i in 16usize..80usize) {
        let x: u64 = w[i - 15usize];
        let y: u64 = w[i - 2usize];
        let s0: u64 = rotr64(x, 1u64) ^ rotr64(x, 8u64) ^ (x >> 7u64);
        let s1: u64 = rotr64(y, 19u64) ^ rotr64(y, 61u64) ^ (y >> 6u64);
        w[i] = w[i - 16usize] + s0 + w[i - 7usize] + s1;
    };
    let mut a: u64 = ctx.h0;
    let mut b: u64 = ctx.h1;
    let mut cc: u64 = ctx.h2;
    let mut d: u64 = ctx.h3;
    let mut e: u64 = ctx.h4;
    let mut f: u64 = ctx.h5;
    let mut g: u64 = ctx.h6;
    let mut h: u64 = ctx.h7;

    for (let i in 0usize..80usize) {
        let s1: u64 = rotr64(e, 14u64) ^ rotr64(e, 18u64) ^ rotr64(e, 41u64);
        let ch: u64 = (e & f) ^ (~e & g);
        let t1: u64 = h + s1 + ch + k[i] + w[i];
        let s0: u64 = rotr64(a, 28u64) ^ rotr64(a, 34u64) ^ rotr64(a, 39u64);
        let maj: u64 = (a & b) ^ (a & cc) ^ (b & cc);
        let t2: u64 = s0 + maj;
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = cc;
        cc = b;
        b = a;
        a = t1 + t2;
    };
    ctx.h0 += a;
    ctx.h1 += b;
    ctx.h2 += cc;
    ctx.h3 += d;
    ctx.h4 += e;
    ctx.h5 += f;
    ctx.h6 += g;
    ctx.h7 += h;
};

fn sha512_update(ctx: &mut Sha512, data: *u8, len: usize) void = {
    ctx.bytes += len as u64;
    let mut offset: usize = 0usize;
    let mut n: usize = len;
    while (n > 0usize) {
        let mut rem: usize = 128usize - ctx.used;
        if (rem > n) { rem = n; };
        strc::memcpy(((&mut ctx.buf[ctx.used]) as *void), ((&data[offset]) as *void), rem);
        ctx.used += rem;
        offset += rem;
        n -= rem;
        if (ctx.used == 128usize) {
            sha512_transform(ctx);
            ctx.used = 0usize;
        };
    };
};

fn sha512_final(ctx: &mut Sha512, out: *u8) usize = {
    let bits: u64 = ctx.bytes * 8u64;
    ctx.buf[ctx.used] = 0x80u8;
    ctx.used += 1usize;
    if (ctx.used > 112usize) {
        for (let i in ctx.used..128usize) { ctx.buf[i] = 0u8; };
        sha512_transform(ctx);
        ctx.used = 0usize;
    };
    for (let i in ctx.used..120usize) { ctx.buf[i] = 0u8; };
    for (let i in 112usize..120usize) { ctx.buf[i] = 0u8; };
    for (let i in 0usize..8usize) {
        ctx.buf[127usize - i] = ((bits >> ((8usize * i) as u64)) & 0xffu64) as u8;
    };
    sha512_transform(ctx);
    let mut words: usize = 8usize;
    if (ctx.is384) { words = 6usize; };
    let h: [8]u64 = [ctx.h0, ctx.h1, ctx.h2, ctx.h3, ctx.h4, ctx.h5, ctx.h6, ctx.h7];
    for (let i in 0usize..words) {
        let val: u64 = h[i];
        out[i * 8usize] = ((val >> 56u64) & 0xffu64) as u8;
        out[i * 8usize + 1usize] = ((val >> 48u64) & 0xffu64) as u8;
        out[i * 8usize + 2usize] = ((val >> 40u64) & 0xffu64) as u8;
        out[i * 8usize + 3usize] = ((val >> 32u64) & 0xffu64) as u8;
        out[i * 8usize + 4usize] = ((val >> 24u64) & 0xffu64) as u8;
        out[i * 8usize + 5usize] = ((val >> 16u64) & 0xffu64) as u8;
        out[i * 8usize + 6usize] = ((val >> 8u64) & 0xffu64) as u8;
        out[i * 8usize + 7usize] = (val & 0xffu64) as u8;
    };
    return words * 8usize;
};

// ---------------- BLAKE2b ----------------
type Blake2b = struct {
    h0: u64,
    h1: u64,
    h2: u64,
    h3: u64,
    h4: u64,
    h5: u64,
    h6: u64,
    h7: u64,
    t: u64,
    buf: [128]u8,
    used: usize,
    outlen: usize,
};

fn b2_init(b: &mut Blake2b, outlen: usize) void = {
    b.h0 = 0x6a09e667f3bcc908u64 ^ (0x01010000u64 | (outlen as u64));
    b.h1 = 0xbb67ae8584caa73bu64;
    b.h2 = 0x3c6ef372fe94f82bu64;
    b.h3 = 0xa54ff53a5f1d36f1u64;
    b.h4 = 0x510e527fade682d1u64;
    b.h5 = 0x9b05688c2b3e6c1fu64;
    b.h6 = 0x1f83d9abfb41bd6bu64;
    b.h7 = 0x5be0cd19137e2179u64;
    b.t = 0u64;
    b.used = 0usize;
    b.outlen = outlen;
};

fn b2_g(v: *u64, a: usize, b: usize, d: usize, e: usize, x: u64, y: u64) void = {
    v[a] = v[a] + v[b] + x;
    v[e] = rotr64(v[e] ^ v[a], 32u64);
    v[d] += v[e];
    v[b] = rotr64(v[b] ^ v[d], 24u64);
    v[a] = v[a] + v[b] + y;
    v[e] = rotr64(v[e] ^ v[a], 16u64);
    v[d] += v[e];
    v[b] = rotr64(v[b] ^ v[d], 63u64);
};

fn b2_compress(b: &mut Blake2b, last: bool) void = {
    let iv: [8]u64 = [
        0x6a09e667f3bcc908u64, 0xbb67ae8584caa73bu64,
        0x3c6ef372fe94f82bu64, 0xa54ff53a5f1d36f1u64,
        0x510e527fade682d1u64, 0x9b05688c2b3e6c1fu64,
        0x1f83d9abfb41bd6bu64, 0x5be0cd19137e2179u64
    ];
    let s: [192]u8 = [
        0u8,1u8,2u8,3u8,4u8,5u8,6u8,7u8,8u8,9u8,10u8,11u8,12u8,13u8,14u8,15u8,
        14u8,10u8,4u8,8u8,9u8,15u8,13u8,6u8,1u8,12u8,0u8,2u8,11u8,7u8,5u8,3u8,
        11u8,8u8,12u8,0u8,5u8,2u8,15u8,13u8,10u8,14u8,3u8,6u8,7u8,1u8,9u8,4u8,
        7u8,9u8,3u8,1u8,13u8,12u8,11u8,14u8,2u8,6u8,5u8,10u8,4u8,0u8,15u8,8u8,
        9u8,0u8,5u8,7u8,2u8,4u8,10u8,15u8,14u8,1u8,11u8,12u8,6u8,8u8,3u8,13u8,
        2u8,12u8,6u8,10u8,0u8,11u8,8u8,3u8,4u8,13u8,7u8,5u8,15u8,14u8,1u8,9u8,
        12u8,5u8,1u8,15u8,14u8,13u8,4u8,10u8,0u8,7u8,6u8,3u8,9u8,2u8,8u8,11u8,
        13u8,11u8,7u8,14u8,12u8,1u8,3u8,9u8,5u8,0u8,15u8,4u8,8u8,6u8,2u8,10u8,
        6u8,15u8,14u8,9u8,11u8,3u8,0u8,8u8,12u8,2u8,13u8,7u8,1u8,4u8,10u8,5u8,
        10u8,2u8,8u8,4u8,7u8,6u8,1u8,5u8,15u8,11u8,9u8,14u8,3u8,12u8,13u8,0u8,
        0u8,1u8,2u8,3u8,4u8,5u8,6u8,7u8,8u8,9u8,10u8,11u8,12u8,13u8,14u8,15u8,
        14u8,10u8,4u8,8u8,9u8,15u8,13u8,6u8,1u8,12u8,0u8,2u8,11u8,7u8,5u8,3u8
    ];
    let mut m: [16]u64;
    for (let i in 0usize..16usize) {
        let base: usize = i * 8usize;
        let mut x: u64 = 0u64;
        for (let j in 0usize..8usize) {
            let byte_val: u64 = b.buf[base + j] as u64;
            x |= byte_val << ((j * 8usize) as u64);
        };
        m[i] = x;
    };
    let mut v: [16]u64;
    v[0usize] = b.h0;
    v[1usize] = b.h1;
    v[2usize] = b.h2;
    v[3usize] = b.h3;
    v[4usize] = b.h4;
    v[5usize] = b.h5;
    v[6usize] = b.h6;
    v[7usize] = b.h7;
    for (let i in 0usize..8usize) {
        v[8usize + i] = iv[i];
    };
    v[12usize] ^= b.t;
    if (last) {
        v[14usize] = ~v[14usize];
    };
    let vp: *u64 = (&v[0usize]) as *u64;
    for (let r in 0usize..12usize) {
        let base_s: usize = r * 16usize;
        b2_g(vp, 0usize, 4usize, 8usize, 12usize, m[s[base_s] as usize], m[s[base_s + 1usize] as usize]);
        b2_g(vp, 1usize, 5usize, 9usize, 13usize, m[s[base_s + 2usize] as usize], m[s[base_s + 3usize] as usize]);
        b2_g(vp, 2usize, 6usize, 10usize, 14usize, m[s[base_s + 4usize] as usize], m[s[base_s + 5usize] as usize]);
        b2_g(vp, 3usize, 7usize, 11usize, 15usize, m[s[base_s + 6usize] as usize], m[s[base_s + 7usize] as usize]);
        b2_g(vp, 0usize, 5usize, 10usize, 15usize, m[s[base_s + 8usize] as usize], m[s[base_s + 9usize] as usize]);
        b2_g(vp, 1usize, 6usize, 11usize, 12usize, m[s[base_s + 10usize] as usize], m[s[base_s + 11usize] as usize]);
        b2_g(vp, 2usize, 7usize, 8usize, 13usize, m[s[base_s + 12usize] as usize], m[s[base_s + 13usize] as usize]);
        b2_g(vp, 3usize, 4usize, 9usize, 14usize, m[s[base_s + 14usize] as usize], m[s[base_s + 15usize] as usize]);
    };
    b.h0 ^= v[0usize] ^ v[8usize];
    b.h1 ^= v[1usize] ^ v[9usize];
    b.h2 ^= v[2usize] ^ v[10usize];
    b.h3 ^= v[3usize] ^ v[11usize];
    b.h4 ^= v[4usize] ^ v[12usize];
    b.h5 ^= v[5usize] ^ v[13usize];
    b.h6 ^= v[6usize] ^ v[14usize];
    b.h7 ^= v[7usize] ^ v[15usize];
};

fn b2_update(b: &mut Blake2b, data: *u8, len: usize) void = {
    let mut offset: usize = 0usize;
    let mut n: usize = len;
    while (n > 0usize) {
        if (b.used == 128usize) {
            b.t += 128u64;
            b2_compress(b, false);
            b.used = 0usize;
        };
        let mut z: usize = 128usize - b.used;
        if (z > n) { z = n; };
        strc::memcpy(((&mut b.buf[b.used]) as *void), ((&data[offset]) as *void), z);
        b.used += z;
        offset += z;
        n -= z;
    };
};

fn b2_final(b: &mut Blake2b, out: *u8) void = {
    b.t += b.used as u64;
    for (let i in b.used..128usize) {
        b.buf[i] = 0u8;
    };
    b2_compress(b, true);
    let h: [8]u64 = [b.h0, b.h1, b.h2, b.h3, b.h4, b.h5, b.h6, b.h7];
    let mut full: [64]u8;
    for (let i in 0usize..8usize) {
        let mut x: u64 = h[i];
        for (let j in 0usize..8usize) {
            full[i * 8usize + j] = (x & 0xffu64) as u8;
            x >>= 8u64;
        };
    };
    for (let i in 0usize..b.outlen) {
        out[i] = full[i];
    };
};

// ---------------- Unified Hasher ----------------
type Hasher = struct {
    alg: i32,
    b2_len: usize,
    md5: Md5,
    sha1: Sha1,
    sha256: Sha256,
    sha512: Sha512,
    b2: Blake2b,
};

fn hasher_init(h: &mut Hasher, alg: i32, b2_len: usize) void = {
    h.alg = alg;
    h.b2_len = b2_len;
    if (alg == 0i32) {
        md5_init(&mut h.md5);
    } else if (alg == 1i32) {
        sha1_init(&mut h.sha1);
    } else if (alg == 2i32) {
        sha256_init(&mut h.sha256, true);
    } else if (alg == 3i32) {
        sha256_init(&mut h.sha256, false);
    } else if (alg == 4i32) {
        sha512_init(&mut h.sha512, true);
    } else if (alg == 5i32) {
        sha512_init(&mut h.sha512, false);
    } else {
        let mut blen: usize = b2_len;
        if (blen == 0usize) { blen = 64usize; };
        b2_init(&mut h.b2, blen);
    };
};

fn hasher_update(h: &mut Hasher, data: *u8, len: usize) void = {
    if (h.alg == 0i32) {
        md5_update(&mut h.md5, data, len);
    } else if (h.alg == 1i32) {
        sha1_update(&mut h.sha1, data, len);
    } else if (h.alg == 2i32 || h.alg == 3i32) {
        sha256_update(&mut h.sha256, data, len);
    } else if (h.alg == 4i32 || h.alg == 5i32) {
        sha512_update(&mut h.sha512, data, len);
    } else {
        b2_update(&mut h.b2, data, len);
    };
};

fn hasher_final(h: &mut Hasher, out: *u8) usize = {
    if (h.alg == 0i32) {
        md5_final(&mut h.md5, out);
        return 16usize;
    } else if (h.alg == 1i32) {
        sha1_final(&mut h.sha1, out);
        return 20usize;
    } else if (h.alg == 2i32 || h.alg == 3i32) {
        return sha256_final(&mut h.sha256, out);
    } else if (h.alg == 4i32 || h.alg == 5i32) {
        return sha512_final(&mut h.sha512, out);
    } else {
        b2_final(&mut h.b2, out);
        return h.b2.outlen;
    };
};

fn hasher_file_cstr(c_name: *i8, is_stdin: bool, alg: i32, b2_len: usize, out: *u8) i32 = {
    let mut fp: nullable *c::FILE = null;
    if (is_stdin) {
        fp = c::stdin;
    } else {
        fp = c::fopen(c_name, "rb");
        if (fp == null) {
            return -1i32;
        };
    };
    let file_ptr: *c::FILE = fp!;
    let mut h: Hasher;
    hasher_init(&mut h, alg, b2_len);
    let mut buf: [65536]u8;
    while (true) {
        let n: usize = c::fread((&buf[0usize]) as *void, 1usize, 65536usize, file_ptr);
        if (n > 0usize) {
            hasher_update(&mut h, (&buf[0usize]) as *u8, n);
        };
        if (n < 65536usize) {
            if (c::ferror(file_ptr) != 0i32) {
                if (!is_stdin) {
                    c::fclose(file_ptr);
                };
                return -2i32;
            };
            break;
        };
    };
    if (!is_stdin) {
        c::fclose(file_ptr);
    };
    hasher_final(&mut h, out);
    return 0i32;
};

fn hex_digit(b: u8) u8 = {
    if (b < 10u8) {
        return 48u8 + b;
    };
    return 87u8 + b;
};

fn bytes_to_hex(bytes: *u8, len: usize, out: *u8) void = {
    for (let i in 0usize..len) {
        let b: u8 = bytes[i];
        out[i * 2usize] = hex_digit(b >> 4u8);
        out[i * 2usize + 1usize] = hex_digit(b & 0x0fu8);
    };
    out[len * 2usize] = 0u8;
};

fn is_hex_digit(b: u8) bool = {
    return (b >= 48u8 && b <= 57u8) || (b >= 97u8 && b <= 102u8) || (b >= 65u8 && b <= 70u8);
};

fn read_line(mf: *c::FILE, delim: u8, out: &mut vec::Vec[u8]) bool = {
    out.clear();
    let mut ch: i32 = c::fgetc(mf);
    if (ch < 0i32) {
        return false;
    };
    while (ch >= 0i32 && (ch as u8) != delim) {
        out.push(ch as u8);
        ch = c::fgetc(mf);
    };
    return true;
};

type ManifestEntry = struct {
    valid: bool,
    fn_start: usize,
    fn_len: usize,
    hex_start: usize,
};

fn parse_manifest_entry(
    line: &vec::Vec[u8],
    label: str,
    digest_len: usize
) ManifestEntry = {
    let mut len: usize = line.len();
    while (len > 0usize) {
        let last: u8 = line.get(len - 1usize);
        if (last == 10u8 || last == 13u8 || last == 0u8) {
            len -= 1usize;
        } else {
            break;
        };
    };
    let mut offset: usize = 0usize;
    if (len > 0usize && line.get(0usize) == 92u8) { // '\\'
        offset = 1usize;
        len -= 1usize;
    };

    let hexlen: usize = digest_len * 2usize;

    // Check standard format: <hex>  <filename> or <hex> *<filename>
    if (len >= hexlen + 2usize && line.get(offset + hexlen) == 32u8) {
        let marker: u8 = line.get(offset + hexlen + 1usize);
        if (marker == 32u8 || marker == 42u8) {
            let mut all_hex: bool = true;
            for (let i in 0usize..hexlen) {
                if (!is_hex_digit(line.get(offset + i))) {
                    all_hex = false;
                    break;
                };
            };
            if (all_hex) {
                let f_len: usize = len - (hexlen + 2usize);
                if (f_len > 0usize) {
                    return ManifestEntry{
                        valid = true,
                        fn_start = offset + hexlen + 2usize,
                        fn_len = f_len,
                        hex_start = offset,
                    };
                };
            };
        };
    };

    // Check BSD format: <label> (<filename>) = <hex>
    if (len > label.len + 5usize) {
        let mut label_match: bool = true;
        for (let i in 0usize..label.len) {
            if (line.get(offset + i) != label.data[i]) {
                label_match = false;
                break;
            };
        };
        if (label_match && line.get(offset + label.len) == 32u8 && line.get(offset + label.len + 1usize) == 40u8) {
            let f_start: usize = offset + label.len + 2usize;
            let mut close_pos: usize = 0usize;
            let mut found_close: bool = false;
            let max_search: usize = offset + len;
            let mut i: usize = f_start;
            while (i + 3usize < max_search) {
                if (line.get(i) == 41u8 && line.get(i + 1usize) == 32u8 && line.get(i + 2usize) == 61u8) {
                    close_pos = i;
                    found_close = true;
                    break;
                };
                i += 1usize;
            };
            if (found_close) {
                let mut h_start: usize = close_pos + 3usize;
                while (h_start < max_search && line.get(h_start) == 32u8) {
                    h_start += 1usize;
                };
                if (max_search - h_start == hexlen) {
                    let mut all_hex: bool = true;
                    for (let j in 0usize..hexlen) {
                        if (!is_hex_digit(line.get(h_start + j))) {
                            all_hex = false;
                            break;
                        };
                    };
                    if (all_hex && close_pos > f_start) {
                        return ManifestEntry{
                            valid = true,
                            fn_start = f_start,
                            fn_len = close_pos - f_start,
                            hex_start = h_start,
                        };
                    };
                };
            };
        };
    };

    return ManifestEntry{
        valid = false,
        fn_start = 0usize,
        fn_len = 0usize,
        hex_start = 0usize,
    };
};

export fn run_checksum_check(
    program: str,
    label: str,
    alg: i32,
    digest_len: usize,
    b2_len: usize,
    start: usize,
    argc: usize
) i32 = {
    let mut status_mode: bool = false;
    let mut quiet: bool = false;
    let mut warn: bool = false;
    let mut strict: bool = false;
    let mut ignore_missing: bool = false;
    let mut zero: bool = false;
    let mut manifests = vec::new[str]();

    let mut i: usize = start;
    let mut options_allowed: bool = true;
    while (i < argc) {
        let a: str = args::argat(i);
        if (options_allowed && a == "--") {
            options_allowed = false;
            i += 1usize;
            continue;
        };
        if (options_allowed && (a == "-c" || a == "--check")) {
            i += 1usize;
            continue;
        };
        if (options_allowed && a == "--status") {
            status_mode = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && (a == "--quiet" || a == "--silent")) {
            quiet = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && a == "--warn") {
            warn = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && a == "--strict") {
            strict = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && a == "--ignore-missing") {
            ignore_missing = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && (a == "-z" || a == "--zero")) {
            zero = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && a == "--tag") {
            c::fprintf(c::stderr, "%s: the --tag option is meaningless when verifying checksums\nTry '%s --help' for more information.\n",
                       program.data as *i8, program.data as *i8);
            return 1i32;
        };
        if (options_allowed && (a == "-b" || a == "--binary" || a == "-t" || a == "--text")) {
            i += 1usize;
            continue;
        };
        if (options_allowed && a.len > 1usize && a.data[0usize] == 45u8 && a != "-") {
            c::fprintf(c::stderr, "%s: unrecognized option '%s'\nTry '%s --help' for more information.\n",
                       program.data as *i8, a.data as *i8, program.data as *i8);
            return 1i32;
        };
        manifests.push(a);
        i += 1usize;
    };

    let implicit: bool = manifests.len() == 0usize;
    if (implicit) {
        manifests.push("-");
    };

    let mut _good: usize = 0usize;
    let mut bad: usize = 0usize;
    let mut unreadable: usize = 0usize;
    let mut formatted: usize = 0usize;
    let mut verified: usize = 0usize;
    let mut failed: bool = false;

    let mut delim: u8 = 10u8;
    if (zero) { delim = 0u8; };

    for (let mi in 0usize..manifests.len()) {
        let manifest: str = manifests.get(mi);
        let is_stdin: bool = manifest == "-";
        let mut mf: nullable *c::FILE = null;
        if (is_stdin) {
            mf = c::stdin;
        } else {
            mf = c::fopen(manifest.data as *i8, "rb");
            if (mf == null) {
                let err: i32 = platform_errno::zov_errno_value();
                c::fprintf(c::stderr, "%s: %s: %s\n", program.data as *i8, manifest.data as *i8, strc::strerror(err));
                failed = true;
                continue;
            };
        };
        let mfp: *c::FILE = mf!;
        let mut line = vec::new[u8]();
        let mut line_no: usize = 0usize;

        while (read_line(mfp, delim, &mut line)) {
            line_no += 1usize;
            let entry: ManifestEntry = parse_manifest_entry(&line, label, digest_len);
            if (!entry.valid) {
                if (warn || strict) {
                    if (implicit) {
                        c::fprintf(c::stderr, "%s: 'standard input': %lu: improperly formatted %s checksum line\n",
                                   program.data as *i8, line_no, label.data as *i8);
                    } else {
                        c::fprintf(c::stderr, "%s: %s: %lu: improperly formatted %s checksum line\n",
                                   program.data as *i8, manifest.data as *i8, line_no, label.data as *i8);
                    };
                };
                if (strict) {
                    failed = true;
                };
                continue;
            };

            formatted += 1usize;

            let fn_len: usize = entry.fn_len;
            let mut path_buf: [4096]u8;
            if (fn_len >= 4096usize) {
                unreadable += 1usize;
                failed = true;
                continue;
            };
            for (let j in 0usize..fn_len) {
                path_buf[j] = line.get(entry.fn_start + j);
            };
            path_buf[fn_len] = 0u8;

            let mut actual_digest: [64]u8;
            let actual_len: usize = digest_len;
            let path_is_stdin: bool = fn_len == 1usize && path_buf[0usize] == 45u8;
            platform_errno::zov_errno_set(0i32);
            let res: i32 = hasher_file_cstr((&path_buf[0usize]) as *i8, path_is_stdin, alg, b2_len, (&actual_digest[0usize]) as *u8);

            if (res != 0i32) {
                let err: i32 = platform_errno::zov_errno_value();
                if (ignore_missing && platform_errno::zov_errno_is_enoent(err) != 0i32) {
                    // ignore missing file
                } else {
                    c::fprintf(c::stderr, "%s: %s: %s\n", program.data as *i8, (&path_buf[0usize]) as *i8, strc::strerror(err));
                    if (!status_mode) {
                        c::printf("%s: FAILED open or read", (&path_buf[0usize]) as *i8);
                        if (zero) { c::putchar(0i32); } else { c::putchar(10i32); };
                    };
                    unreadable += 1usize;
                    failed = true;
                };
                continue;
            };

            verified += 1usize;
            let mut actual_hex_buf: [129]u8;
            bytes_to_hex((&actual_digest[0usize]) as *u8, actual_len, (&actual_hex_buf[0usize]) as *u8);

            let hexlen: usize = digest_len * 2usize;
            let mut matches: bool = actual_len == digest_len;
            if (matches) {
                for (let j in 0usize..hexlen) {
                    let mut ac: u8 = actual_hex_buf[j];
                    let mut ex: u8 = line.get(entry.hex_start + j);
                    if (ac >= 65u8 && ac <= 90u8) { ac += 32u8; };
                    if (ex >= 65u8 && ex <= 90u8) { ex += 32u8; };
                    if (ac != ex) {
                        matches = false;
                        break;
                    };
                };
            };

            if (matches) {
                _good += 1usize;
                if (!quiet && !status_mode) {
                    c::printf("%s: OK", (&path_buf[0usize]) as *i8);
                    if (zero) { c::putchar(0i32); } else { c::putchar(10i32); };
                };
            } else {
                bad += 1usize;
                failed = true;
                if (!status_mode) {
                    c::printf("%s: FAILED", (&path_buf[0usize]) as *i8);
                    if (zero) { c::putchar(0i32); } else { c::putchar(10i32); };
                };
            };
        };

        if (c::ferror(mfp) != 0i32) {
            let err: i32 = platform_errno::zov_errno_value();
            c::fprintf(c::stderr, "%s: %s: read error: %s\n", program.data as *i8, manifest.data as *i8, strc::strerror(err));
            failed = true;
        };
        if (!is_stdin) {
            c::fclose(mfp);
        };
    };

    if (formatted == 0usize) {
        if (implicit) {
            c::fprintf(c::stderr, "%s: 'standard input': no properly formatted checksum lines found\n", program.data as *i8);
        } else {
            c::fprintf(c::stderr, "%s: %s: no properly formatted checksum lines found\n", program.data as *i8, manifests.get(0usize).data as *i8);
        };
        failed = true;
    } else if (ignore_missing && verified == 0usize) {
        if (implicit) {
            c::fprintf(c::stderr, "%s: 'standard input': no file was verified\n", program.data as *i8);
        } else {
            c::fprintf(c::stderr, "%s: %s: no file was verified\n", program.data as *i8, manifests.get(0usize).data as *i8);
        };
        failed = true;
    };

    if (!status_mode && bad > 0usize) {
        let mut s_bad: *i8 = "".data as *i8;
        if (bad != 1usize) { s_bad = "s".data as *i8; };
        c::fprintf(c::stderr, "%s: WARNING: %lu computed checksum%s did NOT match\n",
                   program.data as *i8, bad, s_bad);
    };
    if (!status_mode && unreadable > 0usize) {
        let mut s_unr: *i8 = "".data as *i8;
        if (unreadable != 1usize) { s_unr = "s".data as *i8; };
        c::fprintf(c::stderr, "%s: WARNING: %lu listed file%s could not be read\n",
                   program.data as *i8, unreadable, s_unr);
    };

    let mut ret: i32 = 0i32;
    if (failed) { ret = 1i32; };
    return ret;
};

export fn run_hash(
    program: str,
    label: str,
    alg: i32,
    digest_len: usize,
    start: usize,
    argc: usize
) i32 = {
    let mut is_check: bool = false;
    for (let idx in start..argc) {
        let a: str = args::argat(idx);
        if (a == "-c" || a == "--check") {
            is_check = true;
            break;
        };
    };
    if (is_check) {
        return run_checksum_check(program, label, alg, digest_len, digest_len, start, argc);
    };

    let mut tag: bool = false;
    let mut zero: bool = false;
    let mut files = vec::new[str]();

    let mut i: usize = start;
    let mut options_allowed: bool = true;
    while (i < argc) {
        let a: str = args::argat(i);
        if (options_allowed && a == "--") {
            options_allowed = false;
            i += 1usize;
            continue;
        };
        if (options_allowed && a == "--version") {
            c::printf("%s (zovutils) 0.12.0\n", program.data as *i8);
            return 0i32;
        };
        if (options_allowed && a == "--help") {
            if (alg == 0i32 || alg == 1i32 || alg == 2i32 || alg == 3i32) {
                c::printf("Usage: %s [OPTION]... [FILE]...\nPrint or check %s checksums.\nWith no FILE, or when FILE is -, read standard input.\n  -b, --binary       read in binary mode\n  -t, --text         read in text mode (default)\n      --help         display this help and exit\n      --version      output version information and exit\n",
                          program.data as *i8, program.data as *i8);
            } else {
                c::printf("Usage: %s [OPTION]... [FILE]...\nPrint or check %s checksums.\nWith no FILE, or when FILE is -, read standard input.\n  --help     display this help and exit\n  --version  output version information and exit\n",
                          program.data as *i8, program.data as *i8);
            };
            return 0i32;
        };
        if (options_allowed && (a == "--binary" || a == "-b" || a == "--text" || a == "-t")) {
            i += 1usize;
            continue;
        };
        if (options_allowed && a == "--tag") {
            tag = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && (a == "--zero" || a == "-z")) {
            zero = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && a.len > 1usize && a.data[0usize] == 45u8 && a != "-") {
            c::fprintf(c::stderr, "%s: unrecognized option '%s'\nTry '%s --help' for more information.\n",
                       program.data as *i8, a.data as *i8, program.data as *i8);
            return 1i32;
        };
        files.push(a);
        i += 1usize;
    };

    let implicit: bool = files.len() == 0usize;
    if (implicit) {
        files.push("-");
    };

    let mut status: i32 = 0i32;
    let mut dig: [64]u8;
    let dig_len: usize = digest_len;

    for (let fi in 0usize..files.len()) {
        let name: str = files.get(fi);
        let is_stdin: bool = name == "-";
        platform_errno::zov_errno_set(0i32);
        let res: i32 = hasher_file_cstr(name.data as *i8, is_stdin, alg, digest_len, (&dig[0usize]) as *u8);
        if (res == -1i32) {
            let err: i32 = platform_errno::zov_errno_value();
            c::fprintf(c::stderr, "%s: %s: %s\n", program.data as *i8, name.data as *i8, strc::strerror(err));
            status = 1i32;
            continue;
        };
        if (res == -2i32) {
            let err: i32 = platform_errno::zov_errno_value();
            c::fprintf(c::stderr, "%s: %s: read error: %s\n", program.data as *i8, name.data as *i8, strc::strerror(err));
            status = 1i32;
            continue;
        };

        let mut hex_buf: [129]u8;
        bytes_to_hex((&dig[0usize]) as *u8, dig_len, (&hex_buf[0usize]) as *u8);

        let mut out_name: str = name;
        if (implicit) { out_name = "-"; };
        if (tag) {
            c::printf("%s (%s) = %s", label.data as *i8, out_name.data as *i8, (&hex_buf[0usize]) as *i8);
        } else {
            c::printf("%s  %s", (&hex_buf[0usize]) as *i8, out_name.data as *i8);
        };
        if (zero) {
            c::putchar(0i32);
        } else {
            c::putchar(10i32);
        };
    };

    return status;
};

export fn run_b2sum(start: usize, argc: usize) i32 = {
    let mut is_check: bool = false;
    for (let idx in start..argc) {
        let a: str = args::argat(idx);
        if (a == "-c" || a == "--check") {
            is_check = true;
            break;
        };
    };

    let mut digest_len: usize = 64usize;
    let mut check_args = vec::new[str]();
    let mut files = vec::new[str]();
    let mut tag: bool = false;
    let mut zero: bool = false;

    let mut i: usize = start;
    let mut options_allowed: bool = true;
    while (i < argc) {
        let a: str = args::argat(i);
        let mut is_length: bool = false;
        let mut len_str: str = "";

        if (options_allowed && (a == "-l" || a == "--length")) {
            if (i + 1usize >= argc) {
                c::fprintf(c::stderr, "b2sum: option requires an argument -- 'l'\nTry 'b2sum --help' for more information.\n");
                return 1i32;
            };
            is_length = true;
            len_str = args::argat(i + 1usize);
            i += 2usize;
        } else if (options_allowed && a.len >= 9usize && a[0usize..9usize] == "--length=") {
            is_length = true;
            len_str = a[9usize..a.len];
            i += 1usize;
        } else if (options_allowed && a.len >= 2usize && a[0usize..2usize] == "-l" && a != "-l") {
            is_length = true;
            len_str = a[2usize..a.len];
            i += 1usize;
        };

        if (is_length) {
            let mut bits: u64 = 0u64;
            let mut valid: bool = len_str.len > 0usize;
            for (let j in 0usize..len_str.len) {
                let ch: u8 = len_str.data[j];
                if (ch < 48u8 || ch > 57u8) {
                    valid = false;
                    break;
                };
                bits = bits * 10u64 + ((ch - 48u8) as u64);
                if (bits > 10000000u64) {
                    // prevent overflow
                };
            };
            if (!valid || bits < 8u64 || bits > 512u64 || (bits % 8u64) != 0u64) {
                c::fprintf(c::stderr, "b2sum: invalid length: ‘%s’\n", len_str.data as *i8);
                if ((bits % 8u64) != 0u64) {
                    c::fprintf(c::stderr, "b2sum: length is not a multiple of 8\n");
                } else if (bits > 512u64) {
                    c::fprintf(c::stderr, "b2sum: maximum digest length for ‘BLAKE2b’ is 512 bits\n");
                };
                return 1i32;
            };
            digest_len = (bits / 8u64) as usize;
            continue;
        };

        if (is_check) {
            check_args.push(a);
            i += 1usize;
            continue;
        };

        if (options_allowed && a == "--") {
            options_allowed = false;
            i += 1usize;
            continue;
        };
        if (options_allowed && a == "--version") {
            c::printf("b2sum (zovutils) 0.12.0\n");
            return 0i32;
        };
        if (options_allowed && a == "--help") {
            c::printf("Usage: b2sum [OPTION]... [FILE]...\nPrint or check BLAKE2b checksums.\nWith no FILE, or when FILE is -, read standard input.\n  -l, --length=BITS  digest length in bits\n  --tag              create a BSD-style checksum\n  -z, --zero         end each output line with NUL\n      --help         display this help and exit\n      --version      output version information and exit\n");
            return 0i32;
        };
        if (options_allowed && (a == "--binary" || a == "-b" || a == "--text" || a == "-t")) {
            i += 1usize;
            continue;
        };
        if (options_allowed && a == "--tag") {
            tag = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && (a == "--zero" || a == "-z")) {
            zero = true;
            i += 1usize;
            continue;
        };
        if (options_allowed && a.len > 1usize && a.data[0usize] == 45u8 && a != "-") {
            c::fprintf(c::stderr, "b2sum: unrecognized option '%s'\nTry 'b2sum --help' for more information.\n", a.data as *i8);
            return 1i32;
        };
        files.push(a);
        i += 1usize;
    };

    if (is_check) {
        // Run check using check_args
        let mut check_status_mode: bool = false;
        let mut check_quiet: bool = false;
        let mut check_warn: bool = false;
        let mut check_strict: bool = false;
        let mut check_ignore_missing: bool = false;
        let mut check_zero: bool = false;
        let mut manifests = vec::new[str]();

        let mut opt_allowed: bool = true;
        for (let ci in 0usize..check_args.len()) {
            let a: str = check_args.get(ci);
            if (opt_allowed && a == "--") {
                opt_allowed = false;
                continue;
            };
            if (opt_allowed && (a == "-c" || a == "--check")) {
                continue;
            };
            if (opt_allowed && a == "--status") {
                check_status_mode = true;
                continue;
            };
            if (opt_allowed && (a == "--quiet" || a == "--silent")) {
                check_quiet = true;
                continue;
            };
            if (opt_allowed && a == "--warn") {
                check_warn = true;
                continue;
            };
            if (opt_allowed && a == "--strict") {
                check_strict = true;
                continue;
            };
            if (opt_allowed && a == "--ignore-missing") {
                check_ignore_missing = true;
                continue;
            };
            if (opt_allowed && (a == "-z" || a == "--zero")) {
                check_zero = true;
                continue;
            };
            if (opt_allowed && a == "--tag") {
                c::fprintf(c::stderr, "b2sum: the --tag option is meaningless when verifying checksums\nTry 'b2sum --help' for more information.\n");
                return 1i32;
            };
            if (opt_allowed && (a == "-b" || a == "--binary" || a == "-t" || a == "--text")) {
                continue;
            };
            if (opt_allowed && a.len > 1usize && a.data[0usize] == 45u8 && a != "-") {
                c::fprintf(c::stderr, "b2sum: unrecognized option '%s'\nTry 'b2sum --help' for more information.\n", a.data as *i8);
                return 1i32;
            };
            manifests.push(a);
        };

        let implicit: bool = manifests.len() == 0usize;
        if (implicit) {
            manifests.push("-");
        };

        let mut _good: usize = 0usize;
        let mut bad: usize = 0usize;
        let mut unreadable: usize = 0usize;
        let mut formatted: usize = 0usize;
        let mut verified: usize = 0usize;
        let mut failed: bool = false;

        let mut delim: u8 = 10u8;
        if (check_zero) { delim = 0u8; };

        for (let mi in 0usize..manifests.len()) {
            let manifest: str = manifests.get(mi);
            let is_stdin: bool = manifest == "-";
            let mut mf: nullable *c::FILE = null;
            if (is_stdin) {
                mf = c::stdin;
            } else {
                mf = c::fopen(manifest.data as *i8, "rb");
                if (mf == null) {
                    let err: i32 = platform_errno::zov_errno_value();
                    c::fprintf(c::stderr, "b2sum: %s: %s\n", manifest.data as *i8, strc::strerror(err));
                    failed = true;
                    continue;
                };
            };
            let mfp: *c::FILE = mf!;
            let mut line = vec::new[u8]();
            let mut line_no: usize = 0usize;

            while (read_line(mfp, delim, &mut line)) {
                line_no += 1usize;
                let entry: ManifestEntry = parse_manifest_entry(&line, "BLAKE2b", digest_len);
                if (!entry.valid) {
                    if (check_warn || check_strict) {
                        if (implicit) {
                            c::fprintf(c::stderr, "b2sum: 'standard input': %lu: improperly formatted BLAKE2b checksum line\n", line_no);
                        } else {
                            c::fprintf(c::stderr, "b2sum: %s: %lu: improperly formatted BLAKE2b checksum line\n", manifest.data as *i8, line_no);
                        };
                    };
                    if (check_strict) {
                        failed = true;
                    };
                    continue;
                };

                formatted += 1usize;

                let fn_len: usize = entry.fn_len;
                let mut path_buf: [4096]u8;
                if (fn_len >= 4096usize) {
                    unreadable += 1usize;
                    failed = true;
                    continue;
                };
                for (let j in 0usize..fn_len) {
                    path_buf[j] = line.get(entry.fn_start + j);
                };
                path_buf[fn_len] = 0u8;

                let mut actual_digest: [64]u8;
                let actual_len: usize = digest_len;
                let path_is_stdin: bool = fn_len == 1usize && path_buf[0usize] == 45u8;
                platform_errno::zov_errno_set(0i32);
                let res: i32 = hasher_file_cstr((&path_buf[0usize]) as *i8, path_is_stdin, 6i32, digest_len, (&actual_digest[0usize]) as *u8);

                if (res != 0i32) {
                    let err: i32 = platform_errno::zov_errno_value();
                    if (check_ignore_missing && platform_errno::zov_errno_is_enoent(err) != 0i32) {
                        // ignore missing file
                    } else {
                        c::fprintf(c::stderr, "b2sum: %s: %s\n", (&path_buf[0usize]) as *i8, strc::strerror(err));
                        if (!check_status_mode) {
                            c::printf("%s: FAILED open or read", (&path_buf[0usize]) as *i8);
                            if (check_zero) { c::putchar(0i32); } else { c::putchar(10i32); };
                        };
                        unreadable += 1usize;
                        failed = true;
                    };
                    continue;
                };

                verified += 1usize;
                let mut actual_hex_buf: [129]u8;
                bytes_to_hex((&actual_digest[0usize]) as *u8, actual_len, (&actual_hex_buf[0usize]) as *u8);

                let hexlen: usize = digest_len * 2usize;
                let mut matches: bool = actual_len == digest_len;
                if (matches) {
                    for (let j in 0usize..hexlen) {
                        let mut ac: u8 = actual_hex_buf[j];
                        let mut ex: u8 = line.get(entry.hex_start + j);
                        if (ac >= 65u8 && ac <= 90u8) { ac += 32u8; };
                        if (ex >= 65u8 && ex <= 90u8) { ex += 32u8; };
                        if (ac != ex) {
                            matches = false;
                            break;
                        };
                    };
                };

                if (matches) {
                    _good += 1usize;
                    if (!check_quiet && !check_status_mode) {
                        c::printf("%s: OK", (&path_buf[0usize]) as *i8);
                        if (check_zero) { c::putchar(0i32); } else { c::putchar(10i32); };
                    };
                } else {
                    bad += 1usize;
                    failed = true;
                    if (!check_status_mode) {
                        c::printf("%s: FAILED", (&path_buf[0usize]) as *i8);
                        if (check_zero) { c::putchar(0i32); } else { c::putchar(10i32); };
                    };
                };
            };

            if (c::ferror(mfp) != 0i32) {
                let err: i32 = platform_errno::zov_errno_value();
                c::fprintf(c::stderr, "b2sum: %s: read error: %s\n", manifest.data as *i8, strc::strerror(err));
                failed = true;
            };
            if (!is_stdin) {
                c::fclose(mfp);
            };
        };

        if (formatted == 0usize) {
            if (implicit) {
                c::fprintf(c::stderr, "b2sum: 'standard input': no properly formatted checksum lines found\n");
            } else {
                c::fprintf(c::stderr, "b2sum: %s: no properly formatted checksum lines found\n", manifests.get(0usize).data as *i8);
            };
            failed = true;
        } else if (check_ignore_missing && verified == 0usize) {
            if (implicit) {
                c::fprintf(c::stderr, "b2sum: 'standard input': no file was verified\n");
            } else {
                c::fprintf(c::stderr, "b2sum: %s: no file was verified\n", manifests.get(0usize).data as *i8);
            };
            failed = true;
        };

        if (!check_status_mode && bad > 0usize) {
            let mut s_bad: *i8 = "".data as *i8;
            if (bad != 1usize) { s_bad = "s".data as *i8; };
            c::fprintf(c::stderr, "b2sum: WARNING: %lu computed checksum%s did NOT match\n", bad, s_bad);
        };
        if (!check_status_mode && unreadable > 0usize) {
            let mut s_unr: *i8 = "".data as *i8;
            if (unreadable != 1usize) { s_unr = "s".data as *i8; };
            c::fprintf(c::stderr, "b2sum: WARNING: %lu listed file%s could not be read\n", unreadable, s_unr);
        };

        let mut ret: i32 = 0i32;
        if (failed) { ret = 1i32; };
        return ret;
    };

    let implicit: bool = files.len() == 0usize;
    if (implicit) {
        files.push("-");
    };

    let mut status: i32 = 0i32;
    let mut dig: [64]u8;
    let dig_len: usize = digest_len;

    for (let fi in 0usize..files.len()) {
        let name: str = files.get(fi);
        let is_stdin: bool = name == "-";
        platform_errno::zov_errno_set(0i32);
        let res: i32 = hasher_file_cstr(name.data as *i8, is_stdin, 6i32, digest_len, (&dig[0usize]) as *u8);
        if (res == -1i32) {
            let err: i32 = platform_errno::zov_errno_value();
            c::fprintf(c::stderr, "b2sum: %s: %s\n", name.data as *i8, strc::strerror(err));
            status = 1i32;
            continue;
        };
        if (res == -2i32) {
            let err: i32 = platform_errno::zov_errno_value();
            c::fprintf(c::stderr, "b2sum: %s: read error: %s\n", name.data as *i8, strc::strerror(err));
            status = 1i32;
            continue;
        };

        let mut hex_buf: [129]u8;
        bytes_to_hex((&dig[0usize]) as *u8, dig_len, (&hex_buf[0usize]) as *u8);

        let mut out_name: str = name;
        if (implicit) { out_name = "-"; };
        if (tag) {
            c::printf("BLAKE2b (%s) = %s", out_name.data as *i8, (&hex_buf[0usize]) as *i8);
        } else {
            c::printf("%s  %s", (&hex_buf[0usize]) as *i8, out_name.data as *i8);
        };
        if (zero) {
            c::putchar(0i32);
        } else {
            c::putchar(10i32);
        };
    };

    return status;
};
