use <stdio.h> as c;
use <platform_errno.h> as platform_errno;
use <unistd.h> as posix;
use <platform_stat.h> as platform_stat;
use <platform_locale.h> as platform_locale;
use <wc_backend.h> as wc_backend;

export type StreamError = !i32;

export fn openread(path: str) nullable *c::FILE = {
    return c::fopen(path, "rb");
};

export fn closefile(fp: *c::FILE) bool = {
    return c::fclose(fp) == 0;
};

export fn readbytes(fp: *c::FILE, buf: *u8, cap: usize) usize = {
    return c::fread(buf as *void, 1usize, cap, fp);
};

// Preserve the command's raw read(2) result, including EINTR, for utilities
// whose GNU implementations report an interrupted input read as an error.
export fn readonce(fp: *c::FILE, buf: *u8, cap: usize) i64 = {
    return posix::read(c::fileno(fp), buf as *void, cap) as i64;
};

export fn regularfile(fp: *c::FILE) bool = {
    return platform_stat::zov_file_is_regular(c::fileno(fp)) != 0;
};

export fn characterfile(fp: *c::FILE) bool = {
    return platform_stat::zov_file_is_character(c::fileno(fp)) != 0;
};

export fn appendfile(fp: *c::FILE) bool = {
    return platform_stat::zov_file_is_append(c::fileno(fp)) != 0;
};

export fn regularbytesremaining(fp: *c::FILE) i64 = {
    return platform_stat::zov_regular_bytes_remaining(c::fileno(fp));
};

export fn wcnewlinebackend() i32 = {
    return wc_backend::zov_wc_newline_backend();
};

export fn wccountnewlines(buf: *u8, len: usize) usize = {
    return wc_backend::zov_wc_count_newlines(buf, len);
};

// Use read(2) for commands that must forward a partial pipe read immediately.
// fread may wait for the full requested capacity before returning on a pipe.
export fn readchunk(fp: *c::FILE, buf: *u8, cap: usize) i64 = {
    while (true) {
        let count: i64 = posix::read(c::fileno(fp), buf as *void, cap) as i64;
        if (count < 0i64 && platform_errno::zov_errno_interrupted() != 0i32) { continue; };
        return count;
    };
    return -1i64;
};

// Synchronize the descriptor position after stdio has read ahead. Callers
// first position the FILE stream with fseek, then use this for shared fds.
export fn seekdescriptor(fp: *c::FILE, offset: i64) bool = {
    return posix::lseek(c::fileno(fp), offset, c::SEEK_SET) == offset;
};

export fn readerror(fp: *c::FILE) bool = {
    return c::ferror(fp) != 0;
};

export fn writebytes(fp: *c::FILE, buf: *u8, len: usize) bool = {
    let mut done: usize = 0usize;
    while (done < len) {
        let n: usize = c::fwrite((&buf[done]) as *void, 1usize, len - done, fp);
        if (n == 0usize) { return false; };
        done += n;
    };
    return true;
};

// Write short records through one descriptor write so concurrent writers to
// a pipe cannot interleave records that fit within POSIX's minimum PIPE_BUF.
export fn writeatomic(fp: *c::FILE, buf: *u8, len: usize) bool = {
    let mut done: usize = 0usize;
    while (done < len) {
        let count: i64 = posix::write(c::fileno(fp), ((&buf[done]) as *void), len - done) as i64;
        if (count < 0i64) {
            if (platform_errno::zov_errno_interrupted() != 0i32) { continue; };
            return false;
        };
        if (count == 0i64) { return false; };
        done += count as usize;
    };
    return true;
};

export fn putbyte(fp: *c::FILE, b: u8) bool = {
    return c::fputc(b as i32, fp) != -1;
};

export fn putstr(fp: *c::FILE, s: str) bool = {
    if (s.len == 0usize) { return true; };
    return writebytes(fp, s.data as *u8, s.len);
};

export fn errorprefix(name: str, path: str) void = {
    c::fprintf(c::stderr, "%s: ", name);
    printquoted(c::stderr, path, false);
    c::fprintf(c::stderr, ": ");
    c::perror((0i64 as *i8));
};

export fn erroropen(name: str, path: str) void = {
    c::fprintf(c::stderr, "%s: cannot open ", name);
    printquoted(c::stderr, path, true);
    c::fprintf(c::stderr, " for reading: ");
    c::perror((0i64 as *i8));
};

fn printable(b: u8) bool = {
    return b >= 32u8 && b < 127u8;
};

fn shellmeta(b: u8) bool = {
    return b == 33u8 || b == 34u8 || b == 36u8 || b == 38u8
        || b == 40u8 || b == 41u8 || b == 42u8 || b == 58u8
        || b == 59u8 || b == 60u8 || b == 61u8 || b == 62u8
        || b == 63u8 || b == 91u8 || b == 92u8 || b == 94u8
        || b == 96u8 || b == 124u8;
};

fn shellsingle(fp: *c::FILE, text: str) void = {
    c::fputc(39, fp);
    for (let i in 0..text.len) {
        if (text.data[i] == 39u8) { c::fputs("'\\''", fp); }
        else { c::fputc(text.data[i] as i32, fp); };
    };
    c::fputc(39, fp);
};

fn shellsegment(fp: *c::FILE, text: str) void = {
    let mut apostrophe: bool = false;
    let mut backslash: bool = false;
    let mut shell_special: bool = false;
    for (let i in 0..text.len) {
        if (text.data[i] == 39u8) { apostrophe = true; };
        if (text.data[i] == 92u8) { backslash = true; };
        if (shellmeta(text.data[i]) && text.data[i] != 39u8 && text.data[i] != 58u8) { shell_special = true; };
    };
    if (apostrophe && !backslash && !shell_special) {
        c::fputc(34, fp);
        for (let i in 0..text.len) { c::fputc(text.data[i] as i32, fp); };
        c::fputc(34, fp);
    } else { shellsingle(fp, text); };
};

fn shellmixed(fp: *c::FILE, text: str) void = {
    let mut in_single: bool = false;
    let mut i: usize = 0usize;
    while (i < text.len) {
        let b: u8 = text.data[i];
        if (printable(b) && b != 39u8) {
            if (!in_single) { c::fputc(39, fp); in_single = true; };
            c::fputc(b as i32, fp);
            i += 1usize;
            continue;
        };
        if (b >= 128u8) {
            let printable_length: usize = platform_locale::zov_printable_utf8_length(
                ((&text.data[i]) as *i8), text.len - i);
            if (printable_length > 0usize) {
                if (!in_single) { c::fputc(39, fp); in_single = true; };
                for (let j in 0usize..printable_length) { c::fputc(text.data[i + j] as i32, fp); };
                i += printable_length;
                continue;
            };
        };
        if (b == 39u8) {
            if (in_single) { c::fputs("'\\''", fp); }
            else { c::fputs("\\''", fp); in_single = true; };
            i += 1usize;
            continue;
        };
        if (in_single) { c::fputc(39, fp); in_single = false; };
        c::fputs("$'", fp);
        while (i < text.len && !printable(text.data[i])) {
            let byte: u8 = text.data[i];
            if (byte == 7u8) { c::fputs("\\a", fp); }
            else if (byte == 10u8) { c::fputs("\\n", fp); }
            else if (byte == 9u8) { c::fputs("\\t", fp); }
            else if (byte == 13u8) { c::fputs("\\r", fp); }
            else if (byte == 8u8) { c::fputs("\\b", fp); }
            else if (byte == 12u8) { c::fputs("\\f", fp); }
            else if (byte == 11u8) { c::fputs("\\v", fp); }
            else { c::fprintf(fp, "\\%03o", byte as i32); };
            i += 1usize;
        };
        c::fputc(39, fp);
    };
    if (in_single) { c::fputc(39, fp); };
};

export fn printquoted(fp: *c::FILE, text: str, force: bool) void = {
    let mut nonprint: bool = false;
    let mut apostrophe: bool = false;
    let mut backslash: bool = false;
    let mut needs_shell_quote: bool = false;
    let mut i: usize = 0usize;
    while (i < text.len) {
        let b: u8 = text.data[i];
        if (b >= 128u8) {
            let printable_length: usize = platform_locale::zov_printable_utf8_length(
                ((&text.data[i]) as *i8), text.len - i);
            if (printable_length > 0usize) { i += printable_length; continue; };
            nonprint = true;
        } else {
            if (!printable(b)) { nonprint = true; };
            if (b == 39u8) { apostrophe = true; };
            if (b == 92u8) { backslash = true; };
            if (b == 32u8 || shellmeta(b)) { needs_shell_quote = true; };
        };
        i += 1usize;
    };
    if (!force && text.len > 0usize && !nonprint && !apostrophe && !backslash && !needs_shell_quote) {
        for (let i in 0..text.len) { c::fputc(text.data[i] as i32, fp); };
        return;
    };
    if (!nonprint) {
        shellsegment(fp, text);
        return;
    };
    shellmixed(fp, text);
};

export fn printquotedargument(fp: *c::FILE, text: str) void = {
    let unicode_quotes: bool = platform_locale::zov_locale_uses_unicode_quotes() != 0i32;
    if (unicode_quotes) { c::fputs("‘", fp); }
    else { c::fputc(39, fp); };
    let mut i: usize = 0usize;
    while (i < text.len) {
        let b: u8 = text.data[i];
        if (unicode_quotes && b >= 128u8) {
            let printable_length: usize = platform_locale::zov_printable_utf8_length(
                ((&text.data[i]) as *i8), text.len - i);
            if (printable_length > 0usize) {
                for (let j in 0usize..printable_length) { c::fputc(text.data[i + j] as i32, fp); };
                i += printable_length;
                continue;
            };
        };
        if (b == 92u8 || (b == 39u8 && !unicode_quotes)) {
            c::fputc(92, fp);
            c::fputc(b as i32, fp);
        } else if (b == 7u8) { c::fputs("\\a", fp); }
        else if (b == 8u8) { c::fputs("\\b", fp); }
        else if (b == 9u8) { c::fputs("\\t", fp); }
        else if (b == 10u8) { c::fputs("\\n", fp); }
        else if (b == 11u8) { c::fputs("\\v", fp); }
        else if (b == 12u8) { c::fputs("\\f", fp); }
        else if (b == 13u8) { c::fputs("\\r", fp); }
        else if (b < 32u8 || b >= 127u8) { c::fprintf(fp, "\\%03o", b as i32); }
        else { c::fputc(b as i32, fp); };
        i += 1usize;
    };
    if (unicode_quotes) { c::fputs("’", fp); }
    else { c::fputc(39, fp); };
};

export fn outputfailed() bool = {
    return c::ferror(c::stdout) != 0;
};

export fn finishoutput(name: str) bool = {
    if (c::fflush(c::stdout) != 0 || c::ferror(c::stdout) != 0) {
        let error_number: i32 = platform_errno::zov_errno_value();
        c::fprintf(c::stderr, "%s: write error: ", name);
        platform_errno::zov_errno_set(error_number);
        c::perror((0i64 as *i8));
        return false;
    };
    return true;
};

export fn finishoutputnamed(name: str, destination: str) bool = {
    if (c::fflush(c::stdout) != 0 || c::ferror(c::stdout) != 0) {
        let error_number: i32 = platform_errno::zov_errno_value();
        c::fprintf(c::stderr, "%s: error writing '%s': ", name, destination);
        platform_errno::zov_errno_set(error_number);
        c::perror((0i64 as *i8));
        return false;
    };
    return true;
};

export fn finishoutputbrief(name: str) bool = {
    if (c::fflush(c::stdout) != 0 || c::ferror(c::stdout) != 0) {
        c::fprintf(c::stderr, "%s: write error\n", name);
        return false;
    };
    return true;
};

export fn samefile(fp: *c::FILE, path: str) bool = {
    return platform_stat::zov_same_file(c::fileno(fp), path) != 0;
};

export fn sameopenfile(first: *c::FILE, second: *c::FILE) bool = {
    return platform_stat::zov_same_open_file(c::fileno(first), c::fileno(second)) != 0;
};
