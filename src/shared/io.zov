use <stdio.h> as c;
use <sys/stat.h> as sysc;

export type StreamError = !i32;

export fn openread(path: str) nullable *c::FILE = {
    return c::fopen(path, "rb");
};

export fn closefile(fp: *c::FILE) bool = {
    return c::fclose(fp) == 0;
};

export fn readbytes(fp: *c::FILE, buf: *u8, cap: usize) usize = {
    return c::fread(buf as *void, 1usize, cap, fp);
};

export fn readerror(fp: *c::FILE) bool = {
    return c::ferror(fp) != 0;
};

export fn writebytes(fp: *c::FILE, buf: *u8, len: usize) bool = {
    let mut done: usize = 0usize;
    while (done < len) {
        let n: usize = c::fwrite((&buf[done]) as *void, 1usize, len - done, fp);
        if (n == 0usize) { return false; };
        done += n;
    };
    return true;
};

export fn putbyte(fp: *c::FILE, b: u8) bool = {
    return c::fputc(b as i32, fp) != -1;
};

export fn putstr(fp: *c::FILE, s: str) bool = {
    if (s.len == 0usize) { return true; };
    return writebytes(fp, s.data as *u8, s.len);
};

export fn errorprefix(name: str, path: str) void = {
    c::fprintf(c::stderr, "%s: %s: ", name, path);
    c::perror((0i64 as *i8));
};

export fn erroropen(name: str, path: str) void = {
    c::fprintf(c::stderr, "%s: cannot open '%s' for reading: ", name, path);
    c::perror((0i64 as *i8));
};

export fn samefile(fp: *c::FILE, path: str) bool = {
    let mut descriptor_info: [32]u64;
    let mut path_info: [32]u64;
    if (sysc::fstat(c::fileno(fp), ((&descriptor_info[0usize]) as *void)) != 0) { return false; };
    if (sysc::stat(path, ((&path_info[0usize]) as *void)) != 0) { return false; };
    // POSIX stat layouts on the supported 64-bit Linux and macOS targets put
    // st_ino in the second machine word. st_dev occupies the first word; on
    // macOS its defined width is 32 bits.
    return descriptor_info[1usize] == path_info[1usize]
        && (descriptor_info[0usize] & 4294967295u64) == (path_info[0usize] & 4294967295u64);
};

test "byte stream helpers preserve binary bytes" {
    let raw: nullable *c::FILE = c::tmpfile();
    assert(raw != null);
    let fp: *c::FILE = raw!;
    let input: [3]u8 = [0u8, 65u8, 255u8];
    assert(writebytes(fp, ((&input[0usize]) as *u8), 2usize));
    assert(putbyte(fp, input[2usize]));
    assert(c::fseek(fp, 0i64, c::SEEK_SET) == 0);
    let mut output: [3]u8;
    assert(readbytes(fp, ((&output[0usize]) as *u8), 3usize) == 3usize);
    assert(output[0usize] == 0u8);
    assert(output[1usize] == 65u8);
    assert(output[2usize] == 255u8);
    assert(closefile(fp));
};
